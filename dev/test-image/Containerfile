# The image of the test suite: what tests/slow (and the offline run of tests/fast) need, and nothing else. dev/test-slow.sh builds it
# from this file when the image is missing. It is not the product image (that is the root Dockerfile) and nothing in it is published.
#
#   podman build -f dev/test-image/Containerfile -t swarmbox-test-slow:latest dev/test-image
#
# Contents: python3, dash, busybox, chromium, git, jq, shellcheck, build-essential, espeak-ng, less, vim, fzf, node and the
# claude CLI (the CLI is for tests/e2e; the suites never call a model). Podman is NOT inside: the tests that build the image or run a
# nested Podman skip here and run in CI. The user is `tester` (not root) and the work folder is /work (a tmpfs in dev/test-slow.sh).
ARG NODE_VERSION=24
FROM docker.io/library/node:${NODE_VERSION}-trixie-slim

ARG DEBIAN_FRONTEND=noninteractive
# the sandbox user of apt cannot be switched in a nested rootless build, so apt runs as root (harmless elsewhere)
RUN apt-get -o APT::Sandbox::User=root update && \
    apt-get -o APT::Sandbox::User=root install -y --no-install-recommends \
        python3 python3-venv python3-pip dash busybox-static chromium git procps curl ca-certificates openssh-client \
        shellcheck bash jq build-essential espeak-ng less vim fzf && \
    rm -rf /var/lib/apt/lists/*

# the claude CLI, for tests/e2e only (pinned: bump it by hand)
ARG CLAUDE_CODE_VERSION=2.1.325
RUN npm install -g "@anthropic-ai/claude-code@${CLAUDE_CODE_VERSION}" && npm cache clean --force

RUN useradd -m tester
USER tester
WORKDIR /work
