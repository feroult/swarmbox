#!/usr/bin/python3 -S
"""Stand-in for `swarmbox-tabs` in the sysop tests: it records nothing itself, it hands its arguments and its stdin to FakeTabs
(tests/support/sysop_support.py) over the unix socket named by `--fake-socket PATH` (the first two arguments) and prints what that answers, with its exit code.
When nobody listens it prints what the real command prints when herdr-core is gone."""
import json
import socket
import sys

argv = sys.argv[1:]
path = None
if argv[:1] == ["--fake-socket"]:
    path, argv = argv[1], argv[2:]
stdin = sys.stdin.read() if argv[:1] == ["send"] else ""
try:
    s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    s.settimeout(120)
    s.connect(path)
    s.sendall((json.dumps({"argv": argv, "stdin": stdin}) + "\n").encode())
    rep = json.loads(s.makefile("rb").readline())
except (OSError, ValueError, TypeError):
    print(json.dumps({"err": "no_backend", "msg": "fake tabs: nobody listens"}))
    sys.exit(4)
print(json.dumps(rep["out"]))
sys.exit(rep["rc"])
