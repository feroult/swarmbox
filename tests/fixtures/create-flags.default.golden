--userns=keep-id:uid=1000,gid=1000
--pids-limit=16384
--hostname
swarmbox
-v
@WS@:/home/agent
--tz=local
--tmpfs
/tmp/swarmbox
--device
/dev/net/tun
--security-opt
unmask=/proc/*
-v
swarmbox-containers:/home/agent/.local/share/containers
-p
127.0.0.1:7681:7681
-e
SWARMBOX_NAME=swarmbox
-e
SWARMBOX_WEB=1
-e
SWARMBOX_YOLO=1
--label
swarmbox.managed=2
--label
swarmbox.image=ghcr.io/<org>/swarmbox:@VERSION@
--label
swarmbox.workspace=@WS@
--label
swarmbox.ports=
--label
swarmbox.env-hash=@ENVHASH@
--label
swarmbox.fingerprint=@FP@
