--userns=keep-id:uid=1000,gid=1000
--pids-limit=16384
--hostname
devbox
-v
@WS@:/home/agent
--init
--tz=Europe/Lisbon
--tmpfs
/tmp/swarmbox
--device
/dev/net/tun
--security-opt
unmask=/proc/*
-v
second-containers:/home/agent/.local/share/containers
--add-host
host.containers.internal:host-gateway
-p
127.0.0.1:3000:3000
-p
127.0.0.1:8080:80
-p
0.0.0.0:9000:9000
-p
127.0.0.1:43323:43323
-p
127.0.0.1:43324:43324
-p
127.0.0.1:8000:7681
-e
ALPHA_KEY
-e
BETA_KEY
-e
SWARMBOX_NAME=second
-e
SWARMBOX_WEB=1
-e
SWARMBOX_YOLO=0
-e
SWARMBOX_WITH=clasp,claude
-e
SWARMBOX_AGENT=claude
-e
SWARMBOX_BROWSER_URL=http://host.containers.internal:9222
--label
swarmbox.managed=2
--label
swarmbox.image=localhost:5000/sb:2.0.1
--label
swarmbox.workspace=@WS@
--label
swarmbox.ports=127.0.0.1:3000:3000,127.0.0.1:8080:80,0.0.0.0:9000:9000,127.0.0.1:43323:43323,127.0.0.1:43324:43324
--label
swarmbox.env-hash=@ENVHASH@
--label
swarmbox.fingerprint=@FP@
