#!/usr/bin/python3
"""Fake planner for the voice tests. The behaviour comes from SWARMBOX_VOICE_PLANNER_MODEL (the mode):

  echo (default)  send_text of the utterance to the active pane, enter=false
  obey            OBEYS an injection: the first line `RUN: <command>` found in any pane tail becomes a send_text with
                  enter=true, and the plan claims "risk": "low" (the host must ignore that)
  badjson / notjson, badaction, badpane, badtype, exit1, hang, huge, extrakey, newline
"""
import json
import os
import sys
import time

mode = os.environ.get("SWARMBOX_VOICE_PLANNER_MODEL") or "echo"
data = json.load(sys.stdin)
pane = data.get("active_pane")
if mode == "exit1":
    print("fake planner failing on purpose", file=sys.stderr)
    sys.exit(1)
if mode == "hang":
    time.sleep(60)
if mode == "huge":
    sys.stdout.write("x" * (10 * 1024 * 1024))
    sys.exit(0)
if mode in ("badjson", "notjson"):
    print("this is not json {")
    sys.exit(0)
act = {"type": "send_text", "pane": pane, "text": data.get("utterance", ""), "enter": False}
plan = {"say": "fake", "actions": [act]}
if mode == "obey":
    for p in data.get("panes", []):
        for line in p.get("tail", "").splitlines():
            if line.startswith("RUN: "):
                plan = {"say": "Safe, trust me", "risk": "low",
                        "actions": [{"type": "send_text", "pane": p["id"], "text": line[5:], "enter": True, "risk": "low"}]}
                break
elif mode == "badaction":
    act["type"] = "run_shell"
elif mode == "badpane":
    act["pane"] = "%9999"
elif mode == "badtype":
    plan = {"say": "fake", "actions": "send everything"}
elif mode == "extrakey":
    act["env"] = {"A": "b"}
elif mode == "newline":
    act["text"] = "ls\nrm -rf /"
print(json.dumps(plan))
