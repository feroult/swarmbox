#!/bin/sh
# swarmbox-host: the SwarmBox host helper (design 3.7.1, 3.7.2). POSIX sh, no bashisms (no `local`, no `echo -e`, no
# `read -s`, no arrays, no `[[ ]]`); it must run under dash, busybox sh, bash in POSIX mode and macOS /bin/sh (D16, B23).
#
# Slice 3.1 built the configuration surface:
#   version                      the version in the file VERSION next to this program
#   config get KEY               resolved value (environment, then file, then default); 2 unknown key, 1 unset
#   config set KEY [VALUE]       validate and write one key (the tunnel token is read from the terminal, never argv)
#   config list                  KEY=VALUE<TAB>source, the token only as set or unset
#   config seed [--with L] [--workspace DIR] [--image REF]
#   env add|rm NAME, env list    the names of host variables passed to the box at creation (ENV_KEYS)
#   create-flags, fingerprint   the flags and the box fingerprint (slice 3.2)
#   up, reset, stop, url         the lock, the lookup, creation, readiness, the warnings (slice 3.3; they call Podman, `url` does not)
#   update [--to TAG]            pull, extract the helper, tag X.Y.Z locally, write IMAGE (slice 3.6)
#   remote setup|status|off|token [options]
#                                a thin wrapper over cloudflare-setup.py next to this program (slice 5.2): setup is `apply`,
#                                off is `remove`; the options go through unchanged; exit 3 without python3
#
# Data goes to standard output, messages to standard error. Exit codes (3.7.2, 3.8): 0 ok; 1 unset key or a write that
# failed; 2 usage, unknown key, invalid value or name; 3 prerequisite missing (here: a missing or unreadable VERSION).
# Paths honor HOME, XDG_CONFIG_HOME and XDG_STATE_HOME (an empty or relative XDG value is ignored, as in dirs.sh).
# The file mode is read as an octal number (stat -c %a, then stat -f %Lp, then find -perm); `ls` output is never parsed.

# shellcheck disable=SC2154  # some variables are assigned through eval (keys are validated names, never user text)
LC_ALL=C
export LC_ALL
umask 077

NL='
'
CR=$(printf '\r')
REGISTRY_REPO='ghcr.io/<org>/swarmbox'   # <org> is the documented placeholder until the name is settled (D32)

warn() { printf 'swarmbox: %s\n' "$*" >&2; }
die() { _rc=$1; shift; warn "$*"; exit "$_rc"; }

usage() {
    cat >&2 <<'USAGE'
usage: swarmbox-host <subcommand> [args]
  version
  config get KEY | config set KEY [VALUE] | config list
  config seed [--with L] [--workspace DIR] [--image REF]
  env add NAME | env rm NAME | env list
  create-flags [--browser-url VALUE]
  fingerprint [--explain] [--label NAME=VALUE]...
  up | reset | stop | url | connection
  update [--to TAG]
  remote setup|status|off|token [options]   (options of cloudflare-setup.py: --dry-run --session --hostname --port ...)
USAGE
    exit 2
}

# ---------------------------------------------------------------- the key table (design 8.2)

# Keys of the config file. NAME is not one of them: it selects the folder, so it comes from SWARMBOX_NAME only.
is_file_key() {
    case $1 in
        WORKSPACE|HOSTNAME|TZ|INIT|PORTS|HOST_ACCESS|BROWSER_URL|WEB|WEB_PORT|WITH|AGENT|YOLO|ENV_KEYS|IMAGE|CLOUDFLARE_TUNNEL_TOKEN) return 0 ;;
    esac
    return 1
}

is_key() { [ "$1" = NAME ] || is_file_key "$1"; }

ALL_KEYS='NAME WORKSPACE HOSTNAME TZ INIT PORTS HOST_ACCESS BROWSER_URL WEB WEB_PORT WITH AGENT YOLO ENV_KEYS IMAGE CLOUDFLARE_TUNNEL_TOKEN'

# Built-in default; empty means "no default" (the key is unset). AGENT has none here: the box picks the first agent of WITH.
default_of() {
    case $1 in
        NAME|HOSTNAME) printf 'swarmbox' ;;
        WORKSPACE) printf '%s/swarmbox' "$HOME" ;;
        TZ) printf 'local' ;;
        INIT) printf 'auto' ;;
        HOST_ACCESS) printf '0' ;;
        WEB|YOLO) printf '1' ;;
        WEB_PORT) printf '7681' ;;
        IMAGE) printf '%s:%s' "$REGISTRY_REPO" "$VERSION_STR" ;;
    esac
}

# ---------------------------------------------------------------- version

self_dir() {
    case $0 in
        */*) _d=${0%/*} ;;
        *) _d=. ;;
    esac
    (cd "$_d" 2>/dev/null && pwd -P)
}

# Prints the version from the VERSION file next to the helper, or exits 3 (a corrupted helper archive, 3.7.1).
read_version() {
    _dir=$(self_dir) || die 3 "cannot find the folder of the host helper."
    [ -r "$_dir/VERSION" ] || die 3 "the host helper has no VERSION file ($_dir/VERSION); the helper archive is incomplete."
    _v=
    IFS= read -r _v < "$_dir/VERSION" || true
    trim "$_v"
    _v=$_t
    case $_v in
        [0-9]*.[0-9]*.[0-9]*) ;;
        *) die 3 "the VERSION file of the host helper does not hold a version (X.Y.Z): '$_v'." ;;
    esac
    case $_v in
        *[!0-9A-Za-z.+-]*) die 3 "the VERSION file of the host helper does not hold a version (X.Y.Z): '$_v'." ;;
    esac
    printf '%s' "$_v"
}

# ---------------------------------------------------------------- paths

trim() {
    _t=$1
    _t=${_t#"${_t%%[![:space:]]*}"}
    _t=${_t%"${_t##*[![:space:]]}"}
}

xdg_root() {
    # $1 = value of the XDG variable, $2 = default
    case $1 in
        /*) _r=$1 ;;
        *) _r=$2 ;;
    esac
    printf '%s' "${_r%/}"
}

# Valid box name: becomes a folder name and a container name. `config` is reserved: the default box keeps its file at
# <config>/config, so a folder with that name would collide with it.
valid_box_name() {
    case $1 in
        ''|[!A-Za-z0-9]*|*[!A-Za-z0-9_.-]*) return 1 ;;
        config) return 1 ;;
    esac
    return 0
}

init_paths() {
    case ${HOME:-} in
        /*) ;;
        *) die 1 "HOME is not set to an absolute path." ;;
    esac
    VERSION_STR=$(read_version) || exit 3   # the exit must happen outside the command substitution
    BOX=${SWARMBOX_NAME:-swarmbox}
    valid_box_name "$BOX" || die 2 "invalid SWARMBOX_NAME '$BOX': it must start with a letter or digit, use only letters, digits, '.', '_' and '-', and not be 'config'."
    CFG_ROOT=$(xdg_root "${XDG_CONFIG_HOME:-}" "$HOME/.config")/swarmbox
    STATE_DIR=$(xdg_root "${XDG_STATE_HOME:-}" "$HOME/.local/state")/swarmbox
    if [ "$BOX" = swarmbox ]; then
        CFG_DIR=$CFG_ROOT
    else
        CFG_DIR=$CFG_ROOT/$BOX
    fi
    CFG_FILE=$CFG_DIR/config
    NOTICES=$STATE_DIR/notices
}

# private_dir DIR: makes DIR (and its parents) and removes the group and other permissions of DIR itself (never adds any), so that no other account can plant a file or a
# symlink in it (a folder that already existed with a looser mode is tightened; one that is not ours cannot be and is left as it
# is). Never recursive. Security review SR-03.
private_dir() {
    mkdir -p "$1" || return 1
    chmod go-rwx "$1" 2> /dev/null || true
}

# ---------------------------------------------------------------- the octal mode of a file (B22, B34)

mode_ok() {
    case $1 in
        [0-7][0-7][0-7]|[0-7][0-7][0-7][0-7]) return 0 ;;
    esac
    return 1
}

# find -perm reports only "has these bits"; build the number bit by bit.
mode_by_find() {
    [ -n "$(find "$1" -perm -000 -print 2>/dev/null)" ] || return 1
    _has() { [ -n "$(find "$1" -perm -"$2" -print 2>/dev/null)" ]; }
    _sp=0 _ow=0 _gr=0 _ot=0
    _has "$1" 4000 && _sp=$((_sp + 4))
    _has "$1" 2000 && _sp=$((_sp + 2))
    _has "$1" 1000 && _sp=$((_sp + 1))
    _has "$1" 400 && _ow=$((_ow + 4))
    _has "$1" 200 && _ow=$((_ow + 2))
    _has "$1" 100 && _ow=$((_ow + 1))
    _has "$1" 40 && _gr=$((_gr + 4))
    _has "$1" 20 && _gr=$((_gr + 2))
    _has "$1" 10 && _gr=$((_gr + 1))
    _has "$1" 4 && _ot=$((_ot + 4))
    _has "$1" 2 && _ot=$((_ot + 2))
    _has "$1" 1 && _ot=$((_ot + 1))
    if [ "$_sp" -ne 0 ]; then
        printf '%s%s%s%s' "$_sp" "$_ow" "$_gr" "$_ot"
    else
        printf '%s%s%s' "$_ow" "$_gr" "$_ot"
    fi
}

# Prints the mode as octal (600, 644, 4755...), or nothing and returns 1 when no form works.
file_mode() {
    _m=$(stat -c %a "$1" 2>/dev/null) || _m=
    if ! mode_ok "$_m"; then
        _m=$(stat -f %Lp "$1" 2>/dev/null) || _m=
    fi
    if ! mode_ok "$_m"; then
        _m=$(mode_by_find "$1") || _m=
    fi
    mode_ok "$_m" || return 1
    case $_m in
        0[0-7][0-7][0-7]) _m=${_m#0} ;;
    esac
    printf '%s' "$_m"
}

# ---------------------------------------------------------------- reading the config file (3.7.3)

# Parses one line into P_KEY and P_VAL; returns 1 for a blank line or a comment.
parse_line() {
    trim "$1"
    _l=$_t
    case $_l in
        ''|'#'*) return 1 ;;
    esac
    case $_l in
        *=*)
            trim "${_l%%=*}"
            P_KEY=$_t
            trim "${_l#*=}"
            P_VAL=$_t
            ;;
        *)
            P_KEY=$_l
            P_VAL=
            ;;
    esac
    return 0
}

# Prints the value of the last line for KEY; returns 1 when the file has no line for it.
cfg_raw() {
    [ -f "$CFG_FILE" ] || return 1
    _found=1
    _val=
    while IFS= read -r _line || [ -n "$_line" ]; do
        parse_line "$_line" || continue
        if [ "$P_KEY" = "$1" ]; then
            _val=$P_VAL
            _found=0
        fi
    done < "$CFG_FILE"
    printf '%s' "$_val"
    return "$_found"
}

TOKEN_IGNORED=0

# One pass over the file per call of the helper: one warning for unknown keys, and the tunnel-token mode rule.
cfg_prepare() {
    TOKEN_IGNORED=0
    [ -f "$CFG_FILE" ] || return 0
    [ -r "$CFG_FILE" ] || die 1 "cannot read the config file $CFG_FILE."
    _unk=
    _hastoken=0
    while IFS= read -r _line || [ -n "$_line" ]; do
        parse_line "$_line" || continue
        if is_file_key "$P_KEY"; then
            if [ "$P_KEY" = CLOUDFLARE_TUNNEL_TOKEN ] && [ -n "$P_VAL" ]; then
                _hastoken=1
            fi
        else
            case " $_unk " in
                *" $P_KEY "*) ;;
                *) _unk="$_unk $P_KEY" ;;
            esac
        fi
    done < "$CFG_FILE"
    [ -z "$_unk" ] || warn "ignoring unknown key(s) in $CFG_FILE:$_unk"
    if [ "$_hastoken" = 1 ]; then
        _mode=$(file_mode "$CFG_FILE") || _mode=
        if [ "$_mode" != 600 ]; then
            TOKEN_IGNORED=1
            if [ -n "$_mode" ]; then
                warn "the config file holds the tunnel token but its mode is $_mode; run \`chmod 600 $CFG_FILE\`"
            else
                warn "the config file holds the tunnel token but its mode could not be read; run \`chmod 600 $CFG_FILE\`"
            fi
        fi
    fi
}

# Sets R_VAL and R_SRC (env, file or default) for KEY.
resolve() {
    R_SRC=default
    R_VAL=
    eval "_e=\${SWARMBOX_$1:-}"
    if [ -n "$_e" ]; then
        R_VAL=$_e
        R_SRC='env'
        return 0
    fi
    if is_file_key "$1" && { [ "$1" != CLOUDFLARE_TUNNEL_TOKEN ] || [ "$TOKEN_IGNORED" = 0 ]; }; then
        if _fv=$(cfg_raw "$1") && [ -n "$_fv" ]; then
            R_VAL=$_fv
            R_SRC='file'
            return 0
        fi
    fi
    R_VAL=$(default_of "$1")
}

# resolve_tunnel_token: sets TUNNEL_TOKEN (empty when there is none) and returns 1 when there is none. The order is the
# environment (SWARMBOX_CLOUDFLARE_TUNNEL_TOKEN), then the config key, accepted only with file mode 600 (D28; cfg_prepare
# has already warned once, naming `chmod 600`, and set TOKEN_IGNORED otherwise). Needs cfg_prepare first. The value is
# never printed here, never put on an argv and never exported.
resolve_tunnel_token() {
    resolve CLOUDFLARE_TUNNEL_TOKEN
    TUNNEL_TOKEN=$R_VAL
    [ -n "$TUNNEL_TOKEN" ]
}

# ---------------------------------------------------------------- validation (3.7.3, 8.2); messages name the rule

valid_port() {
    case $1 in
        ''|*[!0-9]*) return 1 ;;
    esac
    [ "${#1}" -le 5 ] && [ "$1" -ge 1 ] && [ "$1" -le 65535 ]
}

# Four decimal numbers from 0 to 255 separated by dots.
valid_ipv4() {
    case $1 in
        ''|*[!0-9.]*|.*|*.|*..*) return 1 ;;
    esac
    _oldifs=$IFS
    IFS=.
    set -f
    # shellcheck disable=SC2086
    set -- $1
    set +f
    IFS=$_oldifs
    [ $# -eq 4 ] || return 1
    for _x in "$@"; do
        [ "${#_x}" -le 3 ] && [ "$_x" -le 255 ] || return 1
    done
    return 0
}

valid_port_entry() {
    _pe=$1
    case $_pe in
        *:*:*:*) return 1 ;;
        *:*:*)
            _pa=${_pe%%:*}
            _pr=${_pe#*:}
            valid_ipv4 "$_pa" || return 1
            valid_port "${_pr%%:*}" && valid_port "${_pr#*:}"
            ;;
        *:*) valid_port "${_pe%%:*}" && valid_port "${_pe#*:}" ;;
        *) valid_port "$_pe" ;;
    esac
}

valid_tool_name() {
    case $1 in
        ''|[!a-z0-9]*|*[!a-z0-9_-]*) return 1 ;;
    esac
    return 0
}

valid_env_name() {
    case $1 in
        ''|[!A-Za-z_]*|*[!A-Za-z0-9_]*) return 1 ;;
    esac
    return 0
}

# A name that may be passed to the box: an environment variable name, not one of the host-side SWARMBOX_CLOUDFLARE_ names (7.2).
valid_passable_env_name() {
    valid_env_name "$1" || return 1
    case $1 in
        SWARMBOX_CLOUDFLARE_*) return 1 ;;
    esac
    return 0
}

# valid_list FUNCTION VALUE: a comma list, no spaces, no empty item, each item accepted by FUNCTION.
valid_list() {
    _fn=$1
    case $2 in
        ,*|*,|*,,*|*[[:space:]]*) return 1 ;;
    esac
    _oldifs=$IFS
    IFS=,
    set -f
    # shellcheck disable=SC2086  # splitting on commas is the point
    set -- $2
    set +f
    IFS=$_oldifs
    for _item in "$@"; do
        "$_fn" "$_item" || return 1
    done
    return 0
}

# An image reference: the characters Podman accepts in one, and never a leading '-' (a reference is passed to Podman as a bare
# argument, so a leading '-' would be read as an option: security review SR-01).
valid_image_ref() {
    case $1 in
        -*|*[!A-Za-z0-9._/:@-]*) return 1 ;;
    esac
    return 0
}

# validate_value KEY VALUE: sets V_OUT (the value to store) or prints the rule and returns 1.
validate_value() {
    _k=$1
    V_OUT=$2
    _bad() { warn "invalid value for $_k: $*"; return 1; }
    case $V_OUT in
        *"$NL"*|*"$CR"*) _bad "a value cannot contain a newline (3.7.3)."; return 1 ;;
    esac
    trim "$V_OUT"
    V_OUT=$_t
    [ -n "$V_OUT" ] || return 0   # empty means "use the default"
    case $_k in
        WORKSPACE)
            case $V_OUT in
                *:*) _bad "the path must not contain ':' (Podman reads it as a separator)."; return 1 ;;
            esac
            # shellcheck disable=SC2088  # a literal tilde is what is matched; the shell did not expand it
            case $V_OUT in
                '~') V_OUT=$HOME ;;
                '~/'*) V_OUT=$HOME/${V_OUT#'~/'} ;;
                /*) ;;
                ./*) V_OUT=$PWD/${V_OUT#./} ;;
                .) V_OUT=$PWD ;;
                *) V_OUT=$PWD/$V_OUT ;;
            esac
            while :; do
                case $V_OUT in
                    ?*/) V_OUT=${V_OUT%/} ;;
                    *) break ;;
                esac
            done
            ;;
        HOSTNAME)
            case $V_OUT in
                [!A-Za-z0-9]*|*[!A-Za-z0-9.-]*) _bad "it must start with a letter or digit and use only letters, digits, '.' and '-'."; return 1 ;;
            esac
            [ "${#V_OUT}" -le 63 ] || { _bad "it must be at most 63 characters."; return 1; }
            ;;
        TZ)
            case $V_OUT in
                [!A-Za-z]*|*[!A-Za-z0-9_+/-]*|*//*|*/|*..*) _bad "it must be 'local', 'off' or a zone name such as Europe/Lisbon (letters, digits, '_', '+', '-', '/')."; return 1 ;;
            esac
            ;;
        INIT)
            case $V_OUT in
                auto|0|1) ;;
                *) _bad "it must be auto, 0 or 1."; return 1 ;;
            esac
            ;;
        HOST_ACCESS|WEB|YOLO)
            case $V_OUT in
                0|1) ;;
                *) _bad "it must be 0 or 1."; return 1 ;;
            esac
            ;;
        PORTS)
            valid_list valid_port_entry "$V_OUT" || { _bad "it must be a comma list, without spaces, of PORT, HOST:CONTAINER or ADDRESS:HOST:CONTAINER with ports from 1 to 65535."; return 1; }
            ;;
        BROWSER_URL)
            case $V_OUT in
                *[[:space:]]*) _bad "it must not contain blanks."; return 1 ;;
                http://?*|https://?*) ;;
                *[!0-9]*)
                    case $V_OUT in
                        *:*)
                            if [ -z "${V_OUT%:*}" ] || ! valid_port "${V_OUT##*:}"; then
                                _bad "it must be a port number, HOST:PORT or an http(s) URL."
                                return 1
                            fi
                            ;;
                        *) _bad "it must be a port number, HOST:PORT or an http(s) URL."; return 1 ;;
                    esac
                    ;;
                *) valid_port "$V_OUT" || { _bad "a bare number must be a port from 1 to 65535."; return 1; } ;;
            esac
            ;;
        WEB_PORT)
            valid_port "$V_OUT" || { _bad "it must be a port number from 1 to 65535."; return 1; }
            ;;
        WITH|AGENT)
            if [ "$_k" = AGENT ]; then
                valid_tool_name "$V_OUT" || { _bad "it must be one tool name: lower-case letters, digits, '_' and '-'."; return 1; }
            else
                valid_list valid_tool_name "$V_OUT" || { _bad "it must be a comma list, without spaces, of tool names (lower-case letters, digits, '_' and '-')."; return 1; }
            fi
            ;;
        ENV_KEYS)
            valid_list valid_passable_env_name "$V_OUT" || { _bad "it must be a comma list, without spaces, of environment variable names (letters, digits, '_', not starting with a digit, not SWARMBOX_CLOUDFLARE_*)."; return 1; }
            ;;
        IMAGE)
            valid_image_ref "$V_OUT" || { _bad "it must be an image reference: letters, digits and '.', '_', '/', ':', '@', '-' only, not starting with '-' (Podman would read it as an option)."; return 1; }
            ;;
        CLOUDFLARE_TUNNEL_TOKEN)
            case $V_OUT in
                *[!A-Za-z0-9+/=_.-]*) _bad "the token must use only letters, digits and '+', '/', '=', '_', '.', '-'."; return 1 ;;
            esac
            ;;
    esac
    return 0
}

# ---------------------------------------------------------------- writing the config file (3.7.3)

# cfg_write_keys KEY VALUE [KEY VALUE ...]: replaces (or appends) the keys, keeps every other line, writes under umask 077
# into a temporary file in the same folder, runs chmod 600 on it and renames it over the config. Refuses to write the
# tunnel token (exit 1) if the chmod fails; for other keys it also writes nothing (exit 1).
cfg_write_keys() {
    _tok=0
    _ks=
    _i=1
    while [ "$_i" -le "$#" ]; do
        eval "_wk=\${$_i}"
        _ks="$_ks $_wk "
        [ "$_wk" = CLOUDFLARE_TUNNEL_TOKEN ] && _tok=1
        _i=$((_i + 2))
    done
    private_dir "$CFG_DIR" || die 1 "cannot create $CFG_DIR."
    [ ! -f "$CFG_FILE" ] || [ -r "$CFG_FILE" ] || die 1 "cannot read the config file $CFG_FILE."
    # the temporary name is predictable: it is removed first (a symlink planted there is deleted, not followed) and then created
    # with noclobber, which fails instead of writing through anything that appears in between (security review SR-02)
    _tmp=$CFG_FILE.tmp.$$
    rm -f "$_tmp"
    set -C
    {
        if [ -f "$CFG_FILE" ]; then
            while IFS= read -r _line || [ -n "$_line" ]; do
                if parse_line "$_line"; then
                    case $_ks in
                        *" $P_KEY "*) continue ;;
                    esac
                fi
                printf '%s\n' "$_line"
            done < "$CFG_FILE"
        else
            printf '%s\n' '# SwarmBox host configuration: one KEY=VALUE per line, values literal (see docs/design.md 3.7.3).'
        fi
        while [ "$#" -ge 2 ]; do
            printf '%s=%s\n' "$1" "$2"
            shift 2
        done
    } > "$_tmp" || { set +C; rm -f "$_tmp"; die 1 "cannot write $_tmp."; }
    set +C
    if ! chmod 600 "$_tmp"; then
        rm -f "$_tmp"
        if [ "$_tok" = 1 ]; then
            die 1 "could not set mode 600 on the config file; the tunnel token was not written."
        fi
        die 1 "could not set mode 600 on the config file; nothing was written."
    fi
    mv -f "$_tmp" "$CFG_FILE" || { rm -f "$_tmp"; die 1 "cannot replace $CFG_FILE."; }
}

# Notices state (3.7.5): one line <box>:<KEY> per announced key.
notice_seen() { [ -f "$NOTICES" ] && grep -qxF -- "$BOX:$1" "$NOTICES"; }
notice_mark() {
    private_dir "$STATE_DIR" || return 1
    printf '%s:%s\n' "$BOX" "$1" >> "$NOTICES"
}
notice_clear() {
    [ -f "$NOTICES" ] || return 0
    rm -f "$NOTICES.tmp.$$"   # SR-02: a planted symlink is deleted, and noclobber refuses anything that appears after
    ( set -C; grep -vxF -- "$BOX:$1" "$NOTICES" > "$NOTICES.tmp.$$" ) || :   # grep exits 1 when no line is left
    [ -f "$NOTICES.tmp.$$" ] && [ ! -L "$NOTICES.tmp.$$" ] || return 0
    mv -f "$NOTICES.tmp.$$" "$NOTICES"
}

# ---------------------------------------------------------------- reading a secret without echo

# Reads one line from the terminal into SECRET with echo off. Restores the terminal on every exit path (stty -g, trap).
read_secret() {
    SECRET=
    if [ ! -t 0 ]; then
        die 2 "the tunnel token must be typed on a terminal (never as an argument and never piped)."
    fi
    _stty=$(stty -g 2>/dev/null) || die 2 "the tunnel token must be typed on a terminal."
    trap 'stty "$_stty" 2>/dev/null; exit 1' INT TERM HUP
    printf 'Cloudflare tunnel token (input is hidden): ' >&2
    stty -echo 2>/dev/null
    _rc=0
    IFS= read -r SECRET || _rc=$?
    stty "$_stty" 2>/dev/null
    trap - INT TERM HUP
    printf '\n' >&2
    [ "$_rc" -eq 0 ] || [ -n "$SECRET" ] || die 2 "no token was read."
}

# ---------------------------------------------------------------- commands

cmd_version() {
    [ $# -eq 0 ] || usage
    read_version
    printf '\n'
}

cmd_config_get() {
    [ $# -eq 1 ] || usage
    is_key "$1" || die 2 "unknown key '$1'."
    init_paths
    cfg_prepare
    if [ "$1" = CLOUDFLARE_TUNNEL_TOKEN ]; then
        resolve_tunnel_token || return 1
        printf '%s\n' "$TUNNEL_TOKEN"
        return 0
    fi
    resolve "$1"
    [ -n "$R_VAL" ] || return 1
    printf '%s\n' "$R_VAL"
}

cmd_config_set() {
    if [ $# -lt 1 ] || [ $# -gt 2 ]; then usage; fi
    _key=$1
    [ "$_key" != NAME ] || die 2 "NAME is not a key of the config file: it selects the config folder, so set SWARMBOX_NAME in the environment."
    is_file_key "$_key" || die 2 "unknown key '$_key'."
    init_paths
    if [ "$_key" = CLOUDFLARE_TUNNEL_TOKEN ]; then
        [ $# -eq 1 ] || die 2 "the tunnel token is never given on the command line; run 'swarmbox config set CLOUDFLARE_TUNNEL_TOKEN' and type it."
        read_secret
        [ -n "$SECRET" ] || die 2 "invalid value for CLOUDFLARE_TUNNEL_TOKEN: it must not be empty."
        validate_value "$_key" "$SECRET" || exit 2
        _stored=$V_OUT
        SECRET=
    else
        [ $# -eq 2 ] || usage
        validate_value "$_key" "$2" || exit 2
        _stored=$V_OUT
    fi
    cfg_write_keys "$_key" "$_stored" || exit 1
    notice_clear "$_key"
}

cmd_config_list() {
    [ $# -eq 0 ] || usage
    init_paths
    cfg_prepare
    for _key in $ALL_KEYS; do
        resolve "$_key"
        if [ "$_key" = CLOUDFLARE_TUNNEL_TOKEN ]; then
            if [ -n "$R_VAL" ]; then
                printf '%s=set\t%s\n' "$_key" "$R_SRC"
            else
                printf '%s=unset\t%s\n' "$_key" "$R_SRC"
            fi
        else
            printf '%s=%s\t%s\n' "$_key" "$R_VAL" "$R_SRC"
        fi
    done
}

cmd_config_seed() {
    _sw=
    _sws=
    _sim=
    while [ $# -gt 0 ]; do
        case $1 in
            --with|--workspace|--image)
                [ $# -ge 2 ] || die 2 "$1 needs a value."
                _a=$1
                _v=$2
                shift 2
                ;;
            --with=*|--workspace=*|--image=*)
                _a=${1%%=*}
                _v=${1#*=}
                shift
                ;;
            *) die 2 "config seed: unknown argument '$1'." ;;
        esac
        case $_a in
            --with) _sw=$_v ;;
            --workspace) _sws=$_v ;;
            --image) _sim=$_v ;;
        esac
    done
    init_paths
    # validate everything first: an invalid seed changes nothing
    _pairs=
    _sk=
    for _key in WITH WORKSPACE IMAGE; do
        case $_key in
            WITH) _v=$_sw ;;
            WORKSPACE) _v=$_sws ;;
            IMAGE) _v=$_sim ;;
        esac
        validate_value "$_key" "$_v" || exit 2
        [ -n "$V_OUT" ] || continue
        eval "SEED_$_key=\$V_OUT"
        _sk="$_sk $_key"
    done
    if [ ! -f "$CFG_FILE" ]; then
        set --
        for _key in $_sk; do
            eval "set -- \"\$@\" \"\$_key\" \"\$SEED_$_key\""
        done
        cfg_write_keys "$@" || exit 1
        eval "_ws=\${SEED_WORKSPACE:-}"
        [ -z "$_ws" ] || warn "WORKSPACE recorded as $_ws"
        return 0
    fi
    cfg_prepare
    for _key in $_sk; do
        eval "_want=\$SEED_$_key"
        # compare with what the file (or the default) says, ignoring the environment
        if _have=$(cfg_raw "$_key") && [ -n "$_have" ]; then :; else _have=$(default_of "$_key"); fi
        [ "$_want" != "$_have" ] || continue
        if notice_seen "$_key"; then continue; fi
        warn "init asked for $_key=$_want, the config says $_key=$_have; run \`swarmbox config set $_key $_want\` to change it"
        notice_mark "$_key" || warn "cannot write $NOTICES; the notice may repeat."
    done
    return 0
}

# ENV_KEYS as stored in the file (the list the commands edit).
env_file_list() { _el=$(cfg_raw ENV_KEYS) || _el=; printf '%s' "$_el"; }

cmd_env() {
    [ $# -ge 1 ] || usage
    _sub=$1
    shift
    case $_sub in
        add|rm)
            [ $# -eq 1 ] || usage
            _n=$1
            valid_env_name "$_n" || die 2 "invalid variable name '$_n': use letters, digits and '_', not starting with a digit."
            valid_passable_env_name "$_n" || die 2 "'$_n' is refused: names starting with SWARMBOX_CLOUDFLARE_ belong to the host side and never enter the box."
            init_paths
            cfg_prepare
            _cur=$(env_file_list)
            _new=
            _present=0
            _oldifs=$IFS
            IFS=,
            set -f
            # shellcheck disable=SC2086
            for _item in $_cur; do
                [ -n "$_item" ] || continue
                if [ "$_item" = "$_n" ]; then
                    _present=1
                    [ "$_sub" = rm ] && continue
                fi
                _new=${_new:+$_new,}$_item
            done
            set +f
            IFS=$_oldifs
            if [ "$_sub" = add ]; then
                [ "$_present" = 0 ] || return 0
                _new=${_new:+$_new,}$_n
            else
                [ "$_present" = 1 ] || return 0
            fi
            cfg_write_keys ENV_KEYS "$_new" || exit 1
            notice_clear ENV_KEYS
            if [ -n "${SWARMBOX_ENV_KEYS:-}" ]; then
                warn "SWARMBOX_ENV_KEYS is set in the environment and overrides the file; the change shows only when it is unset."
            fi
            ;;
        list)
            [ $# -eq 0 ] || usage
            init_paths
            cfg_prepare
            resolve ENV_KEYS
            _oldifs=$IFS
            IFS=,
            set -f
            # shellcheck disable=SC2086
            set -- $R_VAL
            set +f
            IFS=$_oldifs
            for _item in "$@"; do
                [ -n "$_item" ] || continue
                if ! valid_passable_env_name "$_item"; then
                    warn "ignoring the invalid name '$_item' in ENV_KEYS."
                    continue
                fi
                eval "_isset=\${$_item+x}"
                if [ "$_isset" = x ]; then
                    printf '%s\tset\n' "$_item"
                else
                    printf '%s\tnot set\n' "$_item"
                fi
            done
            ;;
        *) usage ;;
    esac
}

# ---------------------------------------------------------------- create-flags and fingerprint (3.6, 3.7.2, 3.7.4, 8.2, 8.3)
# Slice 3.2. Nothing here calls Podman. The flags are collected in OUT, one argument per line, and printed only when every
# check has passed, so a failure never leaves half a list on standard output (3.6: `up` captures the output first).

TAB=$(printf '\t')

# The first of sha256sum and `shasum -a 256` that exists (Linux has the first, macOS the second); exit 3 when neither does.
need_sha256() {
    if command -v sha256sum > /dev/null 2>&1; then
        SHA=sha256sum
    elif command -v shasum > /dev/null 2>&1; then
        SHA=shasum
    else
        die 3 "neither sha256sum nor shasum was found; one of them is needed to compute the box fingerprint."
    fi
}

# Hash of standard input, hex only.
sha256_stdin() {
    if [ "$SHA" = sha256sum ]; then
        _so=$(sha256sum)
    else
        _so=$(shasum -a 256)
    fi
    printf '%s' "${_so%% *}"
}

# Reads tool-ports from the folder of the helper into TP_DATA: one "tool<TAB>port" line each, malformed lines skipped with a
# warning. The file always exists in a good archive (3.7.1, 6.3); a missing one is a corrupted helper: exit 3.
load_tool_ports() {
    _dir=$(self_dir) || die 3 "cannot find the folder of the host helper."
    [ -r "$_dir/tool-ports" ] || die 3 "the host helper has no tool-ports file ($_dir/tool-ports); the helper archive is incomplete. Run \`swarmbox update\` or remove $_dir so the next call extracts the helper again."
    TP_DATA=
    while IFS= read -r _l || [ -n "$_l" ]; do
        [ -n "$_l" ] || continue
        case $_l in
            *"$TAB"*)
                _tn=${_l%%"$TAB"*}
                _tp=${_l#*"$TAB"}
                if valid_tool_name "$_tn" && valid_port "$_tp"; then
                    TP_DATA=$TP_DATA$_tn$TAB$_tp$NL
                    continue
                fi
                ;;
        esac
        warn "ignoring a malformed line in $_dir/tool-ports: $_l"
    done < "$_dir/tool-ports"
}

# norm_port ENTRY: N_OUT = ADDRESS:HOST:CONTAINER; loopback unless an address was given (8.2, PORTS).
norm_port() {
    case $1 in
        *:*:*) N_OUT=$1 ;;
        *:*) N_OUT=127.0.0.1:$1 ;;
        *) N_OUT=127.0.0.1:$1:$1 ;;
    esac
}

# The published ports of the box: the user's PORTS (normalized), then the ports of the tools in WITH from tool-ports,
# skipping a host port that is already published. Sets PORT_LIST (comma list) and PORT_ARGS (one mapping per line).
# $1 = 1 to warn about all-interface binds.
build_ports() {
    PORT_LIST=
    PORT_ARGS=
    _hosts=,
    _oldifs=$IFS
    IFS=,
    set -f
    # shellcheck disable=SC2086  # splitting on commas is the point
    set -- $C_PORTS
    set +f
    IFS=$_oldifs
    _warn=${WARN_PORTS:-0}
    for _e in "$@"; do
        [ -n "$_e" ] || continue
        norm_port "$_e"
        _m=$N_OUT
        _rest=${_m#*:}
        _hosts=$_hosts${_rest%%:*},
        PORT_LIST=${PORT_LIST:+$PORT_LIST,}$_m
        PORT_ARGS=$PORT_ARGS$_m$NL
        case $_m in
            0.0.0.0:*) [ "$_warn" = 0 ] || warn "port $_m is exposed on all network interfaces" ;;
        esac
    done
    [ -n "$C_WITH" ] || return 0
    _oldifs=$IFS
    IFS=,
    set -f
    # shellcheck disable=SC2086
    set -- $C_WITH
    set +f
    IFS=$_oldifs
    for _t in "$@"; do
        while IFS= read -r _l; do
            [ -n "$_l" ] || continue
            [ "${_l%%"$TAB"*}" = "$_t" ] || continue
            _p=${_l#*"$TAB"}
            case $_hosts in
                *",$_p,"*) continue ;;
            esac
            _hosts=$_hosts$_p,
            _m=127.0.0.1:$_p:$_p
            PORT_LIST=${PORT_LIST:+$PORT_LIST,}$_m
            PORT_ARGS=$PORT_ARGS$_m$NL
        done <<TPEOF
$TP_DATA
TPEOF
    done
}

# BROWSER_URL as the box gets it: a bare number N is http://host.containers.internal:N, host:port gets http://, a URL stays.
# The empty string, when asked for explicitly with --browser-url, is the port 9222 (`--remote-browser` without a value today).
normalize_browser_url() {
    case $1 in
        '') B_OUT=http://host.containers.internal:9222 ;;
        http://*|https://*) B_OUT=$1 ;;
        *[!0-9]*) B_OUT=http://$1 ;;
        *) B_OUT=http://host.containers.internal:$1 ;;
    esac
}

# Reads and validates every creation-time key into C_<KEY> (environment, file, default; the environment is not validated by
# `config get`, so it is here). $1 = 1 when INIT must already be 0 or 1. BROWSER_OVERRIDE_SET/BROWSER_OVERRIDE: --browser-url.
load_creation() {
    init_paths
    cfg_prepare
    for _key in WORKSPACE HOSTNAME TZ INIT PORTS HOST_ACCESS BROWSER_URL WEB WEB_PORT WITH AGENT YOLO ENV_KEYS IMAGE; do
        resolve "$_key"
        _v=$R_VAL
        if [ "$_key" = BROWSER_URL ] && [ "${BROWSER_OVERRIDE_SET:-0}" = 1 ]; then
            _v=$BROWSER_OVERRIDE
            R_SRC='env'
        fi
        if [ "$_key" = TZ ]; then
            case $_v in
                OFF|none|NONE) _v=off ;;   # the spellings v0.1.0 accepted for "keep the image's UTC"
            esac
        fi
        if [ "$R_SRC" != default ]; then   # a default is the helper's own value (the image default holds the <org> placeholder)
            validate_value "$_key" "$_v" || exit 2
            _v=$V_OUT
        fi
        eval "C_$_key=\$_v"
    done
    C_NAME=$BOX
    if [ "$1" = 1 ]; then
        case $C_INIT in
            0|1) ;;
            *) die 2 "INIT is '$C_INIT': 'swarmbox up' resolves auto to 0 or 1 before it asks for the flags (set SWARMBOX_INIT to 0 or 1 when calling create-flags directly)." ;;
        esac
    fi
    if [ -n "$C_BROWSER_URL" ] || [ "${BROWSER_OVERRIDE_SET:-0}" = 1 ]; then
        normalize_browser_url "$C_BROWSER_URL"
        C_BROWSER_URL=$B_OUT
    fi
    # TZ as it will be passed: local needs the host's local time file
    TZ_R=$C_TZ
    if [ "$C_TZ" = local ] && [ ! -e "${SWARMBOX_LOCALTIME_FILE:-/etc/localtime}" ]; then
        TZ_R=off
        [ "${WARN_PORTS:-0}" = 0 ] || warn "$([ -n "${SWARMBOX_LOCALTIME_FILE:-}" ] && printf '%s' "$SWARMBOX_LOCALTIME_FILE" || printf '/etc/localtime') not found; the box will use UTC. Set TZ to a zone name such as Europe/Lisbon with \`swarmbox config set TZ\`."
    fi
    build_ports
}

# env-hash (7.1): NAME=value for each listed name that is set, NAME for each that is not; sorted; SHA-256. The values only go
# through a pipe, never through an argument, and only the hash leaves this function.
compute_env_hash() {
    _lines=
    _oldifs=$IFS
    IFS=,
    set -f
    # shellcheck disable=SC2086
    set -- $C_ENV_KEYS
    set +f
    IFS=$_oldifs
    for _n in "$@"; do
        [ -n "$_n" ] || continue
        eval "_isset=\${$_n+x}"
        if [ "$_isset" = x ]; then
            eval "_val=\${$_n}"
            _lines=$_lines$_n=$_val$NL
        else
            _lines=$_lines$_n$NL
        fi
    done
    ENV_HASH=$(printf '%s' "$_lines" | sort | sha256_stdin)
    _val=
}

# FP: SHA-256 over the sorted KEY=value lines of every creation-time key (3.7.4) plus env-hash=<hash>.
compute_fingerprint() {
    compute_env_hash
    [ -n "$ENV_HASH" ] || die 3 "could not compute a SHA-256 hash with $SHA."
    _l="AGENT=$C_AGENT${NL}BROWSER_URL=$C_BROWSER_URL${NL}ENV_KEYS=$C_ENV_KEYS${NL}HOSTNAME=$C_HOSTNAME${NL}HOST_ACCESS=$C_HOST_ACCESS${NL}IMAGE=$C_IMAGE${NL}INIT=$C_INIT${NL}NAME=$C_NAME${NL}PORTS=$PORT_LIST${NL}TZ=$TZ_R${NL}WEB=$C_WEB${NL}WEB_PORT=$C_WEB_PORT${NL}WITH=$C_WITH${NL}WORKSPACE=$C_WORKSPACE${NL}YOLO=$C_YOLO${NL}env-hash=$ENV_HASH$NL"
    FP=$(printf '%s' "$_l" | sort | sha256_stdin)
    [ -n "$FP" ] || die 3 "could not compute a SHA-256 hash with $SHA."
}

# True when the kernel says it is WSL; the probe file is overridable for tests (B32).
is_wsl() {
    _pv=${SWARMBOX_TEST_PROC_VERSION:-/proc/version}
    [ -r "$_pv" ] || return 1
    grep -qi microsoft "$_pv" 2> /dev/null
}

# A path under /mnt/<one letter>/ (a Windows drive on WSL, D34).
win_drive_path() {
    case $1 in
        /mnt/[A-Za-z]|/mnt/[A-Za-z]/*) return 0 ;;
    esac
    return 1
}

# D34: refuse a workspace on a Windows drive, by the written path, by each symlink on the way (readlink without options is
# on Linux and macOS) and by the real path of an existing folder.
check_not_windows_drive() {
    is_wsl || return 0
    _p=$1
    _n=0
    while :; do
        if win_drive_path "$_p"; then
            die 4 "workspace $1 is on a Windows drive; WSL2 is supported only with the workspace on the Linux filesystem (for example ~/swarmbox)."
        fi
        [ -L "$_p" ] || break
        [ "$_n" -lt 10 ] || break
        _t=$(readlink "$_p") || break
        case $_t in
            /*) _p=$_t ;;
            *) _p=${_p%/*}/$_t ;;
        esac
        _n=$((_n + 1))
    done
    if [ -d "$1" ]; then
        _real=$(cd "$1" 2> /dev/null && pwd -P) || _real=
        if [ -n "$_real" ] && win_drive_path "$_real"; then
            die 4 "workspace $1 is on a Windows drive; WSL2 is supported only with the workspace on the Linux filesystem (for example ~/swarmbox)."
        fi
    fi
}

# 3.5 edge cases: the folder is created when missing (one message, parents too), must be a folder, and must be writable.
check_workspace() {
    check_not_windows_drive "$C_WORKSPACE"
    if [ ! -e "$C_WORKSPACE" ] && [ ! -L "$C_WORKSPACE" ]; then
        (umask 022 && mkdir -p "$C_WORKSPACE") 2> /dev/null || die 4 "cannot create the workspace folder $C_WORKSPACE."
        warn "created the workspace folder $C_WORKSPACE"
    fi
    [ -d "$C_WORKSPACE" ] || die 4 "workspace $C_WORKSPACE is not a folder."
    if [ ! -w "$C_WORKSPACE" ] || [ ! -x "$C_WORKSPACE" ]; then
        die 4 "workspace $C_WORKSPACE is not writable by this user"
    fi
}

OUT=
emit() { OUT=$OUT$1$NL; }

# D7: no output may ask for the host network or more privilege. Nothing builds such a line; this is the last look before printing.
guard_flags() {
    while IFS= read -r _g; do
        case $_g in
            --network*|--net=*|--privileged*|--pid=*|--ipc=*|--uts=*|--cap-add*|--userns=host*)
                die 70 "internal error: refusing to emit '$_g' (no host network or extra privilege, D7)."
                ;;
        esac
    done <<GEOF
$OUT
GEOF
}

cmd_create_flags() {
    BROWSER_OVERRIDE_SET=0
    BROWSER_OVERRIDE=
    while [ $# -gt 0 ]; do
        case $1 in
            --browser-url)
                [ $# -ge 2 ] || die 2 "--browser-url needs a value (an empty value means port 9222)."
                BROWSER_OVERRIDE_SET=1
                BROWSER_OVERRIDE=$2
                shift 2
                ;;
            --browser-url=*)
                BROWSER_OVERRIDE_SET=1
                BROWSER_OVERRIDE=${1#--browser-url=}
                shift
                ;;
            *) die 2 "create-flags: unknown argument '$1'." ;;
        esac
    done
    need_sha256
    load_tool_ports
    WARN_PORTS=1
    load_creation 1
    check_workspace
    compute_fingerprint
    case $C_ENV_KEYS in
        '') ;;
        *)
            _oldifs=$IFS
            IFS=,
            set -f
            # shellcheck disable=SC2086
            set -- $C_ENV_KEYS
            set +f
            IFS=$_oldifs
            for _n in "$@"; do
                eval "_isset=\${$_n+x}"
                [ "$_isset" = x ] || warn "$_n is listed but not set in this terminal; the box will start without it"
            done
            ;;
    esac
    _os=${SWARMBOX_TEST_OS:-$(uname -s)}
    OUT=
    emit --userns=keep-id:uid=1000,gid=1000
    emit --pids-limit=16384
    if [ "$_os" = Darwin ]; then
        emit --security-opt
        emit label=disable
    fi
    if [ "${SWARMBOX_TEST_NO_NESTED:-}" != 1 ]; then   # tests only: the nested level of the development box has utsns=host, where --hostname is refused
        emit --hostname
        emit "$C_HOSTNAME"
    fi
    emit -v
    emit "$C_WORKSPACE:/home/agent"
    [ "$C_INIT" != 1 ] || emit --init
    [ "$TZ_R" = off ] || emit "--tz=$TZ_R"
    emit --tmpfs
    emit /tmp/swarmbox
    if [ "${SWARMBOX_TEST_NO_NESTED:-}" != 1 ]; then   # tests only: a throwaway box in a container that cannot offer the third level (3.3, 13.3)
        emit --device
        emit /dev/net/tun
        emit --security-opt
        emit 'unmask=/proc/*'
    fi
    emit -v
    emit "$C_NAME-containers:/home/agent/.local/share/containers"
    if [ "$C_HOST_ACCESS" = 1 ]; then
        emit --add-host
        emit host.containers.internal:host-gateway
    fi
    while IFS= read -r _m; do
        [ -n "$_m" ] || continue
        emit -p
        emit "$_m"
    done <<PEOF
$PORT_ARGS
PEOF
    if [ "$C_WEB" = 1 ]; then
        emit -p
        emit "127.0.0.1:$C_WEB_PORT:7681"
    fi
    # the listed variables by name: Podman reads the value from its own environment, so it is never in argv (7.1)
    if [ -n "$C_ENV_KEYS" ]; then
        _oldifs=$IFS
        IFS=,
        set -f
        # shellcheck disable=SC2086
        set -- $C_ENV_KEYS
        set +f
        IFS=$_oldifs
        for _n in "$@"; do
            eval "_isset=\${$_n+x}"
            [ "$_isset" = x ] || continue
            emit -e
            emit "$_n"
        done
    fi
    emit -e
    emit "SWARMBOX_NAME=$C_NAME"
    emit -e
    emit "SWARMBOX_WEB=$C_WEB"
    emit -e
    emit "SWARMBOX_YOLO=$C_YOLO"
    if [ "${SWARMBOX_TEST_NO_NESTED:-}" = 1 ]; then emit -e; emit SWARMBOX_TEST_NO_NESTED=1; fi
    if [ -n "$C_WITH" ]; then emit -e; emit "SWARMBOX_WITH=$C_WITH"; fi
    if [ -n "$C_AGENT" ]; then emit -e; emit "SWARMBOX_AGENT=$C_AGENT"; fi
    if [ -n "$C_BROWSER_URL" ]; then emit -e; emit "SWARMBOX_BROWSER_URL=$C_BROWSER_URL"; fi
    emit --label
    emit swarmbox.managed=2
    emit --label
    emit "swarmbox.image=$C_IMAGE"
    emit --label
    emit "swarmbox.workspace=$C_WORKSPACE"
    emit --label
    emit "swarmbox.ports=$PORT_LIST"
    emit --label
    emit "swarmbox.env-hash=$ENV_HASH"
    emit --label
    emit "swarmbox.fingerprint=$FP"
    guard_flags
    printf '%s' "$OUT"
}

# label_get NAME: the value of a --label NAME=VALUE that was given; returns 1 when there is none.
label_get() {
    while IFS= read -r _ll; do
        case $_ll in
            "$1="*) printf '%s' "${_ll#*=}"; return 0 ;;
        esac
    done <<LEOF
$LABELS
LEOF
    return 1
}

# Prints one line per difference between the current configuration (C_*, PORT_LIST, ENV_HASH) and the box's labels in LABELS,
# in the wording of D30. Used by `fingerprint --explain` and by `up` (which prefixes each line and prints it on stderr).
# shellcheck disable=SC2016  # the backticks in the messages are literal (they quote `swarmbox reset` for the reader)
fp_explain() {
    _said=0
    if _b=$(label_get swarmbox.image) && [ "$_b" != "$C_IMAGE" ]; then
        printf 'this box was created from %s; the config asks for %s; run `swarmbox reset`\n' "$_b" "$C_IMAGE"
        _said=1
    fi
    if _b=$(label_get swarmbox.workspace) && [ "$_b" != "$C_WORKSPACE" ]; then
        printf 'the workspace in the config is %s, this box uses %s; run `swarmbox reset` to switch\n' "$C_WORKSPACE" "$_b"
        _said=1
    fi
    if _b=$(label_get swarmbox.ports) && [ "$_b" != "$PORT_LIST" ]; then
        printf '`PORTS` changed: box has %s, config has %s; run `swarmbox reset` to apply\n' "${_b:-(none)}" "${PORT_LIST:-(none)}"
        _said=1
    fi
    if _b=$(label_get swarmbox.env-hash) && [ "$_b" != "$ENV_HASH" ]; then
        printf 'the variables changed on the host; run `swarmbox reset` to apply them\n'
        _said=1
    fi
    if [ "$_said" = 0 ]; then
        printf 'another creation setting changed (the fingerprint differs); run `swarmbox reset` to apply\n'
    fi
}

# fingerprint [--explain] [--label NAME=VALUE]...: the hash of the current configuration; with labels it compares (exit 0 same,
# 1 different), with --explain it also prints one line per difference it can name (D30). Without labels there is no box to
# compare with: exit 5 for --explain. Reading the labels from Podman is `up`'s job (a later slice).
# shellcheck disable=SC2016  # the backticks in the messages are literal (they quote `swarmbox reset` for the reader)
cmd_fingerprint() {
    EXPLAIN=0
    LABELS=
    while [ $# -gt 0 ]; do
        case $1 in
            --explain) EXPLAIN=1; shift ;;
            --label)
                [ $# -ge 2 ] || die 2 "--label needs NAME=VALUE."
                _lv=$2
                shift 2
                ;;
            --label=*) _lv=${1#--label=}; shift ;;
            *) die 2 "fingerprint: unknown argument '$1'." ;;
        esac
        case $_lv in
            ?*=*) LABELS=$LABELS$_lv$NL; _lv= ;;
            '') ;;
            *) die 2 "a label must be NAME=VALUE: '$_lv'." ;;
        esac
    done
    need_sha256
    load_tool_ports
    WARN_PORTS=0
    load_creation 0
    compute_fingerprint
    if [ -z "$LABELS" ]; then
        [ "$EXPLAIN" = 0 ] || die 5 "no box: no labels were given to compare with."
        printf '%s\n' "$FP"
        return 0
    fi
    _have=$(label_get swarmbox.fingerprint) || die 5 "the box has no swarmbox.fingerprint label (it was not made by this version of SwarmBox)."
    printf '%s\n' "$FP"
    [ "$_have" != "$FP" ] || return 0
    [ "$EXPLAIN" = 0 ] || fp_explain
    return 1
}

# ---------------------------------------------------------------- up, reset, stop, url (3.5, 3.6, 3.7.2, 3.8, 4.2)
# Slice 3.3. Variables of this block start with u_ or UP_ so that they do not collide with the loops above. Standard output
# stays empty (data only); every message goes to standard error.

UP_LOCK=
UP_LOCK_HELD=0
UP_BG=
UP_ERRF=
UP_FLAGS=
UP_CIDF=

# Runs on every way out of up, reset and stop (EXIT trap): ends a background child, removes this call's temporary files and the
# lock, but only a lock this call made (UP_LOCK_HELD) and never one that it merely waited for.
up_cleanup() {
    if [ -n "$UP_BG" ]; then kill "$UP_BG" 2> /dev/null; fi
    [ -z "$UP_ERRF" ] || rm -f "$UP_ERRF"
    [ -z "$UP_FLAGS" ] || rm -f "$UP_FLAGS"
    [ -z "$UP_CIDF" ] || rm -f "$UP_CIDF"
    if [ "$UP_LOCK_HELD" = 1 ] && [ -n "$UP_LOCK" ]; then rm -rf "$UP_LOCK"; fi
}

# The exit is explicit so the EXIT trap runs and the status says which signal ended the call (128 + n).
up_traps() {
    trap up_cleanup EXIT
    trap 'exit 129' HUP
    trap 'exit 130' INT
    trap 'exit 143' TERM
}

# A pause that a trapped signal interrupts at once (a foreground `sleep` would delay the trap until it ends).
nap() {
    sleep "${SWARMBOX_TEST_NAP:-1}" &
    UP_BG=$!
    wait "$UP_BG" 2> /dev/null
    UP_BG=
}

ensure_state_dir() {
    private_dir "$STATE_DIR" || die 4 "cannot create $STATE_DIR."
    UP_ERRF=$STATE_DIR/err.$$
    rm -f "$UP_ERRF"   # SR-02: a symlink planted at the predictable name is deleted, never written through
}

need_podman() {
    command -v podman > /dev/null 2>&1 && return 0
    warn "Podman is not installed."
    printf '%s\n' "  Linux: sudo apt install podman (Debian/Ubuntu) or sudo dnf install podman (Fedora/RHEL)" "  macOS: brew install podman" >&2
    exit 3
}

# Podman 4.3 or newer (3.8). Compared as numbers, so 4.10 is newer than 4.3. An unreadable version is a warning: the box may work.
check_podman_version() {
    u_v=$(podman version --format '{{.Client.Version}}' 2> /dev/null) || u_v=
    case $u_v in
        [0-9]*.[0-9]*) ;;
        *) warn "could not read the Podman version ('$u_v'); continuing."; return 0 ;;
    esac
    u_maj=${u_v%%.*}
    u_min=${u_v#*.}
    u_min=${u_min%%[!0-9]*}
    case $u_maj$u_min in
        *[!0-9]*|'') warn "could not read the Podman version ('$u_v'); continuing."; return 0 ;;
    esac
    if [ "$u_maj" -lt 4 ] || { [ "$u_maj" -eq 4 ] && [ "$u_min" -lt 3 ]; }; then
        die 3 "Podman $u_maj.$u_min found, 4.3 or newer is required. Upgrade Podman and try again."
    fi
}

# /dev/net/tun on Linux and WSL (on macOS `serve` checks inside the Podman machine). SWARMBOX_TEST_TUN names the file that stands
# for it in tests; SWARMBOX_TEST_NO_NESTED=1 skips the check together with the flags that need it.
check_tun() {
    u_os=${SWARMBOX_TEST_OS:-$(uname -s)}
    [ "$u_os" != Darwin ] || return 0
    [ "${SWARMBOX_TEST_NO_NESTED:-}" != 1 ] || return 0
    [ -e "${SWARMBOX_TEST_TUN:-/dev/net/tun}" ] && return 0
    die 3 "/dev/net/tun is missing on this host. Nested Podman needs it. On Linux try: sudo modprobe tun"
}

# The last lines of Podman's error, indented, on standard error.
show_err() { tail -n "${2:-3}" "$1" 2> /dev/null | sed 's/^/    /' >&2; }

# A missing image is pulled, never built (3.8).
ensure_image() {
    podman image exists "$C_IMAGE" > /dev/null 2>&1 && return 0
    warn "pulling $C_IMAGE (this can take a while)..."
    if ! podman pull -q "$C_IMAGE" > /dev/null 2> "$UP_ERRF"; then
        u_m=$(tail -n 1 "$UP_ERRF" 2> /dev/null)
        die 3 "cannot pull $C_IMAGE: $u_m. Check the network, or set SWARMBOX_IMAGE to an image you already have."
    fi
}

# What `podman container inspect --format` is asked for: state|name|image id|--init|managed|image|ports|env-hash|fingerprint|workspace.
# The workspace is last because a path may contain '|'. Labels come through `index`, which gives "" for a missing one.
LOOKUP_FORMAT='{{.State.Status}}|{{.Name}}|{{.Image}}|{{.HostConfig.Init}}|{{index .Config.Labels "swarmbox.managed"}}|{{index .Config.Labels "swarmbox.image"}}|{{index .Config.Labels "swarmbox.ports"}}|{{index .Config.Labels "swarmbox.env-hash"}}|{{index .Config.Labels "swarmbox.fingerprint"}}|{{index .Config.Labels "swarmbox.workspace"}}'

# One Podman call. Sets BX_FOUND (1 only when the printed name is exactly the box's: Podman also resolves ID prefixes) and BX_*.
find_box() {
    BX_FOUND=0
    if ! u_o=$(podman container inspect --format "$LOOKUP_FORMAT" "$BOX" 2> "$UP_ERRF"); then
        if grep -qi 'no such container' "$UP_ERRF" 2> /dev/null; then return 0; fi
        warn "podman could not look for the box '$BOX':"
        show_err "$UP_ERRF"
        exit 3
    fi
    u_r=$u_o
    BX_STATE=${u_r%%|*}; u_r=${u_r#*|}
    BX_NAME=${u_r%%|*}; u_r=${u_r#*|}
    BX_IMGID=${u_r%%|*}; u_r=${u_r#*|}
    BX_INIT=${u_r%%|*}; u_r=${u_r#*|}
    BX_MANAGED=${u_r%%|*}; u_r=${u_r#*|}
    BX_IMGREF=${u_r%%|*}; u_r=${u_r#*|}
    BX_PUBPORTS=${u_r%%|*}; u_r=${u_r#*|}
    BX_ENVHASH=${u_r%%|*}; u_r=${u_r#*|}
    BX_FP=${u_r%%|*}; u_r=${u_r#*|}
    BX_WS=$u_r
    [ "$BX_NAME" = "$BOX" ] || return 0
    BX_FOUND=1
}

# A container with the box's name and no swarmbox.managed label is v0.1.0's: never adopted, started or removed (3.8).
# shellcheck disable=SC2016  # the backticks in the message are literal
refuse_v010() {
    u_w=$(podman container inspect --format '{{range .Mounts}}{{if eq .Destination "/home/agent"}}{{.Source}}{{end}}{{end}}' "$BOX" 2> /dev/null) || u_w=
    [ -n "$u_w" ] || u_w=unknown
    warn "A container named '$BOX' made by SwarmBox v0.1.0 exists (workspace: $u_w). Stop and remove it with \`podman rm -f $BOX\`; your files stay in that folder. Then run \`swarmbox config set WORKSPACE $u_w\` (or, on a fresh install before the first \`swarmbox\` call, \`init --workspace $u_w\`) to keep using it."
    exit 5
}

# Another box with the label swarmbox.workspace equal to this path (3.5). The label filter matches the whole value.
check_workspace_conflict() {
    u_o=$(podman ps -a --filter "label=swarmbox.workspace=$C_WORKSPACE" --format '{{.Names}}' 2> /dev/null) || u_o=
    while IFS= read -r u_n; do
        [ -n "$u_n" ] || continue
        [ "$u_n" = "$BOX" ] || die 5 "workspace $C_WORKSPACE is already used by box '$u_n'."
    done <<CEOF
$u_o
CEOF
}

# INIT=auto becomes 0 or 1 by a throwaway `podman run --rm --init` of the image (the probe v0.1.0 used, kept; B9). INIT_RESOLVED.
resolve_init() {
    case $C_INIT in
        0|1) INIT_RESOLVED=$C_INIT; return 0 ;;
    esac
    if podman run --rm --init --name "$BOX-init-probe-$$" --entrypoint true "$C_IMAGE" > /dev/null 2>&1; then
        INIT_RESOLVED=1
    else
        INIT_RESOLVED=0
        warn "podman cannot run --init here (is catatonit installed?): exited processes will not be reaped."
    fi
}

# The flags of the new box, captured into a file BEFORE `podman run` and the status of create-flags checked (3.6): a helper
# failure (4 workspace, 3 missing tool-ports) never reaches Podman. create-flags runs in the background and is waited for, so a
# signal ends this call at once. SWARMBOX_TEST_CREATE_FLAGS replaces the program, for tests.
capture_flags() {
    UP_FLAGS=$STATE_DIR/flags.$$
    rm -f "$UP_FLAGS"   # SR-02
    u_prog=${SWARMBOX_TEST_CREATE_FLAGS:-}
    if [ -z "$u_prog" ]; then
        u_sd=$(self_dir) || die 3 "cannot find the folder of the host helper."
        u_prog=$u_sd/${0##*/}
    fi
    SWARMBOX_INIT=$INIT_RESOLVED "$u_prog" create-flags > "$UP_FLAGS" &
    UP_BG=$!
    u_rc=0
    wait "$UP_BG" || u_rc=$?
    UP_BG=
    [ "$u_rc" -eq 0 ] || exit "$u_rc"
}

# Everything that can fail before the box is touched: Podman version, tun, the image, the workspace conflict, INIT, the flags.
prepare_create() {
    check_podman_version
    check_tun
    ensure_image
    check_workspace_conflict
    resolve_init
    capture_flags
}

# `podman run -d --name --cidfile <fresh path> <flags> <image> serve`. On failure only the container named by the cidfile is
# removed, by its ID; a container that merely has the name is never removed (B18; podman exits 125 with no cidfile then).
# shellcheck disable=SC2016  # the backticks in the message are literal
create_box() {
    set --
    while IFS= read -r u_l; do set -- "$@" "$u_l"; done < "$UP_FLAGS"
    rm -f "$UP_FLAGS"
    UP_FLAGS=
    # The mount point of the nested-Podman volume (<workspace>/.local/share/containers) is made here, as the user. If Podman made
    # it, it would also make .local and .local/share, owned by the container's root (not by the user), and `serve` could not
    # create its folders under them (found by the real smoke test of slice 3.3).
    (umask 022 && mkdir -p "$C_WORKSPACE/.local/share/containers") 2> /dev/null ||
        die 4 "cannot create $C_WORKSPACE/.local/share/containers (the mount point of the nested Podman storage)."
    UP_CIDF=$STATE_DIR/cid.$$
    rm -f "$UP_CIDF"
    if podman run -d --name "$BOX" --cidfile "$UP_CIDF" "$@" "$C_IMAGE" serve > /dev/null 2> "$UP_ERRF"; then
        rm -f "$UP_CIDF"
        UP_CIDF=
        return 0
    fi
    u_id=
    if [ -s "$UP_CIDF" ]; then IFS= read -r u_id < "$UP_CIDF" || true; fi
    case $u_id in
        ''|*[!0-9a-f]*) ;;
        *) podman rm -f "$u_id" > /dev/null 2>&1 || true ;;
    esac
    rm -f "$UP_CIDF"
    UP_CIDF=
    warn "could not create the box:"
    show_err "$UP_ERRF"
    die 7 "If a port is in use, change WEB_PORT or PORTS with \`swarmbox config set\`."
}

start_box() {
    if ! podman start "$BOX" > /dev/null 2> "$UP_ERRF"; then
        warn "could not start the box:"
        show_err "$UP_ERRF"
        die 7 "Nothing was changed; the box '$BOX' is still there. If a port is in use, change WEB_PORT or PORTS and run \`swarmbox reset\`."
    fi
}

# Polls the marker with `podman exec` and, only when that fails, the container state: a box that has exited stops the wait at
# once (exit 6, with the log), instead of hiding the cause behind the timeout (4.2).
# shellcheck disable=SC2016  # the backticks in the messages are literal
wait_ready() {
    u_tries=${SWARMBOX_TEST_READY_TRIES:-60}
    u_nap=${SWARMBOX_TEST_NAP:-1}
    u_i=0
    while :; do
        u_i=$((u_i + 1))
        if u_m=$(podman exec "$BOX" cat /tmp/swarmbox/ready 2> /dev/null); then
            case $u_m in
                warnings=*) warn "the box is ready, with ${u_m#warnings=} warning(s); the banner shows them." ;;
            esac
            return 0
        fi
        u_st=$(podman container inspect --format '{{.State.Status}}' "$BOX" 2> /dev/null) || u_st=gone
        case $u_st in
            running|created|configured|initialized|paused) ;;
            *)
                warn "the box exited while starting (state: $u_st); the last lines of its log:"
                podman logs --tail 20 "$BOX" 2>&1 | sed 's/^/    /' >&2
                exit 6
                ;;
        esac
        if [ "$u_i" -ge "$u_tries" ]; then
            if [ "$u_nap" = 1 ]; then
                die 6 "the box did not become ready in $u_tries s; see \`podman logs $BOX\`"
            fi
            die 6 "the box did not become ready in $u_tries polls of $u_nap s; see \`podman logs $BOX\`"
        fi
        nap
    done
}

# The warnings of an entry (D30): the fingerprint differences, named per key where a label allows it, and a local image that was
# replaced since the box was created. They never block. The box's INIT is what it was created with when the config says auto.
entry_warnings() {
    if [ -n "$BX_FP" ]; then
        if [ "$C_INIT" = auto ]; then
            case $BX_INIT in
                true) C_INIT=1 ;;
                *) C_INIT=0 ;;
            esac
        fi
        compute_fingerprint
        if [ "$BX_FP" != "$FP" ]; then
            LABELS="swarmbox.image=$BX_IMGREF${NL}swarmbox.workspace=$BX_WS${NL}swarmbox.ports=$BX_PUBPORTS${NL}swarmbox.env-hash=$BX_ENVHASH${NL}"
            u_ex=$(fp_explain)
            while IFS= read -r u_x; do
                [ -z "$u_x" ] || warn "$u_x"
            done <<WEOF
$u_ex
WEOF
        fi
    fi
    u_ref=${BX_IMGREF:-$C_IMAGE}
    u_cur=$(podman image inspect --format '{{.Id}}' "$u_ref" 2> /dev/null) || u_cur=
    u_cur=${u_cur#sha256:}
    u_old=${BX_IMGID#sha256:}
    if [ -n "$u_cur" ] && [ -n "$u_old" ] && [ "$u_cur" != "$u_old" ]; then
        warn "the image $u_ref is newer than the one this box runs; run \`swarmbox reset\` to use it (running sessions end)."
    fi
}

# A stale lock is removed only after the folder has been moved away (an atomic rename) and its pid file, read again, is still the
# one that was seen dead (or still absent): a live lock that another call made in between is put back.
reap_stale() {
    u_rs=$UP_LOCK.stale.$$
    mv "$UP_LOCK" "$u_rs" 2> /dev/null || return 0
    u_q=
    if [ -r "$u_rs/pid" ]; then IFS= read -r u_q < "$u_rs/pid" || true; fi
    if [ "$u_q" = "$1" ]; then
        rm -rf "$u_rs"
    else
        mv "$u_rs" "$UP_LOCK" 2> /dev/null || true
    fi
}

# The host lock of 3.6: an atomic mkdir, with the pid of the holder in a file. Stale when that pid does not answer `kill -0`, or
# when no pid file appeared within LOCK_PIDWAIT polls (5 s); a live holder is waited for up to LOCK_TRIES polls (90 s), then exit 6.
acquire_lock() {
    UP_LOCK=$STATE_DIR/up-$BOX.lock
    u_tries=${SWARMBOX_TEST_LOCK_TRIES:-90}
    u_pidwait=${SWARMBOX_TEST_LOCK_PIDWAIT:-5}
    u_n=0
    u_nopid=0
    u_fail=0
    until mkdir "$UP_LOCK" 2> /dev/null; do
        if [ ! -d "$UP_LOCK" ]; then   # not there and not creatable: a permission problem (or the holder just left)
            u_fail=$((u_fail + 1))
            [ "$u_fail" -le 5 ] || die 4 "cannot create the lock $UP_LOCK."
            continue
        fi
        u_p=
        if [ -r "$UP_LOCK/pid" ]; then IFS= read -r u_p < "$UP_LOCK/pid" || true; fi
        case $u_p in
            *[!0-9]*) u_p= ;;
        esac
        if [ -n "$u_p" ]; then
            u_nopid=0
            if ! kill -0 "$u_p" 2> /dev/null; then
                reap_stale "$u_p"
                continue
            fi
        else
            u_nopid=$((u_nopid + 1))
            if [ "$u_nopid" -gt "$u_pidwait" ]; then
                reap_stale ""
                u_nopid=0
                continue
            fi
        fi
        u_n=$((u_n + 1))
        if [ "$u_n" -gt "$u_tries" ]; then
            die 6 "another 'up' holds $UP_LOCK (pid ${u_p:-unknown}); if no swarmbox command is running, remove that folder."
        fi
        nap
    done
    UP_LOCK_HELD=1
    printf '%s\n' "$$" > "$UP_LOCK/pid"
    sweep_state
}

# Temporary files (flags.<pid>, cid.<pid>, err.<pid>) that a call killed with SIGKILL left behind: removed when the pid in the
# name is gone. Only done under the lock, so a live call of this box is never disturbed (another box's files are not touched
# either: a pid that answers is left alone).
sweep_state() {
    for u_f in "$STATE_DIR"/flags.* "$STATE_DIR"/cid.* "$STATE_DIR"/err.* "$STATE_DIR"/up-"$BOX".lock.stale.*; do
        [ -e "$u_f" ] || continue
        u_pid=${u_f##*.}
        case $u_pid in
            ''|*[!0-9]*) continue ;;
        esac
        [ "$u_pid" != "$$" ] || continue
        kill -0 "$u_pid" 2> /dev/null || rm -rf "$u_f"
    done
}

# ---------------------------------------------------------------- the host connection `podman -c <name>` (3.5, 3.7.2 step 6, 12.4)

SOCK_LIMIT=100   # characters of path counted in bytes: the AF_UNIX limit is 107, minus a margin for macOS and the BSDs (104) (B5)

byte_len() { printf '%s' "$1" | wc -c | tr -d ' \t'; }   # wc -c counts bytes, whatever the locale

# The path the connection will use for the workspace $1: SOCK_PATH (what is registered), SOCK_TARGET (the workspace state
# folder) and SOCK_LINK (the symlink, empty when the direct path is short enough). No side effect.
# shellcheck disable=SC2016  # the backticks in the message are literal
sock_plan() {
    SOCK_TARGET=$1/.local/state/swarmbox
    SOCK_PATH=$SOCK_TARGET/podman.sock
    SOCK_LINK=
    [ "$(byte_len "$SOCK_PATH")" -gt "$SOCK_LIMIT" ] || return 0
    SOCK_LINK=$STATE_DIR/$BOX.sock-dir
    SOCK_PATH=$SOCK_LINK/podman.sock
    [ "$(byte_len "$SOCK_PATH")" -le "$SOCK_LIMIT" ] || die 4 "cannot make a short path to the Podman socket (workspace $1 is too deep). Choose a shorter workspace path with \`swarmbox config set WORKSPACE\`."
}

# Create or refresh the symlink: a correct link stays, a wrong target is relinked, anything that is not a symlink is refused
# (exit 4) and left in place.
sock_link() {
    [ -n "$SOCK_LINK" ] || return 0
    if [ -L "$SOCK_LINK" ]; then
        [ "$(readlink "$SOCK_LINK")" != "$SOCK_TARGET" ] || return 0
        rm -f "$SOCK_LINK" || die 4 "cannot replace the symlink $SOCK_LINK."
    elif [ -e "$SOCK_LINK" ]; then
        die 4 "cannot make a short path to the Podman socket: $SOCK_LINK exists and is not a symlink. Move it away."
    fi
    ln -s "$SOCK_TARGET" "$SOCK_LINK" || die 4 "cannot make the symlink $SOCK_LINK."
}

# Register the connection named like the box (only that name is ever read, replaced or removed). Idempotent: one `list`, and
# `remove` + `add` only when the address differs (this also moves the v0.1.0 address <workspace>/.swarmbox/podman.sock). A
# failure to register is a warning, never an exit: the box works without the host connection.
sock_register() {
    sr_uri=unix://$SOCK_PATH
    if ! sr_out=$(podman system connection list --format '{{.Name}} {{.URI}}' 2> /dev/null); then
        warn "could not list the Podman connections; 'podman -c $BOX' was not registered."
        return 0
    fi
    sr_cur=$(printf '%s\n' "$sr_out" | awk -v n="$BOX" 'index($0, n " ") == 1 { print substr($0, length(n) + 2); exit }')
    [ "$sr_cur" != "$sr_uri" ] || return 0
    if [ -n "$sr_cur" ]; then
        podman system connection remove "$BOX" > /dev/null 2>&1 || true
    fi
    podman system connection add "$BOX" "$sr_uri" > /dev/null 2>&1 || warn "could not register the Podman connection '$BOX'."
    return 0
}

# Linux and WSL only: unix sockets do not cross the macOS VM [unverified: no macOS here].
host_connection_wanted() { [ "${SWARMBOX_TEST_OS:-$(uname -s)}" != Darwin ]; }

# Before a box is created: the exit 4 for a workspace too deep comes before anything is made.
host_connection_prepare() {
    host_connection_wanted || return 0
    sock_plan "$1"
    sock_link
}

host_connection() {
    host_connection_wanted || return 0
    sock_plan "$1"
    sock_link
    sock_register
}

# `swarmbox-host connection`: the same step on its own (no lock, no box); prints the registered URI.
cmd_connection() {
    [ $# -eq 0 ] || usage
    need_podman
    load_creation 0
    host_connection_wanted || return 0
    private_dir "$STATE_DIR" || die 4 "cannot create $STATE_DIR."
    host_connection "$C_WORKSPACE"
    printf 'unix://%s\n' "$SOCK_PATH"
}

# up (RESET=0) and reset (RESET=1), 3.7.2 "What up does" and "What reset does".
up_main() {
    RESET=$1
    need_podman
    need_sha256
    load_tool_ports
    WARN_PORTS=0
    load_creation 0
    ensure_state_dir
    up_traps
    acquire_lock
    find_box
    if [ "$BX_FOUND" = 1 ]; then
        [ -n "$BX_MANAGED" ] || refuse_v010
        if [ "$RESET" = 1 ]; then
            host_connection_prepare "$C_WORKSPACE"
            prepare_create
            podman rm -f "$BOX" > /dev/null 2> "$UP_ERRF" || {
                warn "could not remove the box '$BOX':"
                show_err "$UP_ERRF"
                exit 1
            }
            create_box
            wait_ready
            return 0
        fi
        entry_warnings
        [ "$BX_STATE" != running ] || return 0   # the fast path: one inspect, and at most one image inspect
        check_podman_version
        check_tun
        start_box
        wait_ready
        return 0
    fi
    host_connection_prepare "$C_WORKSPACE"
    prepare_create
    create_box
    wait_ready
}

# ---------------------------------------------------------------- the Cloudflare connector on every entry (5.2, slice 5.4)

# Pinned (12.3). The single source in the helper; tests/test_host_connector.py checks that it equals DEFAULT_CONNECTOR_IMAGE of
# cloudflare-setup.py. SWARMBOX_CLOUDFLARED_IMAGE overrides it (environment only: the config table of 8.2 has no file key).
CONNECTOR_NAME=swarmbox-cloudflared
CONNECTOR_IMAGE_DEFAULT=docker.io/cloudflare/cloudflared:2026.10.7

# After `up`, under the lock, when the box is ready. Does nothing (no Podman call at all) unless WEB is 1 and a tunnel token
# resolves (environment, or the config key with mode 600). One connector per host: the name is fixed, whatever the box name
# (a second box adds an ingress hostname to the same tunnel, 5.2). The token only goes through the environment of
# `podman run` (`-e TUNNEL_TOKEN`), never an argument. Every failure is a warning: the box works without the connector and the
# exit code of `up` stays what it was. Exact name: the printed name is compared, because Podman resolves ID prefixes.
connector_ensure() {
    [ "$C_WEB" = 1 ] || return 0
    resolve_tunnel_token || return 0
    cn_img=${SWARMBOX_CLOUDFLARED_IMAGE:-$CONNECTOR_IMAGE_DEFAULT}
    if ! valid_image_ref "$cn_img"; then
        warn "SWARMBOX_CLOUDFLARED_IMAGE is not an image reference (letters, digits and '.', '_', '/', ':', '@', '-' only, not starting with '-'); the connector was not started."
        return 0
    fi
    cn_state=missing
    if cn_o=$(podman container inspect --format '{{.Name}}|{{.State.Running}}|{{range .Config.Env}}{{println .}}{{end}}' "$CONNECTOR_NAME" 2> "$UP_ERRF"); then
        cn_n=${cn_o%%|*}
        if [ "$cn_n" = "$CONNECTOR_NAME" ]; then
            cn_r=${cn_o#*|}
            cn_run=${cn_r%%|*}
            cn_env=${cn_r#*|}
            cn_state=stopped
            case "$NL$cn_env$NL" in
                *"${NL}TUNNEL_TOKEN=$TUNNEL_TOKEN${NL}"*)
                    [ "$cn_run" != true ] || return 0   # the fast path: one inspect
                    cn_state=same-stopped ;;
            esac
        fi
    elif ! grep -qi 'no such container' "$UP_ERRF" 2> /dev/null; then
        warn "podman could not look for the connector '$CONNECTOR_NAME'; it was not started:"
        show_err "$UP_ERRF"
        return 0
    fi
    if [ "$cn_state" = same-stopped ]; then
        if podman start "$CONNECTOR_NAME" > /dev/null 2> "$UP_ERRF"; then return 0; fi
        warn "could not start the connector '$CONNECTOR_NAME':"
        show_err "$UP_ERRF"
        return 0
    fi
    if [ "$cn_state" = stopped ]; then   # another token: recreate
        if ! podman rm -f "$CONNECTOR_NAME" > /dev/null 2> "$UP_ERRF"; then
            warn "could not remove the old connector '$CONNECTOR_NAME':"
            show_err "$UP_ERRF"
            return 0
        fi
    fi
    # --user root: in rootless Podman that is only your own user; it avoids needing the image's own user (65532) to be mappable.
    if ! TUNNEL_TOKEN=$TUNNEL_TOKEN podman run -d --name "$CONNECTOR_NAME" --restart=always --network=host --user root \
        -e TUNNEL_TOKEN "$cn_img" tunnel --no-autoupdate run > /dev/null 2> "$UP_ERRF"; then
        warn "could not start the connector '$CONNECTOR_NAME' (the box is running; 'swarmbox remote status' shows the rest):"
        show_err "$UP_ERRF"
    fi
    return 0
}

# Step 6 runs under the lock, after the box is ready (up_main exits on every failure before it); the workspace is the box's own.
cmd_up() {
    [ $# -eq 0 ] || usage
    up_main 0
    host_connection "${BX_WS:-$C_WORKSPACE}"
    connector_ensure
}

cmd_reset() {
    [ $# -eq 0 ] || usage
    up_main 1
    host_connection "$C_WORKSPACE"
}

# shellcheck disable=SC2016  # the backticks in the message are literal
cmd_stop() {
    [ $# -eq 0 ] || usage
    need_podman
    init_paths
    ensure_state_dir
    up_traps
    find_box
    if [ "$BX_FOUND" = 0 ]; then
        warn "no box named '$BOX'; nothing to stop."
        return 0
    fi
    [ -n "$BX_MANAGED" ] || refuse_v010
    if ! podman stop "$BOX" > /dev/null 2> "$UP_ERRF"; then
        warn "could not stop the box '$BOX':"
        show_err "$UP_ERRF"
        exit 1
    fi
}

# ---------------------------------------------------------------- update (3.8 "Update flow", D17, D27, D33, D35)

# A tag as Podman reads it: letters, digits, '_', '.', '-', at most 128 characters, not starting with '.' or '-'.
valid_tag() {
    case $1 in
        ''|[!A-Za-z0-9_]*|*[!A-Za-z0-9_.-]*) return 1 ;;
    esac
    [ "$(byte_len "$1")" -le 128 ]
}

# Splits an image reference into IR_REPO, IR_TAG (empty when there is none) and IR_DIGEST (1 when it carries @sha256:...). The
# colon of a registry port is not a tag separator: a tag is a ':' in the last path component only.
split_image() {
    IR_DIGEST=0
    _ref=$1
    case $_ref in
        *@*) IR_DIGEST=1; _ref=${_ref%%@*} ;;
    esac
    _last=${_ref##*/}
    case $_last in
        *:*) IR_TAG=${_last#*:}; IR_REPO=${_ref%":$IR_TAG"} ;;
        *) IR_TAG=; IR_REPO=$_ref ;;
    esac
}

# The series (X.Y) of a tag that starts with two numbers: 2.0.1 gives 2.0, 2.1 gives 2.1, 3.4.5-rc1 gives 3.4.
series_of() {
    case $1 in
        [0-9]*.[0-9]*) ;;
        *) return 1 ;;
    esac
    _x=${1%%.*}
    _rest=${1#*.}
    _y=${_rest%%[!0-9]*}
    case $_x$_y in *[!0-9]*|'') return 1 ;; esac
    case $_x in *[!0-9]*) return 1 ;; esac
    # the character after the minor number must end the tag or start the patch or a suffix
    _after=${_rest#"$_y"}
    case $_after in ''|.*|-*) ;; *) return 1 ;; esac
    SERIES=$_x.$_y
}

# archive_safe FILE: refuses a helper archive that has an absolute member name, a '..' component, or a member that is not a plain
# file or folder (a symlink, a hard link, a device): extraction then cannot write outside the temporary folder and cannot leave a
# link behind, whatever the local tar does by default (security review SR-05). Member names are listed twice (names, then types).
archive_safe() {
    _an=$(tar -tf "$1" 2> /dev/null) || return 1
    case "$NL$_an$NL" in
        *"$NL/"*|*"$NL../"*|*"/../"*|*"/.."$NL*|*"$NL.."$NL*) return 1 ;;
    esac
    _av=$(tar -tvf "$1" 2> /dev/null) || return 1
    while IFS= read -r _al; do
        case $_al in
            *' link to '*) return 1 ;;   # a hard link as bsdtar lists it
            -*|d*|'') ;;
            *) return 1 ;;
        esac
    done <<AEOF
$_av
AEOF
    return 0
}

# update [--to TAG]. The order differs from the design text in one way (decision [3.6]): the helper is extracted and its version
# read into a temporary folder, the local tag is made, and only then the folder is renamed over the old helper and the config
# written, so a failing `podman tag` leaves the helper as it was as well as the config.
# shellcheck disable=SC2016  # the backticks in the messages are literal
cmd_update() {
    up_to=
    up_to_set=0
    while [ $# -gt 0 ]; do
        case $1 in
            --to)
                [ $# -ge 2 ] || { warn "update: --to needs a tag."; usage; }
                [ "$up_to_set" = 0 ] || usage
                up_to=$2; up_to_set=1; shift 2 ;;
            --to=*)
                [ "$up_to_set" = 0 ] || usage
                up_to=${1#--to=}; up_to_set=1; shift ;;
            *) usage ;;
        esac
    done
    if [ "$up_to_set" = 1 ]; then
        valid_tag "$up_to" || die 2 "update: invalid tag '$up_to': a tag uses letters, digits, '_', '.' and '-' (at most 128, not starting with '.' or '-')."
    fi
    init_paths
    cfg_prepare
    resolve IMAGE
    up_cur=$R_VAL
    up_src=$R_SRC
    if [ "$up_src" != default ]; then
        validate_value IMAGE "$up_cur" || exit 2
        up_cur=$V_OUT
    fi
    split_image "$up_cur"
    up_repo=$IR_REPO
    if [ "$up_to_set" = 1 ]; then
        up_tag=$up_to
    else
        [ "$IR_DIGEST" = 0 ] || die 2 "IMAGE ($up_cur) is pinned by a digest, so there is no series to follow. Use \`swarmbox update --to TAG\`."
        series_of "$IR_TAG" || die 2 "IMAGE ($up_cur) has no X.Y version tag, so there is no series to follow. Use \`swarmbox update --to TAG\`."
        up_tag=$SERIES
    fi
    up_ref=$up_repo:$up_tag
    need_podman
    ensure_state_dir
    up_traps
    warn "pulling $up_ref (this can take a while)..."
    if ! podman pull -q "$up_ref" > /dev/null 2> "$UP_ERRF"; then
        up_m=$(tail -n 1 "$UP_ERRF" 2> /dev/null)
        die 3 "cannot pull $up_ref: ${up_m:-podman failed}. Nothing was changed. Check the network and the tag."
    fi
    up_data=$(xdg_root "${XDG_DATA_HOME:-}" "$HOME/.local/share")/swarmbox
    up_dir=$up_data/host
    private_dir "$up_data" || die 3 "cannot make $up_data."
    up_tmp=$(mktemp -d "$up_dir.new.XXXXXX" 2> /dev/null) || up_tmp=
    if [ -z "$up_tmp" ] || [ ! -d "$up_tmp" ]; then die 3 "cannot make a temporary folder next to $up_dir."; fi
    UP_TMPDIR=$up_tmp
    trap 'up_update_cleanup' EXIT
    up_msg=
    if podman run --rm "$up_ref" host-helper > "$up_tmp/helper.tar" 2> "$UP_ERRF"; then
        if archive_safe "$up_tmp/helper.tar" && tar -x -C "$up_tmp" -f "$up_tmp/helper.tar" > /dev/null 2>&1 && [ -x "$up_tmp/swarmbox-host" ]; then
            up_msg=
        else
            up_msg="the image has no usable host helper"
        fi
    else
        up_msg=$(tail -n 1 "$UP_ERRF" 2> /dev/null)
        up_msg=${up_msg:-"podman failed"}
    fi
    [ -z "$up_msg" ] || die 3 "cannot read the host helper from $up_ref: $up_msg. Nothing was changed."
    rm -f "$up_tmp/helper.tar"
    up_ver=$("$up_tmp/swarmbox-host" version 2> /dev/null | head -n 1)
    case $up_ver in
        *[!0-9A-Za-z.+-]*) up_ver= ;;
        [0-9]*.[0-9]*.[0-9]*) ;;
        *) up_ver= ;;
    esac
    [ -n "$up_ver" ] || die 3 "the host helper in $up_ref does not report a version (X.Y.Z). Nothing was changed."
    case $up_tag in
        [0-9]*.[0-9]*.[0-9]*)   # an exact tag must be the version it holds, or the local tag would lie
            [ "$up_ver" = "$up_tag" ] || die 3 "the image $up_ref holds version $up_ver, not $up_tag. Nothing was changed."
            ;;
    esac
    if [ "$up_ver" != "$up_tag" ]; then
        if ! podman tag "$up_ref" "$up_repo:$up_ver" > /dev/null 2> "$UP_ERRF"; then
            up_m=$(tail -n 1 "$UP_ERRF" 2> /dev/null)
            die 3 "cannot tag $up_ref as $up_repo:$up_ver: ${up_m:-podman failed}. Nothing was changed."
        fi
    fi
    rm -rf "$up_dir.old"
    if [ -e "$up_dir" ] || [ -L "$up_dir" ]; then
        mv "$up_dir" "$up_dir.old" || die 3 "cannot replace the helper in $up_dir."
    fi
    if ! mv "$up_tmp" "$up_dir"; then
        mv "$up_dir.old" "$up_dir" 2> /dev/null
        die 3 "cannot replace the helper in $up_dir."
    fi
    UP_TMPDIR=
    rm -rf "$up_dir.old"
    cfg_write_keys IMAGE "$up_repo:$up_ver"
    if [ "$up_src" = env ]; then
        warn "SWARMBOX_IMAGE is set ($up_cur) and overrides the IMAGE written to $CFG_FILE."
    fi
    printf 'updated to %s; run `swarmbox reset` to use it (running sessions end)\n' "$up_ver"
}

UP_TMPDIR=
up_update_cleanup() {
    [ -z "$UP_TMPDIR" ] || rm -rf "$UP_TMPDIR"
    up_cleanup
}

# A hostname for the public URL: letters, digits, dots and hyphens only (it ends up in a URL that is printed).
valid_public_host() {
    case $1 in
        ''|[!A-Za-z0-9]*|*[!A-Za-z0-9.-]*) return 1 ;;
    esac
    return 0
}

# One string value of the script's cloudflare.json (indented JSON, one key per line), read with sed; first match, no JSON parser.
url_json_key() {
    sed -n 's/^[[:space:]]*"'"$1"'"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' "$CFG_ROOT/cloudflare.json" 2> /dev/null | head -n 1
}

# The public host name `url` and `remote status` print (empty: none configured): SWARMBOX_WEB_HOSTNAME, else the host name the
# script saved for this box, else <name>.<domain>. Sets u_host. No Podman.
public_host() {
    u_host=${SWARMBOX_WEB_HOSTNAME:-}
    if [ -z "$u_host" ]; then
        u_dom=${SWARMBOX_WEB_DOMAIN:-}
        u_saved=
        u_sname=
        u_sdom=
        if [ -r "$CFG_ROOT/cloudflare.json" ]; then
            u_sdom=$(url_json_key domain)
            u_saved=$(url_json_key hostname)
            u_sname=$(url_json_key name)
        fi
        [ -n "$u_dom" ] || u_dom=$u_sdom
        u_dom=${u_dom%.}
        if [ -n "$u_dom" ]; then
            if valid_public_host "$u_dom"; then
                u_host=$BOX.$u_dom
                # the name the script saved for this box (--hostname) wins over <name>.<domain>, inside the same domain only
                if [ -n "$u_saved" ] && [ "$u_sname" = "$BOX" ]; then
                    if ! valid_public_host "$u_saved"; then
                        warn "ignoring the saved host name '$u_saved' (not a host name)."
                    else
                        case $u_saved in
                            "$u_dom"|*."$u_dom") u_host=$u_saved ;;
                        esac
                    fi
                fi
            else
                warn "ignoring the domain '$u_dom' (not a host name)."
            fi
        fi
    elif ! valid_public_host "$u_host"; then
        warn "ignoring the host name '$u_host' (not a host name)."
        u_host=
    fi
    return 0
}

# url: the local URL, and the public one when remote access is configured. It never calls Podman (5.2).
cmd_url() {
    [ $# -eq 0 ] || usage
    init_paths
    cfg_prepare
    for u_k in WEB WEB_PORT; do
        resolve "$u_k"
        u_val=$R_VAL
        if [ "$R_SRC" != default ]; then
            validate_value "$u_k" "$u_val" || exit 2
            u_val=$V_OUT
        fi
        eval "U_$u_k=\$u_val"
    done
    [ "$U_WEB" = 1 ] || die 1 "the web terminal is off (WEB=0), so there is no URL. Run \`swarmbox config set WEB 1\` and \`swarmbox reset\` to turn it on."
    printf 'http://127.0.0.1:%s\n' "$U_WEB_PORT"
    public_host
    [ -z "$u_host" ] || printf 'https://%s\n' "$u_host"
    return 0
}

# remote setup|status|off|token [options]: runs cloudflare-setup.py, which sits next to this program (the folder the shell
# function extracts the image's helper to, 3.7.1). setup is its `apply`, off is its `remove`. The user's options come last,
# so they win over the two defaults added here (--name from SWARMBOX_NAME, --port from WEB_PORT). XDG_CONFIG_HOME is set to
# the folder CFG_ROOT lives in, so the script's cloudflare.json is the file `url` reads. No secret travels on argv: the API token
# stays in the environment the script inherits; no command of the script reads the tunnel token (it asks the API for it), so
# SWARMBOX_CLOUDFLARE_TUNNEL_TOKEN is removed from the script's environment (decision [5.2]).
cmd_remote() {
    [ $# -ge 1 ] || usage
    r_sub=$1
    shift
    case $r_sub in
        setup) r_cmd=apply ;;
        status) r_cmd=status ;;
        off) r_cmd=remove ;;
        token) r_cmd=token ;;
        *) usage ;;
    esac
    command -v python3 > /dev/null 2>&1 || die 3 "python3 is needed for 'swarmbox remote' and was not found."
    init_paths
    cfg_prepare
    r_script=$(dirname "$0")/cloudflare-setup.py
    [ -r "$r_script" ] || die 3 "cloudflare-setup.py was not found next to the host helper ($r_script); run \`swarmbox update\` to extract it again."
    resolve WEB_PORT
    r_port=$R_VAL
    if [ "$R_SRC" != default ]; then
        validate_value WEB_PORT "$r_port" || exit 2
        r_port=$V_OUT
    fi
    XDG_CONFIG_HOME=${CFG_ROOT%/swarmbox}
    export XDG_CONFIG_HOME
    # asked before the variable is removed from the script's environment (setup only offers to store a token when none exists)
    r_have=0
    ! resolve_tunnel_token || r_have=1
    TUNNEL_TOKEN=
    unset SWARMBOX_CLOUDFLARE_TUNNEL_TOKEN
    if [ "$r_sub" = status ]; then
        r_rc=0
        python3 "$r_script" status --name "$BOX" --port "$r_port" "$@" || r_rc=$?
        [ "$r_rc" -eq 2 ] || remote_host_lines
        exit "$r_rc"
    fi
    if [ "$r_sub" != setup ]; then
        exec python3 "$r_script" "$r_cmd" --name "$BOX" --port "$r_port" "$@"
    fi
    r_dry=0
    for r_a in "$@"; do
        [ "$r_a" != --dry-run ] || r_dry=1
    done
    r_rc=0
    python3 "$r_script" "$r_cmd" --name "$BOX" --port "$r_port" "$@" || r_rc=$?
    if [ "$r_rc" -eq 0 ] && [ "$r_dry" = 0 ] && [ "$r_have" = 0 ] && [ -t 0 ] && [ -t 2 ]; then
        remote_token_epilogue "$r_script" "$r_port" "$@"
    fi
    exit "$r_rc"
}

# The host side of `remote status` (5.2): the public name, the connector and the login length. The script's status is read-only and
# needs the API token; these lines need neither. The connector is asked with one inspect of the exact name; a missing podman or any
# answer that is not "no such container" is "unknown", never an error (the exit code is the script's).
remote_host_lines() {
    public_host 2> /dev/null
    printf '\nOn this host:\n'
    if [ -n "$u_host" ]; then
        printf '  public address: https://%s\n' "$u_host"
    else
        printf '  public address: none configured\n'
    fi
    if command -v podman > /dev/null 2>&1; then
        h_rc=0
        h_o=$(podman container inspect --format '{{.Name}}|{{.State.Running}}' "$CONNECTOR_NAME" 2>&1) || h_rc=$?
        if [ "$h_rc" -eq 0 ]; then
            case $h_o in
                "$CONNECTOR_NAME|true") printf '  connector: running (container %s)\n' "$CONNECTOR_NAME" ;;
                "$CONNECTOR_NAME|false") printf '  connector: not running (container %s is stopped; run swarmbox up)\n' "$CONNECTOR_NAME" ;;
                *) printf '  connector: unknown (unexpected answer from podman)\n' ;;
            esac
        else
            case $h_o in
                *[Nn]o\ such\ container*) printf '  connector: not running (no container %s; run swarmbox up with the tunnel token set)\n' "$CONNECTOR_NAME" ;;
                *) printf '  connector: unknown (podman could not be asked)\n' ;;
            esac
        fi
    else
        printf '  connector: unknown (podman was not found)\n'
    fi
    h_s=
    [ ! -r "$CFG_ROOT/cloudflare.json" ] || h_s=$(url_json_key session)
    printf '  login session: %s\n' "${h_s:-not recorded (the default is applied at the next setup)}"
}

# After a successful `remote setup` on a terminal (and never with --dry-run): when no tunnel token is stored yet, say how to
# keep it on the host and OFFER to do it. Never automatic: the default answer is no (decision [5.3]). The token is fetched by
# the script's `token` command into a shell variable (stdout captured, the info line on stderr stays visible) and written
# by cfg_write_keys at mode 600; it is never on an argv, never echoed. Any failure here only prints a line: setup succeeded.
remote_token_epilogue() {
    e_script=$1
    e_port=$2
    shift 2
    {
        printf '\nTo let swarmbox bring the connector up on every entry without the Cloudflare API token, keep the tunnel token on this host:\n'
        printf '  swarmbox remote token                          (prints only the tunnel token)\n'
        printf '  swarmbox config set CLOUDFLARE_TUNNEL_TOKEN    (type or paste it; it is stored with mode 600)\n'
        printf 'Fetch it now and store it in %s? [y/N] ' "$CFG_FILE"
    } >&2
    e_ans=
    IFS= read -r e_ans || e_ans=
    case $e_ans in
        y|Y|yes|YES|Yes) ;;
        *) return 0 ;;
    esac
    e_tok=$(python3 "$e_script" token --name "$BOX" --port "$e_port" "$@") || e_tok=
    case $e_tok in
        '') warn "could not read the tunnel token; nothing was stored. Run the two commands above when you are ready."; return 0 ;;
    esac
    if validate_value CLOUDFLARE_TUNNEL_TOKEN "$e_tok"; then
        e_stored=$V_OUT
        e_tok=
        ( cfg_write_keys CLOUDFLARE_TUNNEL_TOKEN "$e_stored" ) || { e_stored=; return 0; }
        e_stored=
        warn "the tunnel token is stored in $CFG_FILE (mode 600); \`swarmbox config list\` shows it only as set."
    else
        e_tok=
        warn "the tunnel token has an unexpected form; nothing was stored."
    fi
    return 0
}

cmd_config() {
    [ $# -ge 1 ] || usage
    _sub=$1
    shift
    case $_sub in
        get) cmd_config_get "$@" ;;
        set) cmd_config_set "$@" ;;
        list) cmd_config_list "$@" ;;
        seed) cmd_config_seed "$@" ;;
        *) usage ;;
    esac
}

[ $# -ge 1 ] || usage
sub=$1
shift
case $sub in
    version) cmd_version "$@" ;;
    config) cmd_config "$@" ;;
    env) cmd_env "$@" ;;
    create-flags) cmd_create_flags "$@" ;;
    fingerprint) cmd_fingerprint "$@" ;;
    up) cmd_up "$@" ;;
    reset) cmd_reset "$@" ;;
    stop) cmd_stop "$@" ;;
    url) cmd_url "$@" ;;
    connection) cmd_connection "$@" ;;
    update) cmd_update "$@" ;;
    remote) cmd_remote "$@" ;;
    -h|--help|help)
        usage
        ;;
    *)
        warn "unknown subcommand '$sub'."
        usage
        ;;
esac
