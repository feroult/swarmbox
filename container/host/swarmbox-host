#!/bin/sh
# swarmbox: the SwarmBox command, one POSIX sh script on the PATH (the repository file is container/host/swarmbox-host; the
# installers write it as `swarmbox`). No bashisms (no `local`, no `echo -e`, no `read -s`, no arrays, no `[[ ]]`): it must run
# under dash, busybox sh, bash in POSIX mode and macOS /bin/sh. No shell function and no startup file is involved.
#
#   (no command), attach, any other word   up, then run it in the box: `podman exec -it ... swarmbox-entrypoint attach ...`
#   pubkey | tool                          forwarded into the box with `podman exec`
#   version | help                         the version of this script | the command list
#   config get|set|list|seed               the settings (the tunnel token is read from the terminal, never argv)
#   env add|rm NAME | env list             the names of host variables passed to the box (ENV_KEYS)
#   create-flags, fingerprint              the flags of a new box and its fingerprint (no Podman call)
#   up, reset, stop, url                   the lock, the lookup, creation, readiness, the warnings (`url` does not call Podman)
#   connection                             register `podman -c <name>` for the box
#   update [--to TAG]                      pull, refresh this script and the support files, tag X.Y.Z locally, write IMAGE
#   remote setup|status|off|token [options]
#                                          a wrapper over cloudflare-setup.py in the support folder: setup is `apply`, off is `remove`
#   setup --image REF [--with LIST]        what the installers run after they write this script (not for people)
#
# The words handled by the script itself are in the last case of the file; every other first word goes to the box.
# SCRIPT_VERSION below is the version of this file (a test checks it equals container/host/VERSION). The support folder holds
# what an image carries and one file cannot: VERSION, DEFAULTS, cloudflare-setup.py and tool-ports (see support_dir).
#
# Data goes to standard output, messages to standard error. Exit codes: 0 ok; 1 unset key or a failed write; 2 usage, unknown
# key, invalid value or name; 3 prerequisite missing; 4 workspace or path problem; 5 conflict; 6 not ready; 7 Podman failed.
# Paths honor HOME, XDG_CONFIG_HOME and XDG_STATE_HOME (an empty or relative XDG value is ignored, as in dirs.sh).
# The file mode is read as an octal number (stat -c %a, then stat -f %Lp, then find -perm); `ls` output is never parsed.

SCRIPT_VERSION=2.0.9

# shellcheck disable=SC2154  # some variables are assigned through eval (keys are validated names, never user text)
LC_ALL=C
export LC_ALL
umask 077

NL='
'
CR=$(printf '\r')
# DEFAULT_NAME and REGISTRY_REPO come from the DEFAULTS file of the support folder (load_defaults); nothing here holds them.

warn() { printf 'swarmbox: %s\n' "$*" >&2; }
die() { _rc=$1; shift; warn "$*"; exit "$_rc"; }

usage() {
    help_text >&2
    exit 2
}

# opt_arg NAME "$@": $2 is --NAME=VALUE or --NAME followed by its value. Sets OPT_V and OPT_N, the number of arguments used.
opt_arg() {
    case $2 in
        "$1"=*) OPT_V=${2#*=}; OPT_N=1 ;;
        *) [ $# -ge 3 ] || die 2 "$1 needs a value."; OPT_V=$3; OPT_N=2 ;;
    esac
}

help_text() {
    cat <<'USAGE'
usage: swarmbox [--plain] [command [args...]]
  (no command)          open a shell in the box; create and start the box first if needed
  command [args...]     run a command in the box, for example: swarmbox claude
  up | stop | reset     start the box without a shell | stop it | recreate it (the workspace is kept)
  url                   print the address of the web terminal
  update [--to TAG]     fetch a newer image and refresh this command from it, then run `swarmbox reset`
  version               print the version
  config get|set|list   the settings, for example: swarmbox config set WEB_PORT 7682
  env add|rm NAME       pass a variable of yours into the box (env list shows them)
  pubkey                the box's git SSH key
  tool list|install|use|remove NAME   tools inside the box
  remote setup|status|off|token       remote access through Cloudflare (--dry-run shows the changes)
  help                  this list
USAGE
}

# ---------------------------------------------------------------- the key table

# Keys of the config file. NAME is not one of them: it selects the folder, so it comes from SWARMBOX_NAME only.
is_file_key() {
    case $1 in
        WORKSPACE|HOSTNAME|TZ|INIT|PORTS|HOST_ACCESS|BROWSER_URL|WEB|WEB_PORT|WITH|AGENT|YOLO|ENV_KEYS|IMAGE|CLOUDFLARE_TUNNEL_TOKEN) return 0 ;;
    esac
    return 1
}

is_key() { [ "$1" = NAME ] || is_file_key "$1"; }

ALL_KEYS='NAME WORKSPACE HOSTNAME TZ INIT PORTS HOST_ACCESS BROWSER_URL WEB WEB_PORT WITH AGENT YOLO ENV_KEYS IMAGE CLOUDFLARE_TUNNEL_TOKEN'

# Built-in default; empty means "no default" (the key is unset). AGENT has none here: the box picks the first agent of WITH.
default_of() {
    case $1 in
        NAME|HOSTNAME) printf '%s' "$DEFAULT_NAME" ;;
        WORKSPACE) printf '%s/swarmbox' "$HOME" ;;
        TZ) printf 'local' ;;
        INIT) printf 'auto' ;;
        HOST_ACCESS) printf '0' ;;
        WEB|YOLO) printf '1' ;;
        WEB_PORT) printf '7681' ;;
        IMAGE) printf '%s:%s' "$REGISTRY_REPO" "$VERSION_STR" ;;
    esac
}

# ---------------------------------------------------------------- version and the support folder

self_dir() {
    case $0 in
        */*) _d=${0%/*} ;;
        *) _d=. ;;
    esac
    (cd "$_d" 2>/dev/null && pwd -P)
}

# support_dir: sets SUPPORT to the folder of VERSION, DEFAULTS, cloudflare-setup.py and tool-ports. The installers and
# `swarmbox update` put it at $XDG_DATA_HOME/swarmbox/host (default ~/.local/share/swarmbox/host), next to nothing else of the script.
# When a VERSION file sits next to this program (the image's own folder, a checkout, the tests) that folder is the support folder.
support_dir() {
    _sd=$(self_dir) || die 3 "cannot find the folder of this script."
    if [ -r "$_sd/VERSION" ]; then
        SUPPORT=$_sd
    else
        data_host_dir
        SUPPORT=$DATA_HOST
    fi
}

# data_host_dir: sets DATA_HOST, where the installers and `update` write the support folder. SWARMBOX_TEST_SUPPORT_DIR replaces it in
# tests and in dev/host-smoke.sh (XDG_DATA_HOME cannot move: it is also where Podman keeps its images).
data_host_dir() {
    case ${HOME:-} in
        /*) ;;
        *) die 1 "HOME is not set to an absolute path." ;;
    esac
    DATA_HOST=${SWARMBOX_TEST_SUPPORT_DIR:-$(xdg_root "${XDG_DATA_HOME:-}" "$HOME/.local/share")/swarmbox/host}
}

# needs_support FILE: exits 3 with the way out when the support folder has no such file.
needs_support() {
    support_dir
    [ -r "$SUPPORT/$1" ] || die 3 "the support files are missing ($SUPPORT/$1). Run \`swarmbox update\`, or the installer again."
}

# The version of the support files (empty when there is none or it is not a version).
support_version() {
    _sv=
    # shellcheck disable=SC2015  # the `|| true` is the point: a missing or empty file is not an error
    [ -r "$SUPPORT/VERSION" ] && IFS= read -r _sv < "$SUPPORT/VERSION" || true
    trim "$_sv"
    _sv=$_t
    case $_sv in
        *[!0-9A-Za-z.+-]*) _sv= ;;
        [0-9]*.[0-9]*.[0-9]*) ;;
        *) _sv= ;;
    esac
}

# Reads the two keys of the DEFAULTS file of the support folder: DEFAULT_NAME and REGISTRY_REPO. The file is parsed, not sourced:
# only KEY=VALUE lines of these two keys count, one pair of single quotes around a value is removed, anything else is ignored.
# Exits 3 when the file is missing or a value is not usable (a corrupted helper archive).
load_defaults() {
    needs_support DEFAULTS
    _dir=$SUPPORT
    DEFAULT_NAME=
    REGISTRY_REPO=
    while IFS= read -r _l || [ -n "$_l" ]; do
        _l=${_l%"$CR"}
        case $_l in
            SWARMBOX_DEFAULT_NAME=*) _k=N ;;
            SWARMBOX_DEFAULT_IMAGE_REPO=*) _k=R ;;
            *) continue ;;
        esac
        _v=${_l#*=}
        case $_v in
            \'*\') _v=${_v#\'}; _v=${_v%\'} ;;
        esac
        if [ "$_k" = N ]; then DEFAULT_NAME=$_v; else REGISTRY_REPO=$_v; fi
    done < "$_dir/DEFAULTS"
    CONNECTOR_NAME=$DEFAULT_NAME-cloudflared
    valid_box_name "$DEFAULT_NAME" || die 3 "the DEFAULTS file ($_dir/DEFAULTS) has no usable SWARMBOX_DEFAULT_NAME: '$DEFAULT_NAME'."
    case $REGISTRY_REPO in
        ''|*[[:space:]\'\"]*) die 3 "the DEFAULTS file ($_dir/DEFAULTS) has no usable SWARMBOX_DEFAULT_IMAGE_REPO: '$REGISTRY_REPO'." ;;
    esac
}

# ---------------------------------------------------------------- paths

trim() {
    _t=$1
    _t=${_t#"${_t%%[![:space:]]*}"}
    _t=${_t%"${_t##*[![:space:]]}"}
}

xdg_root() {
    # $1 = value of the XDG variable, $2 = default
    case $1 in
        /*) _r=$1 ;;
        *) _r=$2 ;;
    esac
    printf '%s' "${_r%/}"
}

# Valid box name: becomes a folder name and a container name. `config` is reserved: the default box keeps its file at
# <config>/config, so a folder with that name would collide with it.
valid_box_name() {
    case $1 in
        ''|[!A-Za-z0-9]*|*[!A-Za-z0-9_.-]*) return 1 ;;
        config) return 1 ;;
    esac
    return 0
}

init_paths() {
    case ${HOME:-} in
        /*) ;;
        *) die 1 "HOME is not set to an absolute path." ;;
    esac
    VERSION_STR=$SCRIPT_VERSION
    load_defaults
    BOX=${SWARMBOX_NAME:-$DEFAULT_NAME}
    valid_box_name "$BOX" || die 2 "invalid SWARMBOX_NAME '$BOX': it must start with a letter or digit, use only letters, digits, '.', '_' and '-', and not be 'config'."
    CFG_ROOT=$(xdg_root "${XDG_CONFIG_HOME:-}" "$HOME/.config")/swarmbox
    STATE_DIR=$(xdg_root "${XDG_STATE_HOME:-}" "$HOME/.local/state")/swarmbox
    if [ "$BOX" = "$DEFAULT_NAME" ]; then
        CFG_DIR=$CFG_ROOT
    else
        CFG_DIR=$CFG_ROOT/$BOX
    fi
    CFG_FILE=$CFG_DIR/config
    NOTICES=$STATE_DIR/notices
    check_skew
}

# One short line, once, when the support files come from another version than this script (an image of another series, a script
# installed by hand). `swarmbox update` makes them agree.
# shellcheck disable=SC2016  # the backticks in the message are literal
check_skew() {
    support_version
    [ -n "$_sv" ] || return 0
    [ "$_sv" != "$SCRIPT_VERSION" ] || return 0
    notice_seen "skew-$SCRIPT_VERSION-$_sv" && return 0
    warn "this script is $SCRIPT_VERSION but the image files are $_sv; \`swarmbox update\` makes them agree."
    notice_mark "skew-$SCRIPT_VERSION-$_sv" || :
}

# private_dir DIR: makes DIR (and its parents) and removes the group and other permissions of DIR itself (never adds any), so that no other account can plant a file or a
# symlink in it (a folder that already existed with a looser mode is tightened; one that is not ours cannot be and is left as it
# is). Never recursive. Security review SR-03.
private_dir() {
    mkdir -p "$1" || return 1
    chmod go-rwx "$1" 2> /dev/null || true
}

# ---------------------------------------------------------------- the octal mode of a file

mode_ok() {
    case $1 in
        [0-7][0-7][0-7]|[0-7][0-7][0-7][0-7]) return 0 ;;
    esac
    return 1
}

# find -perm reports only "has these bits"; build the number bit by bit.
mode_by_find() {
    [ -n "$(find "$1" -perm -000 -print 2>/dev/null)" ] || return 1
    _has() { [ -n "$(find "$1" -perm -"$2" -print 2>/dev/null)" ]; }
    _sp=0 _ow=0 _gr=0 _ot=0
    _has "$1" 4000 && _sp=$((_sp + 4))
    _has "$1" 2000 && _sp=$((_sp + 2))
    _has "$1" 1000 && _sp=$((_sp + 1))
    _has "$1" 400 && _ow=$((_ow + 4))
    _has "$1" 200 && _ow=$((_ow + 2))
    _has "$1" 100 && _ow=$((_ow + 1))
    _has "$1" 40 && _gr=$((_gr + 4))
    _has "$1" 20 && _gr=$((_gr + 2))
    _has "$1" 10 && _gr=$((_gr + 1))
    _has "$1" 4 && _ot=$((_ot + 4))
    _has "$1" 2 && _ot=$((_ot + 2))
    _has "$1" 1 && _ot=$((_ot + 1))
    if [ "$_sp" -ne 0 ]; then
        printf '%s%s%s%s' "$_sp" "$_ow" "$_gr" "$_ot"
    else
        printf '%s%s%s' "$_ow" "$_gr" "$_ot"
    fi
}

# Prints the mode as octal (600, 644, 4755...), or nothing and returns 1 when no form works.
file_mode() {
    _m=$(stat -c %a "$1" 2>/dev/null) || _m=
    if ! mode_ok "$_m"; then
        _m=$(stat -f %Lp "$1" 2>/dev/null) || _m=
    fi
    if ! mode_ok "$_m"; then
        _m=$(mode_by_find "$1") || _m=
    fi
    mode_ok "$_m" || return 1
    case $_m in
        0[0-7][0-7][0-7]) _m=${_m#0} ;;
    esac
    printf '%s' "$_m"
}

# ---------------------------------------------------------------- reading the config file

# Parses one line into P_KEY and P_VAL; returns 1 for a blank line or a comment.
parse_line() {
    trim "$1"
    _l=$_t
    case $_l in
        ''|'#'*) return 1 ;;
    esac
    case $_l in
        *=*)
            trim "${_l%%=*}"
            P_KEY=$_t
            trim "${_l#*=}"
            P_VAL=$_t
            ;;
        *)
            P_KEY=$_l
            P_VAL=
            ;;
    esac
    return 0
}

# Prints the value of the last line for KEY; returns 1 when the file has no line for it.
cfg_raw() {
    [ -f "$CFG_FILE" ] || return 1
    _found=1
    _val=
    while IFS= read -r _line || [ -n "$_line" ]; do
        parse_line "$_line" || continue
        if [ "$P_KEY" = "$1" ]; then
            _val=$P_VAL
            _found=0
        fi
    done < "$CFG_FILE"
    printf '%s' "$_val"
    return "$_found"
}

TOKEN_IGNORED=0

# One pass over the file per call of the helper: one warning for unknown keys, and the tunnel-token mode rule.
cfg_prepare() {
    TOKEN_IGNORED=0
    [ -f "$CFG_FILE" ] || return 0
    [ -r "$CFG_FILE" ] || die 1 "cannot read the config file $CFG_FILE."
    _unk=
    _hastoken=0
    while IFS= read -r _line || [ -n "$_line" ]; do
        parse_line "$_line" || continue
        if is_file_key "$P_KEY"; then
            if [ "$P_KEY" = CLOUDFLARE_TUNNEL_TOKEN ] && [ -n "$P_VAL" ]; then
                _hastoken=1
            fi
        else
            case " $_unk " in
                *" $P_KEY "*) ;;
                *) _unk="$_unk $P_KEY" ;;
            esac
        fi
    done < "$CFG_FILE"
    [ -z "$_unk" ] || warn "ignoring unknown key(s) in $CFG_FILE:$_unk"
    if [ "$_hastoken" = 1 ]; then
        _mode=$(file_mode "$CFG_FILE") || _mode=
        if [ "$_mode" != 600 ]; then
            TOKEN_IGNORED=1
            if [ -n "$_mode" ]; then
                warn "the config file holds the tunnel token but its mode is $_mode; run \`chmod 600 $CFG_FILE\`"
            else
                warn "the config file holds the tunnel token but its mode could not be read; run \`chmod 600 $CFG_FILE\`"
            fi
        fi
    fi
}

# Sets R_VAL and R_SRC (env, file or default) for KEY.
resolve() {
    R_SRC=default
    R_VAL=
    eval "_e=\${SWARMBOX_$1:-}"
    if [ -n "$_e" ]; then
        R_VAL=$_e
        R_SRC='env'
        return 0
    fi
    if is_file_key "$1" && { [ "$1" != CLOUDFLARE_TUNNEL_TOKEN ] || [ "$TOKEN_IGNORED" = 0 ]; }; then
        if _fv=$(cfg_raw "$1") && [ -n "$_fv" ]; then
            R_VAL=$_fv
            R_SRC='file'
            return 0
        fi
    fi
    R_VAL=$(default_of "$1")
}

# resolve_tunnel_token: sets TUNNEL_TOKEN (empty when there is none) and returns 1 when there is none. The order is the
# environment (SWARMBOX_CLOUDFLARE_TUNNEL_TOKEN), then the config key, accepted only with file mode 600 (cfg_prepare
# has already warned once, naming `chmod 600`, and set TOKEN_IGNORED otherwise). Needs cfg_prepare first. The value is
# never printed here, never put on an argv and never exported.
resolve_tunnel_token() {
    resolve CLOUDFLARE_TUNNEL_TOKEN
    TUNNEL_TOKEN=$R_VAL
    [ -n "$TUNNEL_TOKEN" ]
}

# ---------------------------------------------------------------- validation; messages name the rule

valid_port() {
    case $1 in
        ''|*[!0-9]*) return 1 ;;
    esac
    [ "${#1}" -le 5 ] && [ "$1" -ge 1 ] && [ "$1" -le 65535 ]
}

# Four decimal numbers from 0 to 255 separated by dots.
valid_ipv4() {
    case $1 in
        ''|*[!0-9.]*|.*|*.|*..*) return 1 ;;
    esac
    _oldifs=$IFS
    IFS=.
    set -f
    # shellcheck disable=SC2086
    set -- $1
    set +f
    IFS=$_oldifs
    [ $# -eq 4 ] || return 1
    for _x in "$@"; do
        [ "${#_x}" -le 3 ] && [ "$_x" -le 255 ] || return 1
    done
    return 0
}

valid_port_entry() {
    _pe=$1
    case $_pe in
        *:*:*:*) return 1 ;;
        *:*:*)
            _pa=${_pe%%:*}
            _pr=${_pe#*:}
            valid_ipv4 "$_pa" || return 1
            valid_port "${_pr%%:*}" && valid_port "${_pr#*:}"
            ;;
        *:*) valid_port "${_pe%%:*}" && valid_port "${_pe#*:}" ;;
        *) valid_port "$_pe" ;;
    esac
}

valid_tool_name() {
    case $1 in
        ''|[!a-z0-9]*|*[!a-z0-9_-]*) return 1 ;;
    esac
    return 0
}

valid_env_name() {
    case $1 in
        ''|[!A-Za-z_]*|*[!A-Za-z0-9_]*) return 1 ;;
    esac
    return 0
}

# A name that may be passed to the box: an environment variable name, not one of the host-side SWARMBOX_CLOUDFLARE_ names.
valid_passable_env_name() {
    valid_env_name "$1" || return 1
    case $1 in
        SWARMBOX_CLOUDFLARE_*) return 1 ;;
    esac
    return 0
}

# valid_list FUNCTION VALUE: a comma list, no spaces, no empty item, each item accepted by FUNCTION.
valid_list() {
    _fn=$1
    case $2 in
        ,*|*,|*,,*|*[[:space:]]*) return 1 ;;
    esac
    _oldifs=$IFS
    IFS=,
    set -f
    # shellcheck disable=SC2086  # splitting on commas is the point
    set -- $2
    set +f
    IFS=$_oldifs
    for _item in "$@"; do
        "$_fn" "$_item" || return 1
    done
    return 0
}

# An image reference: the characters Podman accepts in one, and never a leading '-' (a reference is passed to Podman as a bare
# argument, so a leading '-' would be read as an option: security review SR-01).
valid_image_ref() {
    case $1 in
        -*|*[!A-Za-z0-9._/:@-]*) return 1 ;;
    esac
    return 0
}

# validate_value KEY VALUE: sets V_OUT (the value to store) or prints the rule and returns 1.
validate_value() {
    _k=$1
    V_OUT=$2
    _bad() { warn "invalid value for $_k: $*"; return 1; }
    case $V_OUT in
        *"$NL"*|*"$CR"*) _bad "a value cannot contain a newline."; return 1 ;;
    esac
    trim "$V_OUT"
    V_OUT=$_t
    [ -n "$V_OUT" ] || return 0   # empty means "use the default"
    case $_k in
        WORKSPACE)
            case $V_OUT in
                *:*) _bad "the path must not contain ':' (Podman reads it as a separator)."; return 1 ;;
            esac
            # shellcheck disable=SC2088  # a literal tilde is what is matched; the shell did not expand it
            case $V_OUT in
                '~') V_OUT=$HOME ;;
                '~/'*) V_OUT=$HOME/${V_OUT#'~/'} ;;
                /*) ;;
                ./*) V_OUT=$PWD/${V_OUT#./} ;;
                .) V_OUT=$PWD ;;
                *) V_OUT=$PWD/$V_OUT ;;
            esac
            while :; do
                case $V_OUT in
                    ?*/) V_OUT=${V_OUT%/} ;;
                    *) break ;;
                esac
            done
            ;;
        HOSTNAME)
            case $V_OUT in
                [!A-Za-z0-9]*|*[!A-Za-z0-9.-]*) _bad "it must start with a letter or digit and use only letters, digits, '.' and '-'."; return 1 ;;
            esac
            [ "${#V_OUT}" -le 63 ] || { _bad "it must be at most 63 characters."; return 1; }
            ;;
        TZ)
            case $V_OUT in
                [!A-Za-z]*|*[!A-Za-z0-9_+/-]*|*//*|*/|*..*) _bad "it must be 'local', 'off' or a zone name such as Europe/Lisbon (letters, digits, '_', '+', '-', '/')."; return 1 ;;
            esac
            ;;
        INIT)
            case $V_OUT in
                auto|0|1) ;;
                *) _bad "it must be auto, 0 or 1."; return 1 ;;
            esac
            ;;
        HOST_ACCESS|WEB|YOLO)
            case $V_OUT in
                0|1) ;;
                *) _bad "it must be 0 or 1."; return 1 ;;
            esac
            ;;
        PORTS)
            valid_list valid_port_entry "$V_OUT" || { _bad "it must be a comma list, without spaces, of PORT, HOST:CONTAINER or ADDRESS:HOST:CONTAINER with ports from 1 to 65535."; return 1; }
            ;;
        BROWSER_URL)
            case $V_OUT in
                *[[:space:]]*) _bad "it must not contain blanks."; return 1 ;;
                http://?*|https://?*) ;;
                *[!0-9]*)
                    case $V_OUT in
                        *:*)
                            if [ -z "${V_OUT%:*}" ] || ! valid_port "${V_OUT##*:}"; then
                                _bad "it must be a port number, HOST:PORT or an http(s) URL."
                                return 1
                            fi
                            ;;
                        *) _bad "it must be a port number, HOST:PORT or an http(s) URL."; return 1 ;;
                    esac
                    ;;
                *) valid_port "$V_OUT" || { _bad "a bare number must be a port from 1 to 65535."; return 1; } ;;
            esac
            ;;
        WEB_PORT)
            valid_port "$V_OUT" || { _bad "it must be a port number from 1 to 65535."; return 1; }
            ;;
        WITH|AGENT)
            if [ "$_k" = AGENT ]; then
                valid_tool_name "$V_OUT" || { _bad "it must be one tool name: lower-case letters, digits, '_' and '-'."; return 1; }
            else
                valid_list valid_tool_name "$V_OUT" || { _bad "it must be a comma list, without spaces, of tool names (lower-case letters, digits, '_' and '-')."; return 1; }
            fi
            ;;
        ENV_KEYS)
            valid_list valid_passable_env_name "$V_OUT" || { _bad "it must be a comma list, without spaces, of environment variable names (letters, digits, '_', not starting with a digit, not SWARMBOX_CLOUDFLARE_*)."; return 1; }
            ;;
        IMAGE)
            valid_image_ref "$V_OUT" || { _bad "it must be an image reference: letters, digits and '.', '_', '/', ':', '@', '-' only, not starting with '-' (Podman would read it as an option)."; return 1; }
            ;;
        CLOUDFLARE_TUNNEL_TOKEN)
            case $V_OUT in
                *[!A-Za-z0-9+/=_.-]*) _bad "the token must use only letters, digits and '+', '/', '=', '_', '.', '-'."; return 1 ;;
            esac
            ;;
    esac
    return 0
}

# resolve_valid KEY: resolve, then validate a value that came from the environment or the file (a default is the helper's own).
resolve_valid() {
    resolve "$1"
    [ "$R_SRC" = default ] && return 0
    validate_value "$1" "$R_VAL" || exit 2
    R_VAL=$V_OUT
}

# ---------------------------------------------------------------- writing the config file

# cfg_write_keys KEY VALUE [KEY VALUE ...]: replaces (or appends) the keys, keeps every other line, writes under umask 077
# into a temporary file in the same folder, runs chmod 600 on it and renames it over the config. Refuses to write the
# tunnel token (exit 1) if the chmod fails; for other keys it also writes nothing (exit 1).
cfg_write_keys() {
    _tok=0
    _ks=
    _i=1
    while [ "$_i" -le "$#" ]; do
        eval "_wk=\${$_i}"
        # shellcheck disable=SC2154  # _wk is assigned by the eval above
        _ks="$_ks $_wk "
        [ "$_wk" = CLOUDFLARE_TUNNEL_TOKEN ] && _tok=1
        _i=$((_i + 2))
    done
    private_dir "$CFG_DIR" || die 1 "cannot create $CFG_DIR."
    [ ! -f "$CFG_FILE" ] || [ -r "$CFG_FILE" ] || die 1 "cannot read the config file $CFG_FILE."
    # the temporary name is predictable: it is removed first (a symlink planted there is deleted, not followed) and then created
    # with noclobber, which fails instead of writing through anything that appears in between (security review SR-02)
    _tmp=$CFG_FILE.tmp.$$
    rm -f "$_tmp"
    set -C
    {
        if [ -f "$CFG_FILE" ]; then
            while IFS= read -r _line || [ -n "$_line" ]; do
                if parse_line "$_line"; then
                    case $_ks in
                        *" $P_KEY "*) continue ;;
                    esac
                fi
                printf '%s\n' "$_line"
            done < "$CFG_FILE"
        else
            printf '%s\n' '# SwarmBox host configuration: one KEY=VALUE per line, values literal (see docs/design.md, "Configuration").'
        fi
        while [ "$#" -ge 2 ]; do
            printf '%s=%s\n' "$1" "$2"
            shift 2
        done
    } > "$_tmp" || { set +C; rm -f "$_tmp"; die 1 "cannot write $_tmp."; }
    set +C
    if ! chmod 600 "$_tmp"; then
        rm -f "$_tmp"
        if [ "$_tok" = 1 ]; then
            die 1 "could not set mode 600 on the config file; the tunnel token was not written."
        fi
        die 1 "could not set mode 600 on the config file; nothing was written."
    fi
    mv -f "$_tmp" "$CFG_FILE" || { rm -f "$_tmp"; die 1 "cannot replace $CFG_FILE."; }
}

# Notices state: one line <box>:<KEY> per announced key.
notice_seen() { [ -f "$NOTICES" ] && grep -qxF -- "$BOX:$1" "$NOTICES"; }
notice_mark() {
    private_dir "$STATE_DIR" || return 1
    printf '%s:%s\n' "$BOX" "$1" >> "$NOTICES"
}
notice_clear() {
    [ -f "$NOTICES" ] || return 0
    rm -f "$NOTICES.tmp.$$"   # SR-02: a planted symlink is deleted, and noclobber refuses anything that appears after
    ( set -C; grep -vxF -- "$BOX:$1" "$NOTICES" > "$NOTICES.tmp.$$" ) || :   # grep exits 1 when no line is left
    [ -f "$NOTICES.tmp.$$" ] && [ ! -L "$NOTICES.tmp.$$" ] || return 0
    mv -f "$NOTICES.tmp.$$" "$NOTICES"
}

# ---------------------------------------------------------------- reading a secret without echo

# Reads one line from the terminal into SECRET with echo off. Restores the terminal on every exit path (stty -g, trap).
read_secret() {
    SECRET=
    if [ ! -t 0 ]; then
        die 2 "the tunnel token must be typed on a terminal (never as an argument and never piped)."
    fi
    _stty=$(stty -g 2>/dev/null) || die 2 "the tunnel token must be typed on a terminal."
    trap 'stty "$_stty" 2>/dev/null; exit 1' INT TERM HUP
    printf 'Cloudflare tunnel token (input is hidden): ' >&2
    stty -echo 2>/dev/null
    _rc=0
    IFS= read -r SECRET || _rc=$?
    stty "$_stty" 2>/dev/null
    trap - INT TERM HUP
    printf '\n' >&2
    [ "$_rc" -eq 0 ] || [ -n "$SECRET" ] || die 2 "no token was read."
}

# ---------------------------------------------------------------- commands

cmd_version() {
    [ $# -eq 0 ] || usage
    printf '%s\n' "$SCRIPT_VERSION"
}

cmd_config_get() {
    [ $# -eq 1 ] || usage
    is_key "$1" || die 2 "unknown key '$1'."
    init_paths
    cfg_prepare
    if [ "$1" = CLOUDFLARE_TUNNEL_TOKEN ]; then
        resolve_tunnel_token || return 1
        printf '%s\n' "$TUNNEL_TOKEN"
        return 0
    fi
    resolve "$1"
    [ -n "$R_VAL" ] || return 1
    printf '%s\n' "$R_VAL"
}

cmd_config_set() {
    if [ $# -lt 1 ] || [ $# -gt 2 ]; then usage; fi
    _key=$1
    [ "$_key" != NAME ] || die 2 "NAME is not a key of the config file: it selects the config folder, so set SWARMBOX_NAME in the environment."
    is_file_key "$_key" || die 2 "unknown key '$_key'."
    init_paths
    if [ "$_key" = CLOUDFLARE_TUNNEL_TOKEN ]; then
        [ $# -eq 1 ] || die 2 "the tunnel token is never given on the command line; run 'swarmbox config set CLOUDFLARE_TUNNEL_TOKEN' and type it."
        read_secret
        [ -n "$SECRET" ] || die 2 "invalid value for CLOUDFLARE_TUNNEL_TOKEN: it must not be empty."
        validate_value "$_key" "$SECRET" || exit 2
        _stored=$V_OUT
        SECRET=
    else
        [ $# -eq 2 ] || usage
        validate_value "$_key" "$2" || exit 2
        _stored=$V_OUT
    fi
    cfg_write_keys "$_key" "$_stored" || exit 1
    notice_clear "$_key"
}

cmd_config_list() {
    [ $# -eq 0 ] || usage
    init_paths
    cfg_prepare
    for _key in $ALL_KEYS; do
        resolve "$_key"
        if [ "$_key" = CLOUDFLARE_TUNNEL_TOKEN ]; then
            if [ -n "$R_VAL" ]; then
                printf '%s=set\t%s\n' "$_key" "$R_SRC"
            else
                printf '%s=unset\t%s\n' "$_key" "$R_SRC"
            fi
        else
            printf '%s=%s\t%s\n' "$_key" "$R_VAL" "$R_SRC"
        fi
    done
}

cmd_config_seed() {
    _sw=
    _sws=
    _sim=
    while [ $# -gt 0 ]; do
        case $1 in
            --with|--with=*) opt_arg --with "$@"; _sw=$OPT_V ;;
            --workspace|--workspace=*) opt_arg --workspace "$@"; _sws=$OPT_V ;;
            --image|--image=*) opt_arg --image "$@"; _sim=$OPT_V ;;
            *) die 2 "config seed: unknown argument '$1'." ;;
        esac
        shift "$OPT_N"
    done
    init_paths
    # validate everything first: an invalid seed changes nothing
    _pairs=
    _sk=
    for _key in WITH WORKSPACE IMAGE; do
        case $_key in
            WITH) _v=$_sw ;;
            WORKSPACE) _v=$_sws ;;
            IMAGE) _v=$_sim ;;
        esac
        validate_value "$_key" "$_v" || exit 2
        [ -n "$V_OUT" ] || continue
        eval "SEED_$_key=\$V_OUT"
        _sk="$_sk $_key"
    done
    if [ ! -f "$CFG_FILE" ]; then
        set --
        for _key in $_sk; do
            eval "set -- \"\$@\" \"\$_key\" \"\$SEED_$_key\""
        done
        cfg_write_keys "$@" || exit 1
        eval "_ws=\${SEED_WORKSPACE:-}"
        [ -z "$_ws" ] || warn "WORKSPACE recorded as $_ws"
        return 0
    fi
    cfg_prepare
    for _key in $_sk; do
        eval "_want=\$SEED_$_key"
        # compare with what the file (or the default) says, ignoring the environment
        if _have=$(cfg_raw "$_key") && [ -n "$_have" ]; then :; else _have=$(default_of "$_key"); fi
        # shellcheck disable=SC2154  # _want is assigned by the eval above
        [ "$_want" != "$_have" ] || continue
        if notice_seen "$_key"; then continue; fi
        warn "the installer asked for $_key=$_want, the config says $_key=$_have; run \`swarmbox config set $_key $_want\` to change it"
        notice_mark "$_key" || warn "cannot write $NOTICES; the notice may repeat."
    done
    return 0
}

# ENV_KEYS as stored in the file (the list the commands edit).
env_file_list() { _el=$(cfg_raw ENV_KEYS) || _el=; printf '%s' "$_el"; }

cmd_env() {
    [ $# -ge 1 ] || usage
    _sub=$1
    shift
    case $_sub in
        add|rm)
            [ $# -eq 1 ] || usage
            _n=$1
            valid_env_name "$_n" || die 2 "invalid variable name '$_n': use letters, digits and '_', not starting with a digit."
            valid_passable_env_name "$_n" || die 2 "'$_n' is refused: names starting with SWARMBOX_CLOUDFLARE_ belong to the host side and never enter the box."
            init_paths
            cfg_prepare
            _cur=$(env_file_list)
            _new=
            _present=0
            _oldifs=$IFS
            IFS=,
            set -f
            # shellcheck disable=SC2086
            for _item in $_cur; do
                [ -n "$_item" ] || continue
                if [ "$_item" = "$_n" ]; then
                    _present=1
                    [ "$_sub" = rm ] && continue
                fi
                _new=${_new:+$_new,}$_item
            done
            set +f
            IFS=$_oldifs
            if [ "$_sub" = add ]; then
                [ "$_present" = 0 ] || return 0
                _new=${_new:+$_new,}$_n
            else
                [ "$_present" = 1 ] || return 0
            fi
            cfg_write_keys ENV_KEYS "$_new" || exit 1
            notice_clear ENV_KEYS
            if [ -n "${SWARMBOX_ENV_KEYS:-}" ]; then
                warn "SWARMBOX_ENV_KEYS is set in the environment and overrides the file; the change shows only when it is unset."
            fi
            ;;
        list)
            [ $# -eq 0 ] || usage
            init_paths
            cfg_prepare
            resolve ENV_KEYS
            _oldifs=$IFS
            IFS=,
            set -f
            # shellcheck disable=SC2086
            set -- $R_VAL
            set +f
            IFS=$_oldifs
            for _item in "$@"; do
                [ -n "$_item" ] || continue
                if ! valid_passable_env_name "$_item"; then
                    warn "ignoring the invalid name '$_item' in ENV_KEYS."
                    continue
                fi
                eval "_isset=\${$_item+x}"
                # shellcheck disable=SC2154  # _isset is assigned by the eval above
                if [ "$_isset" = x ]; then
                    printf '%s\tset\n' "$_item"
                else
                    printf '%s\tnot set\n' "$_item"
                fi
            done
            ;;
        *) usage ;;
    esac
}

# ---------------------------------------------------------------- create-flags and fingerprint
# Nothing here calls Podman. The flags are collected in OUT, one argument per line, and printed only when every
# check has passed, so a failure never leaves half a list on standard output (`up` captures the output first).

TAB=$(printf '\t')

# The first of sha256sum and `shasum -a 256` that exists (Linux has the first, macOS the second); exit 3 when neither does.
need_sha256() {
    if command -v sha256sum > /dev/null 2>&1; then
        SHA=sha256sum
    elif command -v shasum > /dev/null 2>&1; then
        SHA=shasum
    else
        die 3 "neither sha256sum nor shasum was found; one of them is needed to compute the box fingerprint."
    fi
}

# Hash of standard input, hex only.
sha256_stdin() {
    if [ "$SHA" = sha256sum ]; then
        _so=$(sha256sum)
    else
        _so=$(shasum -a 256)
    fi
    printf '%s' "${_so%% *}"
}

# Reads tool-ports from the support folder into TP_DATA: one "tool<TAB>port" line each, malformed lines skipped with a
# warning. The file always exists in a good archive; a missing one is an incomplete install: exit 3.
load_tool_ports() {
    needs_support tool-ports
    _dir=$SUPPORT
    TP_DATA=
    while IFS= read -r _l || [ -n "$_l" ]; do
        [ -n "$_l" ] || continue
        case $_l in
            *"$TAB"*)
                _tn=${_l%%"$TAB"*}
                _tp=${_l#*"$TAB"}
                if valid_tool_name "$_tn" && valid_port "$_tp"; then
                    TP_DATA=$TP_DATA$_tn$TAB$_tp$NL
                    continue
                fi
                ;;
        esac
        warn "ignoring a malformed line in $_dir/tool-ports: $_l"
    done < "$_dir/tool-ports"
}

# norm_port ENTRY: N_OUT = ADDRESS:HOST:CONTAINER; loopback unless an address was given (PORTS).
norm_port() {
    case $1 in
        *:*:*) N_OUT=$1 ;;
        *:*) N_OUT=127.0.0.1:$1 ;;
        *) N_OUT=127.0.0.1:$1:$1 ;;
    esac
}

# The published ports of the box: the user's PORTS (normalized), then the ports of the tools in WITH from tool-ports,
# skipping a host port that is already published. Sets PORT_LIST (comma list) and PORT_ARGS (one mapping per line).
# $1 = 1 to warn about all-interface binds.
build_ports() {
    PORT_LIST=
    PORT_ARGS=
    _hosts=,
    _oldifs=$IFS
    IFS=,
    set -f
    # shellcheck disable=SC2086  # splitting on commas is the point
    set -- $C_PORTS
    set +f
    IFS=$_oldifs
    _warn=${WARN_PORTS:-0}
    for _e in "$@"; do
        [ -n "$_e" ] || continue
        norm_port "$_e"
        _m=$N_OUT
        _rest=${_m#*:}
        _hosts=$_hosts${_rest%%:*},
        PORT_LIST=${PORT_LIST:+$PORT_LIST,}$_m
        PORT_ARGS=$PORT_ARGS$_m$NL
        case $_m in
            0.0.0.0:*) [ "$_warn" = 0 ] || warn "port $_m is exposed on all network interfaces" ;;
        esac
    done
    [ -n "$C_WITH" ] || return 0
    _oldifs=$IFS
    IFS=,
    set -f
    # shellcheck disable=SC2086
    set -- $C_WITH
    set +f
    IFS=$_oldifs
    for _t in "$@"; do
        while IFS= read -r _l; do
            [ -n "$_l" ] || continue
            [ "${_l%%"$TAB"*}" = "$_t" ] || continue
            _p=${_l#*"$TAB"}
            case $_hosts in
                *",$_p,"*) continue ;;
            esac
            _hosts=$_hosts$_p,
            _m=127.0.0.1:$_p:$_p
            PORT_LIST=${PORT_LIST:+$PORT_LIST,}$_m
            PORT_ARGS=$PORT_ARGS$_m$NL
        done <<TPEOF
$TP_DATA
TPEOF
    done
}

# BROWSER_URL as the box gets it: a bare number N is http://host.containers.internal:N, host:port gets http://, a URL stays.
# The empty string, when asked for explicitly with --browser-url, is the port 9222 (`--remote-browser` without a value today).
normalize_browser_url() {
    case $1 in
        '') B_OUT=http://host.containers.internal:9222 ;;
        http://*|https://*) B_OUT=$1 ;;
        *[!0-9]*) B_OUT=http://$1 ;;
        *) B_OUT=http://host.containers.internal:$1 ;;
    esac
}

# Reads and validates every creation-time key into C_<KEY> (environment, file, default; the environment is not validated by
# `config get`, so it is here). $1 = 1 when INIT must already be 0 or 1. BROWSER_OVERRIDE_SET/BROWSER_OVERRIDE: --browser-url.
load_creation() {
    init_paths
    cfg_prepare
    for _key in WORKSPACE HOSTNAME TZ INIT PORTS HOST_ACCESS BROWSER_URL WEB WEB_PORT WITH AGENT YOLO ENV_KEYS IMAGE; do
        resolve "$_key"
        _v=$R_VAL
        if [ "$_key" = BROWSER_URL ] && [ "${BROWSER_OVERRIDE_SET:-0}" = 1 ]; then
            _v=$BROWSER_OVERRIDE
            R_SRC='env'
        fi
        if [ "$R_SRC" != default ]; then   # a default is the helper's own value (the image default is the registry path)
            validate_value "$_key" "$_v" || exit 2
            _v=$V_OUT
        fi
        eval "C_$_key=\$_v"
    done
    C_NAME=$BOX
    if [ "$1" = 1 ]; then
        case $C_INIT in
            0|1) ;;
            *) die 2 "INIT is '$C_INIT': 'swarmbox up' resolves auto to 0 or 1 before it asks for the flags (set SWARMBOX_INIT to 0 or 1 when calling create-flags directly)." ;;
        esac
    fi
    if [ -n "$C_BROWSER_URL" ] || [ "${BROWSER_OVERRIDE_SET:-0}" = 1 ]; then
        normalize_browser_url "$C_BROWSER_URL"
        C_BROWSER_URL=$B_OUT
    fi
    # TZ as it will be passed: local needs the host's local time file
    TZ_R=$C_TZ
    if [ "$C_TZ" = local ] && [ ! -e "${SWARMBOX_LOCALTIME_FILE:-/etc/localtime}" ]; then
        TZ_R=off
        [ "${WARN_PORTS:-0}" = 0 ] || warn "$([ -n "${SWARMBOX_LOCALTIME_FILE:-}" ] && printf '%s' "$SWARMBOX_LOCALTIME_FILE" || printf '/etc/localtime') not found; the box will use UTC. Set TZ to a zone name such as Europe/Lisbon with \`swarmbox config set TZ\`."
    fi
    build_ports
}

# env-hash: NAME=value for each listed name that is set, NAME for each that is not; sorted; SHA-256. The values only go
# through a pipe, never through an argument, and only the hash leaves this function.
compute_env_hash() {
    _lines=
    _oldifs=$IFS
    IFS=,
    set -f
    # shellcheck disable=SC2086
    set -- $C_ENV_KEYS
    set +f
    IFS=$_oldifs
    for _n in "$@"; do
        [ -n "$_n" ] || continue
        eval "_isset=\${$_n+x}"
        if [ "$_isset" = x ]; then
            eval "_val=\${$_n}"
            _lines=$_lines$_n=$_val$NL
        else
            _lines=$_lines$_n$NL
        fi
    done
    ENV_HASH=$(printf '%s' "$_lines" | sort | sha256_stdin)
    _val=
}

# FP: SHA-256 over the sorted KEY=value lines of every creation-time key plus env-hash=<hash>.
compute_fingerprint() {
    compute_env_hash
    [ -n "$ENV_HASH" ] || die 3 "could not compute a SHA-256 hash with $SHA."
    _l="AGENT=$C_AGENT${NL}BROWSER_URL=$C_BROWSER_URL${NL}ENV_KEYS=$C_ENV_KEYS${NL}HOSTNAME=$C_HOSTNAME${NL}HOST_ACCESS=$C_HOST_ACCESS${NL}IMAGE=$C_IMAGE${NL}INIT=$C_INIT${NL}NAME=$C_NAME${NL}PORTS=$PORT_LIST${NL}TZ=$TZ_R${NL}WEB=$C_WEB${NL}WEB_PORT=$C_WEB_PORT${NL}WITH=$C_WITH${NL}WORKSPACE=$C_WORKSPACE${NL}YOLO=$C_YOLO${NL}env-hash=$ENV_HASH$NL"
    FP=$(printf '%s' "$_l" | sort | sha256_stdin)
    [ -n "$FP" ] || die 3 "could not compute a SHA-256 hash with $SHA."
}

# True when the kernel says it is WSL; the probe file is overridable for tests.
is_wsl() {
    _pv=${SWARMBOX_TEST_PROC_VERSION:-/proc/version}
    [ -r "$_pv" ] || return 1
    grep -qi microsoft "$_pv" 2> /dev/null
}

# A path under /mnt/<one letter>/ (a Windows drive on WSL).
win_drive_path() {
    case $1 in
        /mnt/[A-Za-z]|/mnt/[A-Za-z]/*) return 0 ;;
    esac
    return 1
}

# Refuse a workspace on a Windows drive, by the written path, by each symlink on the way (readlink without options is
# on Linux and macOS) and by the real path of an existing folder.
check_not_windows_drive() {
    is_wsl || return 0
    _p=$1
    _n=0
    while :; do
        if win_drive_path "$_p"; then
            die 4 "workspace $1 is on a Windows drive; WSL2 is supported only with the workspace on the Linux filesystem (for example ~/swarmbox)."
        fi
        [ -L "$_p" ] || break
        [ "$_n" -lt 10 ] || break
        _t=$(readlink "$_p") || break
        case $_t in
            /*) _p=$_t ;;
            *) _p=${_p%/*}/$_t ;;
        esac
        _n=$((_n + 1))
    done
    if [ -d "$1" ]; then
        _real=$(cd "$1" 2> /dev/null && pwd -P) || _real=
        if [ -n "$_real" ] && win_drive_path "$_real"; then
            die 4 "workspace $1 is on a Windows drive; WSL2 is supported only with the workspace on the Linux filesystem (for example ~/swarmbox)."
        fi
    fi
}

# Edge cases: the folder is created when missing (one message, parents too), must be a folder, and must be writable.
check_workspace() {
    check_not_windows_drive "$C_WORKSPACE"
    if [ ! -e "$C_WORKSPACE" ] && [ ! -L "$C_WORKSPACE" ]; then
        (umask 022 && mkdir -p "$C_WORKSPACE") 2> /dev/null || die 4 "cannot create the workspace folder $C_WORKSPACE."
        warn "created the workspace folder $C_WORKSPACE"
    fi
    [ -d "$C_WORKSPACE" ] || die 4 "workspace $C_WORKSPACE is not a folder."
    if [ ! -w "$C_WORKSPACE" ] || [ ! -x "$C_WORKSPACE" ]; then
        die 4 "workspace $C_WORKSPACE is not writable by this user"
    fi
}

OUT=
emit() { OUT=$OUT$1$NL; }

# No output may ask for the host network or more privilege. Nothing builds such a line; this is the last look before printing.
guard_flags() {
    while IFS= read -r _g; do
        case $_g in
            --network*|--net=*|--privileged*|--pid=*|--ipc=*|--uts=*|--cap-add*|--userns=host*)
                die 70 "internal error: refusing to emit '$_g' (no host network or extra privilege)."
                ;;
        esac
    done <<GEOF
$OUT
GEOF
}

cmd_create_flags() {
    BROWSER_OVERRIDE_SET=0
    BROWSER_OVERRIDE=
    while [ $# -gt 0 ]; do
        case $1 in
            --browser-url|--browser-url=*)
                opt_arg --browser-url "$@"
                BROWSER_OVERRIDE_SET=1
                BROWSER_OVERRIDE=$OPT_V
                shift "$OPT_N"
                ;;
            *) die 2 "create-flags: unknown argument '$1'." ;;
        esac
    done
    need_sha256
    load_tool_ports
    WARN_PORTS=1
    load_creation 1
    check_workspace
    compute_fingerprint
    _os=${SWARMBOX_TEST_OS:-$(uname -s)}
    OUT=
    emit --userns=keep-id:uid=1000,gid=1000
    emit --pids-limit=16384
    if [ "$_os" = Darwin ]; then
        emit --security-opt
        emit label=disable
    fi
    if [ "${SWARMBOX_TEST_NO_NESTED:-}" != 1 ]; then   # tests only: the nested level of the development box has utsns=host, where --hostname is refused
        emit --hostname
        emit "$C_HOSTNAME"
    fi
    emit -v
    emit "$C_WORKSPACE:/home/agent"
    [ "$C_INIT" != 1 ] || emit --init
    [ "$TZ_R" = off ] || emit "--tz=$TZ_R"
    emit --tmpfs
    emit /tmp/swarmbox
    if [ "${SWARMBOX_TEST_NO_NESTED:-}" != 1 ]; then   # tests only: a throwaway box in a container that cannot offer the third level
        emit --device
        emit /dev/net/tun
        emit --security-opt
        emit 'unmask=/proc/*'
    fi
    emit -v
    emit "$C_NAME-containers:/home/agent/.local/share/containers"
    if [ "$C_HOST_ACCESS" = 1 ]; then
        emit --add-host
        emit host.containers.internal:host-gateway
    fi
    while IFS= read -r _m; do
        [ -n "$_m" ] || continue
        emit -p
        emit "$_m"
    done <<PEOF
$PORT_ARGS
PEOF
    if [ "$C_WEB" = 1 ]; then
        emit -p
        emit "127.0.0.1:$C_WEB_PORT:7681"
    fi
    # the listed variables by name: Podman reads the value from its own environment, so it is never in argv
    if [ -n "$C_ENV_KEYS" ]; then
        _oldifs=$IFS
        IFS=,
        set -f
        # shellcheck disable=SC2086
        set -- $C_ENV_KEYS
        set +f
        IFS=$_oldifs
        for _n in "$@"; do
            eval "_isset=\${$_n+x}"
            if [ "$_isset" != x ]; then
                warn "$_n is listed but not set in this terminal; the box will start without it"
                continue
            fi
            emit -e
            emit "$_n"
        done
    fi
    emit -e
    emit "SWARMBOX_NAME=$C_NAME"
    emit -e
    emit "SWARMBOX_WEB=$C_WEB"
    emit -e
    emit "SWARMBOX_YOLO=$C_YOLO"
    if [ "${SWARMBOX_TEST_NO_NESTED:-}" = 1 ]; then emit -e; emit SWARMBOX_TEST_NO_NESTED=1; fi
    if [ -n "$C_WITH" ]; then emit -e; emit "SWARMBOX_WITH=$C_WITH"; fi
    if [ -n "$C_AGENT" ]; then emit -e; emit "SWARMBOX_AGENT=$C_AGENT"; fi
    if [ -n "$C_BROWSER_URL" ]; then emit -e; emit "SWARMBOX_BROWSER_URL=$C_BROWSER_URL"; fi
    emit --label
    emit swarmbox.managed=2
    emit --label
    emit "swarmbox.image=$C_IMAGE"
    emit --label
    emit "swarmbox.workspace=$C_WORKSPACE"
    emit --label
    emit "swarmbox.ports=$PORT_LIST"
    emit --label
    emit "swarmbox.env-hash=$ENV_HASH"
    emit --label
    emit "swarmbox.fingerprint=$FP"
    guard_flags
    printf '%s' "$OUT"
}

# label_get NAME: the value of a --label NAME=VALUE that was given; returns 1 when there is none.
label_get() {
    while IFS= read -r _ll; do
        case $_ll in
            "$1="*) printf '%s' "${_ll#*=}"; return 0 ;;
        esac
    done <<LEOF
$LABELS
LEOF
    return 1
}

# Prints one line per difference between the current configuration (C_*, PORT_LIST, ENV_HASH) and the box's labels in LABELS,
# in the wording of the fingerprint warnings. Used by `fingerprint --explain` and by `up` (which prefixes each line and prints it on stderr).
# shellcheck disable=SC2016  # the backticks in the messages are literal (they quote `swarmbox reset` for the reader)
fp_explain() {
    _said=0
    if _b=$(label_get swarmbox.image) && [ "$_b" != "$C_IMAGE" ]; then
        printf 'this box was created from %s; the config asks for %s; run `swarmbox reset`\n' "$_b" "$C_IMAGE"
        _said=1
    fi
    if _b=$(label_get swarmbox.workspace) && [ "$_b" != "$C_WORKSPACE" ]; then
        printf 'the workspace in the config is %s, this box uses %s; run `swarmbox reset` to switch\n' "$C_WORKSPACE" "$_b"
        _said=1
    fi
    if _b=$(label_get swarmbox.ports) && [ "$_b" != "$PORT_LIST" ]; then
        printf '`PORTS` changed: box has %s, config has %s; run `swarmbox reset` to apply\n' "${_b:-(none)}" "${PORT_LIST:-(none)}"
        _said=1
    fi
    if _b=$(label_get swarmbox.env-hash) && [ "$_b" != "$ENV_HASH" ]; then
        printf 'the variables changed on the host; run `swarmbox reset` to apply them\n'
        _said=1
    fi
    if [ "$_said" = 0 ]; then
        printf 'a setting changed since the box was created; run `swarmbox reset` to apply it\n'
    fi
}

# fingerprint [--explain] [--label NAME=VALUE]...: the hash of the current configuration; with labels it compares (exit 0 same,
# 1 different), with --explain it also prints one line per difference it can name. Without labels there is no box to
# compare with: exit 5 for --explain. Reading the labels from Podman is `up`'s job.
# shellcheck disable=SC2016  # the backticks in the messages are literal (they quote `swarmbox reset` for the reader)
cmd_fingerprint() {
    EXPLAIN=0
    LABELS=
    while [ $# -gt 0 ]; do
        case $1 in
            --explain) EXPLAIN=1; shift ;;
            --label|--label=*)
                opt_arg --label "$@"
                case $OPT_V in
                    ?*=*) LABELS=$LABELS$OPT_V$NL ;;
                    *) die 2 "a label must be NAME=VALUE: '$OPT_V'." ;;
                esac
                shift "$OPT_N"
                ;;
            *) die 2 "fingerprint: unknown argument '$1'." ;;
        esac
    done
    need_sha256
    load_tool_ports
    WARN_PORTS=0
    load_creation 0
    compute_fingerprint
    if [ -z "$LABELS" ]; then
        [ "$EXPLAIN" = 0 ] || die 5 "no box: no labels were given to compare with."
        printf '%s\n' "$FP"
        return 0
    fi
    _have=$(label_get swarmbox.fingerprint) || die 5 "the box has no swarmbox.fingerprint label (it was not made by this version of SwarmBox)."
    printf '%s\n' "$FP"
    [ "$_have" != "$FP" ] || return 0
    [ "$EXPLAIN" = 0 ] || fp_explain
    return 1
}

# ---------------------------------------------------------------- up, reset, stop, url
# Variables of this block start with u_ or UP_ so that they do not collide with the loops above. Standard output
# stays empty (data only); every message goes to standard error.

UP_LOCK=
UP_LOCK_HELD=0
UP_BG=
UP_ERRF=
UP_FLAGS=
UP_CIDF=

# Runs on every way out of up, reset and stop (EXIT trap): ends a background child, removes this call's temporary files and the
# lock, but only a lock this call made (UP_LOCK_HELD) and never one that it merely waited for.
up_cleanup() {
    if [ -n "$UP_BG" ]; then kill "$UP_BG" 2> /dev/null; fi
    [ -z "$UP_ERRF" ] || rm -f "$UP_ERRF"
    [ -z "$UP_FLAGS" ] || rm -f "$UP_FLAGS"
    [ -z "$UP_CIDF" ] || rm -f "$UP_CIDF"
    if [ "$UP_LOCK_HELD" = 1 ] && [ -n "$UP_LOCK" ]; then rm -rf "$UP_LOCK"; fi
}

# The exit is explicit so the EXIT trap runs and the status says which signal ended the call (128 + n).
up_traps() {
    trap up_cleanup EXIT
    trap 'exit 129' HUP
    trap 'exit 130' INT
    trap 'exit 143' TERM
}

# A pause that a trapped signal interrupts at once (a foreground `sleep` would delay the trap until it ends).
nap() {
    sleep "${SWARMBOX_TEST_NAP:-1}" &
    UP_BG=$!
    wait "$UP_BG" 2> /dev/null
    UP_BG=
}

ensure_state_dir() {
    private_dir "$STATE_DIR" || die 4 "cannot create $STATE_DIR."
    UP_ERRF=$STATE_DIR/err.$$
    rm -f "$UP_ERRF"   # SR-02: a symlink planted at the predictable name is deleted, never written through
}

need_podman() {
    command -v podman > /dev/null 2>&1 && return 0
    warn "Podman is not installed."
    printf '%s\n' "  Linux: sudo apt install podman (Debian/Ubuntu) or sudo dnf install podman (Fedora/RHEL)" "  macOS: brew install podman" >&2
    exit 3
}

# Podman 4.3 or newer. Compared as numbers, so 4.10 is newer than 4.3. An unreadable version is a warning: the box may work.
check_podman_version() {
    u_v=$(podman version --format '{{.Client.Version}}' 2> /dev/null) || u_v=
    case $u_v in
        [0-9]*.[0-9]*) ;;
        *) warn "could not read the Podman version ('$u_v'); continuing."; return 0 ;;
    esac
    u_maj=${u_v%%.*}
    u_min=${u_v#*.}
    u_min=${u_min%%[!0-9]*}
    case $u_maj$u_min in
        *[!0-9]*|'') warn "could not read the Podman version ('$u_v'); continuing."; return 0 ;;
    esac
    if [ "$u_maj" -lt 4 ] || { [ "$u_maj" -eq 4 ] && [ "$u_min" -lt 3 ]; }; then
        die 3 "Podman $u_maj.$u_min found, 4.3 or newer is required. Upgrade Podman and try again."
    fi
}

# /dev/net/tun on Linux and WSL (on macOS `serve` checks inside the Podman machine). SWARMBOX_TEST_TUN names the file that stands
# for it in tests; SWARMBOX_TEST_NO_NESTED=1 skips the check together with the flags that need it.
check_tun() {
    u_os=${SWARMBOX_TEST_OS:-$(uname -s)}
    [ "$u_os" != Darwin ] || return 0
    [ "${SWARMBOX_TEST_NO_NESTED:-}" != 1 ] || return 0
    [ -e "${SWARMBOX_TEST_TUN:-/dev/net/tun}" ] && return 0
    die 3 "/dev/net/tun is missing on this host. Nested Podman needs it. On Linux try: sudo modprobe tun"
}

# The last lines of Podman's error, indented, on standard error.
show_err() { tail -n "${2:-3}" "$1" 2> /dev/null | sed 's/^/    /' >&2; }

# ---------------------------------------------------------------- the pull, for a person at a terminal

# ui_setup: UI=1 when standard error is a terminal the progress line may draw on (not with SWARMBOX_PROGRESS=plain, TERM=dumb or
# no TERM). Colors are a palette of its own (the roles in ui_c: violet, teal, indigo, slate), not the prompt's; NO_COLOR turns them off. The
# powerline separators and the download icon need a Nerd Font, which cannot be detected: they are on when Starship runs in this shell
# (STARSHIP_SHELL is set) or SWARMBOX_ICONS=1, and off with SWARMBOX_ICONS=0. Without a UTF-8 locale the bar is plain ASCII.
ui_setup() {
    UI=0
    [ -t 2 ] || return 0
    [ "${SWARMBOX_PROGRESS:-}" != plain ] || return 0
    case ${TERM:-} in dumb|'') return 0 ;; esac
    UI=1
    UI_ESC=$(printf '\033')
    if [ -n "${NO_COLOR:-}" ]; then UI_COLOR=0; else UI_COLOR=1; fi
    UI_PL=0
    if [ "${SWARMBOX_ICONS:-}" = 1 ] || { [ -n "${STARSHIP_SHELL:-}" ] && [ "${SWARMBOX_ICONS:-}" != 0 ]; }; then UI_PL=1; fi
    case ${LC_ALL:-${LC_CTYPE:-${LANG:-}}} in
        *[Uu][Tt][Ff]-8*|*[Uu][Tt][Ff]8*)
            UI_ON=$(printf '\342\226\260')
            UI_OFF=$(printf '\342\226\261')
            UI_OK=$(printf '\342\234\224')
            ;;
        *)
            UI_ON='#'
            UI_OFF='-'
            UI_OK='ok'
            UI_PL=0
            ;;
    esac
    UI_SEP=$(printf '\356\202\260')
    UI_ICON=$(printf '\357\200\231')
    UI_COLS=$(tput cols 2> /dev/null) || UI_COLS=80
    case $UI_COLS in ''|*[!0-9]*) UI_COLS=80 ;; esac
}

# ui_c fg|bg ROLE: the escape that sets that color, nothing when colors are off.
ui_c() {
    [ "$UI_COLOR" = 1 ] || return 0
    case $2 in
        violet) uc_r=109; uc_g=40; uc_b=217; uc_n=56 ;;
        teal) uc_r=15; uc_g=118; uc_b=110; uc_n=30 ;;
        indigo) uc_r=79; uc_g=70; uc_b=229; uc_n=62 ;;
        slate) uc_r=71; uc_g=85; uc_b=105; uc_n=59 ;;
        light) uc_r=248; uc_g=250; uc_b=252; uc_n=231 ;;
        ok) uc_r=74; uc_g=222; uc_b=128; uc_n=78 ;;
        err) uc_r=248; uc_g=113; uc_b=113; uc_n=203 ;;
        *) return 0 ;;
    esac
    if [ "$1" = bg ]; then uc_k=48; else uc_k=38; fi
    case ${COLORTERM:-} in
        truecolor|24bit) printf '%s[%s;2;%s;%s;%sm' "$UI_ESC" "$uc_k" "$uc_r" "$uc_g" "$uc_b" ;;
        *) printf '%s[%s;5;%sm' "$UI_ESC" "$uc_k" "$uc_n" ;;
    esac
}

ui_reset() { [ "$UI_COLOR" = 1 ] && printf '%s[0m' "$UI_ESC"; return 0; }

# ui_seg ROLE TEXT NEXTROLE: one segment of the line, a colored block with the text and, with the powerline glyphs, the arrow into the
# next block (NEXTROLE empty for the last one). Without colors the blocks are separated by a bar.
ui_seg() {
    if [ "$UI_COLOR" = 1 ]; then
        printf '%s%s %s ' "$(ui_c bg "$1")" "$(ui_c fg light)" "$2"
        if [ "$UI_PL" = 1 ]; then
            if [ -n "$3" ]; then printf '%s%s%s' "$(ui_c fg "$1")" "$(ui_c bg "$3")" "$UI_SEP"; else printf '%s%s%s' "${UI_ESC}[0m" "$(ui_c fg "$1")" "$UI_SEP"; fi
        fi
    else
        printf '[ %s ]' "$2"
    fi
}

# ui_bar PCT: the 16 cells of the bar; a negative PCT is a short bright stretch that sweeps along (no total known yet).
ui_bar() {
    ub_w=16
    ub_i=0
    ub_out=
    if [ "$1" -ge 0 ]; then
        ub_f=$(($1 * ub_w / 100))
        while [ "$ub_i" -lt "$ub_w" ]; do
            if [ "$ub_i" -lt "$ub_f" ]; then ub_out=$ub_out$UI_ON; else ub_out=$ub_out$UI_OFF; fi
            ub_i=$((ub_i + 1))
        done
    else
        ub_p=$((ui_tick % (ub_w + 4)))
        while [ "$ub_i" -lt "$ub_w" ]; do
            if [ "$ub_i" -lt "$ub_p" ] && [ "$ub_i" -ge $((ub_p - 4)) ]; then ub_out=$ub_out$UI_ON; else ub_out=$ub_out$UI_OFF; fi
            ub_i=$((ub_i + 1))
        done
    fi
    printf '%s' "$ub_out"
}

# ui_dur SECONDS: 7s, 1m05s.
ui_dur() {
    if [ "$1" -lt 60 ]; then printf '%ss' "$1"; else printf '%sm%02ds' $(($1 / 60)) $(($1 % 60)); fi
}

# ui_total REF: the compressed size, in bytes, of the layers of REF for this machine, read from the registry with curl; nothing when it
# cannot be read (not ghcr.io, a digest, no curl, offline, an answer of another shape): the line then has no percentage. Never fails.
ui_total() {
    case $1 in ghcr.io/*:*) ;; *) return 0 ;; esac
    case $1 in *@*) return 0 ;; esac
    command -v curl > /dev/null 2>&1 || return 0
    ut_r=${1#ghcr.io/}
    ut_tag=${ut_r##*:}
    ut_repo=${ut_r%:*}
    case $(uname -m) in x86_64|amd64) ut_arch=amd64 ;; aarch64|arm64) ut_arch=arm64 ;; *) return 0 ;; esac
    ut_tok=$(curl -fsS -m 4 "https://ghcr.io/token?scope=repository:$ut_repo:pull" 2> /dev/null | sed -n 's/.*"token":"\([^"]*\)".*/\1/p')
    [ -n "$ut_tok" ] || return 0
    ut_acc='Accept: application/vnd.oci.image.index.v1+json, application/vnd.oci.image.manifest.v1+json, application/vnd.docker.distribution.manifest.v2+json, application/vnd.docker.distribution.manifest.list.v2+json'
    ut_doc=$(curl -fsS -m 4 -H "Authorization: Bearer $ut_tok" -H "$ut_acc" "https://ghcr.io/v2/$ut_repo/manifests/$ut_tag" 2> /dev/null | tr -d ' \t\r\n')
    case $ut_doc in
        *'"manifests":['*)
            ut_dg=$(printf '%s' "$ut_doc" | sed 's/{"mediaType"/\
&/g' | grep "\"architecture\":\"$ut_arch\"" | sed -n 's/.*"digest":"\(sha256:[a-f0-9]*\)".*/\1/p' | head -n 1)
            [ -n "$ut_dg" ] || return 0
            ut_doc=$(curl -fsS -m 4 -H "Authorization: Bearer $ut_tok" -H "$ut_acc" "https://ghcr.io/v2/$ut_repo/manifests/$ut_dg" 2> /dev/null | tr -d ' \t\r\n')
            ;;
    esac
    ut_sum=$(printf '%s' "$ut_doc" | sed 's/.*"layers":\[//' | grep -o '"size":[0-9]*' | sed 's/"size"://' | awk '{s+=$1} END{if (NR > 0) printf "%d", s}')
    [ -z "$ut_sum" ] || printf '%s\n' "$ut_sum"
    return 0
}

# ui_pull REF: `podman pull` in the background, with the progress line drawn here until it ends. The bytes are what Podman has
# downloaded so far into its temporary folder (`podman info` says where; the layers are in container_images_storage* there); the total
# is ui_total's, fetched in the background so the pull never waits for it. Podman's own output goes to a file, and the last line of it is
# the reason when the pull fails. Sets PULL_MSG like pull_image.
ui_pull() {
    up_ref=$1
    up_pf=$(mktemp "${TMPDIR:-/tmp}/swarmbox-pull.XXXXXX" 2> /dev/null) || up_pf=/dev/null
    up_tmp=$(podman info --format '{{.Store.ImageCopyTmpDir}}' 2> /dev/null)
    case $up_tmp in /*) ;; *) up_tmp=/var/tmp ;; esac
    up_tf=$up_pf.total
    ( ui_total "$up_ref" > "$up_tf" 2> /dev/null ) &
    up_tp=$!
    podman pull "$up_ref" > /dev/null 2> "$up_pf" &
    UP_BG=$!
    ui_tick=0
    up_t0=$(date +%s)
    up_total=
    up_prev_t=$up_t0
    up_prev_k=0
    up_speed=0
    up_pct=-1
    up_kib=0
    while kill -0 "$UP_BG" 2> /dev/null; do
        ui_tick=$((ui_tick + 1))
        up_now=$(date +%s)
        up_kib=$(du -sk "$up_tmp"/container_images_storage* 2> /dev/null | awk '{s += $1} END{print s + 0}')
        if [ -z "$up_total" ]; then up_total=$(cat "$up_tf" 2> /dev/null); fi
        case $up_total in ''|*[!0-9]*) up_total= ;; esac
        if [ $((up_now - up_prev_t)) -ge 1 ]; then
            up_speed=$(((up_kib - up_prev_k) / (up_now - up_prev_t) / 1024))
            [ "$up_speed" -ge 0 ] || up_speed=0
            up_prev_t=$up_now
            up_prev_k=$up_kib
        fi
        if [ -n "$up_total" ] && [ "$up_total" -gt 0 ]; then
            up_new=$((up_kib * 1024 * 100 / up_total))
            [ "$up_new" -le 99 ] || up_new=99
            [ "$up_new" -le "$up_pct" ] || up_pct=$up_new   # never goes back
        fi
        up_label=pull
        # everything is downloaded (the bar is full, no more bytes arrive): Podman is writing the layers out
        if [ "$up_pct" -ge 95 ] && [ "$up_speed" -eq 0 ]; then up_label=unpack; fi
        ui_draw_pull "$up_pct" "$((up_kib / 1024))" "$up_total" "$up_speed" "$((up_now - up_t0))" "$up_label"
        sleep 0.25 2> /dev/null || sleep 1
    done
    wait "$UP_BG"
    up_rc=$?
    UP_BG=
    kill "$up_tp" 2> /dev/null
    up_el=$(($(date +%s) - up_t0))
    printf '\r%s[K' "$UI_ESC" >&2
    if [ "$up_rc" -eq 0 ]; then
        ui_done_line "$up_ref" "$up_el" "$up_total" >&2
        PULL_MSG=
        rm -f "$up_pf" "$up_tf"
        return 0
    fi
    PULL_MSG=$(tail -n 1 "$up_pf" 2> /dev/null)
    show_err "$up_pf" 3
    rm -f "$up_pf" "$up_tf"
    return 1
}

# ui_draw_pull PCT MB TOTAL SPEED SECONDS LABEL: one redrawn line: [ pull ][ bar and percent ][ MB done/total ][ speed and time ]; LABEL is
# pull, or unpack when the download is over. Narrow terminals drop the right-hand blocks.
ui_draw_pull() {
    if [ "$1" -ge 0 ]; then dp_pct="$1%"; else dp_pct=; fi
    dp_icon=
    [ "$UI_PL" != 1 ] || dp_icon="$UI_ICON "
    dp_mb="$2 MB"
    [ -z "$3" ] || dp_mb="$2/$(($3 / 1000000)) MB"
    dp_line=$(ui_seg violet "${dp_icon}$6" teal)
    dp_line=$dp_line$(ui_seg teal "$(ui_bar "$1") $dp_pct" indigo)
    if [ "$UI_COLS" -ge 56 ]; then dp_line=$dp_line$(ui_seg indigo "$dp_mb" slate); fi
    if [ "$UI_COLS" -ge 72 ]; then dp_line=$dp_line$(ui_seg slate "$4 MB/s $(ui_dur "$5")" ""); fi
    printf '\r%s%s%s[K' "$dp_line" "$(ui_reset)" "$UI_ESC" >&2
}

# ui_done_line REF SECONDS TOTAL: the line that stays when the pull is done.
ui_done_line() {
    dl_what=$(ui_dur "$2")
    [ -z "$3" ] || dl_what="$(($3 / 1000000)) MB in $dl_what"
    printf ' %s%s%s pulled %s (%s)\n' "$(ui_c fg ok)" "$UI_OK" "$(ui_reset)" "$1" "$dl_what"
}

# pull_image REF: pulls the image. For a person at a terminal it draws the progress line (ui_pull); otherwise it is quiet (-q), so a
# script or a log gets no progress bars. When it fails, PULL_MSG says why: the last line of Podman's error.
pull_image() {
    PULL_MSG=
    ui_setup
    if [ "$UI" = 1 ]; then
        ui_pull "$1"
        return
    fi
    if [ -t 2 ]; then   # SWARMBOX_PROGRESS=plain, or a terminal the line cannot draw on: Podman's own bars
        podman pull "$1" > /dev/null && return 0
        PULL_MSG="see the Podman error above"
        return 1
    fi
    podman pull -q "$1" > /dev/null 2> "${UP_ERRF:-/dev/null}" && return 0
    [ -z "${UP_ERRF:-}" ] || PULL_MSG=$(tail -n 1 "$UP_ERRF" 2> /dev/null)
    return 1
}

# A missing image is pulled, never built.
ensure_image() {
    podman image exists "$C_IMAGE" > /dev/null 2>&1 && return 0
    warn "pulling $C_IMAGE (this can take a while)..."
    if ! pull_image "$C_IMAGE"; then
        die 3 "cannot pull $C_IMAGE: $PULL_MSG. Check the network, or set SWARMBOX_IMAGE to an image you already have."
    fi
}

# What `podman container inspect --format` is asked for: state|name|image id|--init|managed|image|ports|env-hash|fingerprint|workspace.
# The workspace is last because a path may contain '|'. Labels come through `index`, which gives "" for a missing one.
LOOKUP_FORMAT='{{.State.Status}}|{{.Name}}|{{.Image}}|{{.HostConfig.Init}}|{{index .Config.Labels "swarmbox.managed"}}|{{index .Config.Labels "swarmbox.image"}}|{{index .Config.Labels "swarmbox.ports"}}|{{index .Config.Labels "swarmbox.env-hash"}}|{{index .Config.Labels "swarmbox.fingerprint"}}|{{index .Config.Labels "swarmbox.workspace"}}'

# One Podman call. Sets BX_FOUND (1 only when the printed name is exactly the box's: Podman also resolves ID prefixes) and BX_*.
find_box() {
    BX_FOUND=0
    if ! u_o=$(podman container inspect --format "$LOOKUP_FORMAT" "$BOX" 2> "$UP_ERRF"); then
        if grep -qi 'no such container' "$UP_ERRF" 2> /dev/null; then return 0; fi
        warn "podman could not look for the box '$BOX':"
        show_err "$UP_ERRF"
        exit 3
    fi
    u_r=$u_o
    BX_STATE=${u_r%%|*}; u_r=${u_r#*|}
    BX_NAME=${u_r%%|*}; u_r=${u_r#*|}
    BX_IMGID=${u_r%%|*}; u_r=${u_r#*|}
    BX_INIT=${u_r%%|*}; u_r=${u_r#*|}
    BX_MANAGED=${u_r%%|*}; u_r=${u_r#*|}
    BX_IMGREF=${u_r%%|*}; u_r=${u_r#*|}
    BX_PUBPORTS=${u_r%%|*}; u_r=${u_r#*|}
    BX_ENVHASH=${u_r%%|*}; u_r=${u_r#*|}
    BX_FP=${u_r%%|*}; u_r=${u_r#*|}
    BX_WS=$u_r
    [ "$BX_NAME" = "$BOX" ] || return 0
    BX_FOUND=1
}

# A container with the box's name and no swarmbox.managed label was not made by SwarmBox: never adopted, started or removed.
# shellcheck disable=SC2016  # the backticks in the message are literal
refuse_foreign() {
    warn "a container named '$BOX' exists that SwarmBox did not make. Remove it with \`podman rm -f $BOX\`, or use another name: SWARMBOX_NAME=<name> swarmbox."
    exit 5
}

# Another box with the label swarmbox.workspace equal to this path. The label filter matches the whole value.
check_workspace_conflict() {
    u_o=$(podman ps -a --filter "label=swarmbox.workspace=$C_WORKSPACE" --format '{{.Names}}' 2> /dev/null) || u_o=
    while IFS= read -r u_n; do
        [ -n "$u_n" ] || continue
        [ "$u_n" = "$BOX" ] || die 5 "workspace $C_WORKSPACE is already used by box '$u_n'."
    done <<CEOF
$u_o
CEOF
}

# INIT=auto becomes 0 or 1 by a throwaway `podman run --rm --init` of the image. INIT_RESOLVED.
resolve_init() {
    case $C_INIT in
        0|1) INIT_RESOLVED=$C_INIT; return 0 ;;
    esac
    if podman run --rm --init --name "$BOX-init-probe-$$" --entrypoint true "$C_IMAGE" > /dev/null 2>&1; then
        INIT_RESOLVED=1
    else
        INIT_RESOLVED=0
        warn "podman cannot run --init here (is catatonit installed?): exited processes will not be reaped."
    fi
}

# The flags of the new box, captured into a file BEFORE `podman run` and the status of create-flags checked: a helper
# failure (4 workspace, 3 missing tool-ports) never reaches Podman. create-flags runs in the background and is waited for, so a
# signal ends this call at once. SWARMBOX_TEST_CREATE_FLAGS replaces the program, for tests.
capture_flags() {
    UP_FLAGS=$STATE_DIR/flags.$$
    rm -f "$UP_FLAGS"   # SR-02
    u_prog=${SWARMBOX_TEST_CREATE_FLAGS:-}
    if [ -z "$u_prog" ]; then
        u_sd=$(self_dir) || die 3 "cannot find the folder of this script."
        u_prog=$u_sd/${0##*/}
    fi
    SWARMBOX_INIT=$INIT_RESOLVED "$u_prog" create-flags > "$UP_FLAGS" &
    UP_BG=$!
    u_rc=0
    wait "$UP_BG" || u_rc=$?
    UP_BG=
    [ "$u_rc" -eq 0 ] || exit "$u_rc"
}

# Everything that can fail before the box is touched: Podman version, tun, the image, the workspace conflict, INIT, the flags.
prepare_create() {
    check_podman_version
    check_tun
    ensure_image
    check_workspace_conflict
    resolve_init
    capture_flags
}

# `podman run -d --name --cidfile <fresh path> <flags> <image> serve`. On failure only the container named by the cidfile is
# removed, by its ID; a container that merely has the name is never removed (podman exits 125 with no cidfile then).
# shellcheck disable=SC2016  # the backticks in the message are literal
create_box() {
    set --
    while IFS= read -r u_l; do set -- "$@" "$u_l"; done < "$UP_FLAGS"
    rm -f "$UP_FLAGS"
    UP_FLAGS=
    # The mount point of the nested-Podman volume (<workspace>/.local/share/containers) is made here, as the user. If Podman made
    # it, it would also make .local and .local/share, owned by the container's root (not by the user), and `serve` could not
    # create its folders under them.
    (umask 022 && mkdir -p "$C_WORKSPACE/.local/share/containers") 2> /dev/null ||
        die 4 "cannot create $C_WORKSPACE/.local/share/containers (the mount point of the nested Podman storage)."
    UP_CIDF=$STATE_DIR/cid.$$
    rm -f "$UP_CIDF"
    if podman run -d --name "$BOX" --cidfile "$UP_CIDF" "$@" "$C_IMAGE" serve > /dev/null 2> "$UP_ERRF"; then
        rm -f "$UP_CIDF"
        UP_CIDF=
        return 0
    fi
    u_id=
    if [ -s "$UP_CIDF" ]; then IFS= read -r u_id < "$UP_CIDF" || true; fi
    case $u_id in
        ''|*[!0-9a-f]*) ;;
        *) podman rm -f "$u_id" > /dev/null 2>&1 || true ;;
    esac
    rm -f "$UP_CIDF"
    UP_CIDF=
    warn "could not create the box:"
    show_err "$UP_ERRF"
    port_hint up || die 7 "If a port is in use, change WEB_PORT or PORTS with \`swarmbox config set\`."
    exit 7
}

# When Podman says a port is busy and it is the web port, name the command that fixes it.
# shellcheck disable=SC2016  # the backticks in the message are literal
port_hint() {
    grep -qi 'address already in use' "$UP_ERRF" 2> /dev/null || return 1
    grep -q ":$C_WEB_PORT:" "$UP_ERRF" 2> /dev/null || return 1
    warn "the web port $C_WEB_PORT is busy. Try another: \`swarmbox config set WEB_PORT $((C_WEB_PORT + 1))\`, then run \`swarmbox $1\`."
}

start_box() {
    if ! podman start "$BOX" > /dev/null 2> "$UP_ERRF"; then
        warn "could not start the box:"
        show_err "$UP_ERRF"
        port_hint reset && exit 7
        die 7 "Nothing was changed; the box '$BOX' is still there. If a port is in use, change WEB_PORT or PORTS and run \`swarmbox reset\`."
    fi
}

# Polls the marker with `podman exec` and, only when that fails, the container state: a box that has exited stops the wait at
# once (exit 6, with the log), instead of hiding the cause behind the timeout.
# shellcheck disable=SC2016  # the backticks in the messages are literal
wait_ready() {
    u_tries=${SWARMBOX_TEST_READY_TRIES:-60}
    u_nap=${SWARMBOX_TEST_NAP:-1}
    u_i=0
    while :; do
        u_i=$((u_i + 1))
        if u_m=$(podman exec "$BOX" cat /tmp/swarmbox/ready 2> /dev/null); then
            case $u_m in
                warnings=*)
                    warn "the box is ready, with ${u_m#warnings=} warning(s):"
                    podman exec "$BOX" bash -c '. /usr/local/lib/swarmbox/dirs.sh && cat "$SB_HEALTH_FILE"' 2> /dev/null | sed 's/^/    /' >&2
                    ;;
            esac
            return 0
        fi
        u_st=$(podman container inspect --format '{{.State.Status}}' "$BOX" 2> /dev/null) || u_st=gone
        case $u_st in
            running|created|configured|initialized|paused) ;;
            *)
                warn "the box exited while starting (state: $u_st); the last lines of its log:"
                podman logs --tail 20 "$BOX" 2>&1 | sed 's/^/    /' >&2
                exit 6
                ;;
        esac
        if [ "$u_i" -ge "$u_tries" ]; then
            warn "the box is running but never wrote its readiness marker; the last lines of its log:"
            podman logs --tail 15 "$BOX" 2>&1 | sed 's/^/    /' >&2
            if [ "$u_nap" = 1 ]; then
                die 6 "the box did not become ready in $u_tries s; see \`podman logs $BOX\`"
            fi
            die 6 "the box did not become ready in $u_tries polls of $u_nap s; see \`podman logs $BOX\`"
        fi
        nap
    done
}

# The warnings of an entry: the fingerprint differences, named per key where a label allows it, and a local image that was
# replaced since the box was created. They never block. The box's INIT is what it was created with when the config says auto.
entry_warnings() {
    if [ -n "$BX_FP" ]; then
        if [ "$C_INIT" = auto ]; then
            case $BX_INIT in
                true) C_INIT=1 ;;
                *) C_INIT=0 ;;
            esac
        fi
        compute_fingerprint
        if [ "$BX_FP" != "$FP" ]; then
            LABELS="swarmbox.image=$BX_IMGREF${NL}swarmbox.workspace=$BX_WS${NL}swarmbox.ports=$BX_PUBPORTS${NL}swarmbox.env-hash=$BX_ENVHASH${NL}"
            u_ex=$(fp_explain)
            while IFS= read -r u_x; do
                [ -z "$u_x" ] || warn "$u_x"
            done <<WEOF
$u_ex
WEOF
        fi
    fi
    u_ref=${BX_IMGREF:-$C_IMAGE}
    u_cur=$(podman image inspect --format '{{.Id}}' "$u_ref" 2> /dev/null) || u_cur=
    u_cur=${u_cur#sha256:}
    u_old=${BX_IMGID#sha256:}
    if [ -n "$u_cur" ] && [ -n "$u_old" ] && [ "$u_cur" != "$u_old" ]; then
        warn "the image $u_ref is newer than the one this box runs; run \`swarmbox reset\` to use it (running sessions end)."
    fi
}

# A stale lock is removed only after the folder has been moved away (an atomic rename) and its pid file, read again, is still the
# one that was seen dead (or still absent): a live lock that another call made in between is put back.
reap_stale() {
    u_rs=$UP_LOCK.stale.$$
    mv "$UP_LOCK" "$u_rs" 2> /dev/null || return 0
    u_q=
    if [ -r "$u_rs/pid" ]; then IFS= read -r u_q < "$u_rs/pid" || true; fi
    if [ "$u_q" = "$1" ]; then
        rm -rf "$u_rs"
    else
        mv "$u_rs" "$UP_LOCK" 2> /dev/null || true
    fi
}

# The host lock: an atomic mkdir, with the pid of the holder in a file. Stale when that pid does not answer `kill -0`, or
# when no pid file appeared within LOCK_PIDWAIT polls (5 s); a live holder is waited for up to LOCK_TRIES polls (90 s), then exit 6.
acquire_lock() {
    UP_LOCK=$STATE_DIR/up-$BOX.lock
    u_tries=${SWARMBOX_TEST_LOCK_TRIES:-90}
    u_pidwait=${SWARMBOX_TEST_LOCK_PIDWAIT:-5}
    u_n=0
    u_nopid=0
    u_fail=0
    until mkdir "$UP_LOCK" 2> /dev/null; do
        if [ ! -d "$UP_LOCK" ]; then   # not there and not creatable: a permission problem (or the holder just left)
            u_fail=$((u_fail + 1))
            [ "$u_fail" -le 5 ] || die 4 "cannot create the lock $UP_LOCK."
            continue
        fi
        u_p=
        if [ -r "$UP_LOCK/pid" ]; then IFS= read -r u_p < "$UP_LOCK/pid" || true; fi
        case $u_p in
            *[!0-9]*) u_p= ;;
        esac
        if [ -n "$u_p" ]; then
            u_nopid=0
            if ! kill -0 "$u_p" 2> /dev/null; then
                reap_stale "$u_p"
                continue
            fi
        else
            u_nopid=$((u_nopid + 1))
            if [ "$u_nopid" -gt "$u_pidwait" ]; then
                reap_stale ""
                u_nopid=0
                continue
            fi
        fi
        u_n=$((u_n + 1))
        if [ "$u_n" -gt "$u_tries" ]; then
            die 6 "another 'up' holds $UP_LOCK (pid ${u_p:-unknown}); if no swarmbox command is running, remove that folder."
        fi
        nap
    done
    UP_LOCK_HELD=1
    printf '%s\n' "$$" > "$UP_LOCK/pid"
    sweep_state
}

# Temporary files (flags.<pid>, cid.<pid>, err.<pid>) that a call killed with SIGKILL left behind: removed when the pid in the
# name is gone. Only done under the lock, so a live call of this box is never disturbed (another box's files are not touched
# either: a pid that answers is left alone).
sweep_state() {
    for u_f in "$STATE_DIR"/flags.* "$STATE_DIR"/cid.* "$STATE_DIR"/err.* "$STATE_DIR"/up-"$BOX".lock.stale.*; do
        [ -e "$u_f" ] || continue
        u_pid=${u_f##*.}
        case $u_pid in
            ''|*[!0-9]*) continue ;;
        esac
        [ "$u_pid" != "$$" ] || continue
        kill -0 "$u_pid" 2> /dev/null || rm -rf "$u_f"
    done
}

# ---------------------------------------------------------------- the host connection `podman -c <name>`

SOCK_LIMIT=100   # characters of path counted in bytes: the AF_UNIX limit is 107, minus a margin for macOS and the BSDs (104)

byte_len() { printf '%s' "$1" | wc -c | tr -d ' \t'; }   # wc -c counts bytes, whatever the locale

# The path the connection will use for the workspace $1: SOCK_PATH (what is registered), SOCK_TARGET (the workspace state
# folder) and SOCK_LINK (the symlink, empty when the direct path is short enough). No side effect.
# shellcheck disable=SC2016  # the backticks in the message are literal
sock_plan() {
    SOCK_TARGET=$1/.local/state/swarmbox
    SOCK_PATH=$SOCK_TARGET/podman.sock
    SOCK_LINK=
    [ "$(byte_len "$SOCK_PATH")" -gt "$SOCK_LIMIT" ] || return 0
    SOCK_LINK=$STATE_DIR/$BOX.sock-dir
    SOCK_PATH=$SOCK_LINK/podman.sock
    [ "$(byte_len "$SOCK_PATH")" -le "$SOCK_LIMIT" ] || die 4 "cannot make a short path to the Podman socket (workspace $1 is too deep). Choose a shorter workspace path with \`swarmbox config set WORKSPACE\`."
}

# Create or refresh the symlink: a correct link stays, a wrong target is relinked, anything that is not a symlink is refused
# (exit 4) and left in place.
sock_link() {
    [ -n "$SOCK_LINK" ] || return 0
    if [ -L "$SOCK_LINK" ]; then
        [ "$(readlink "$SOCK_LINK")" != "$SOCK_TARGET" ] || return 0
        rm -f "$SOCK_LINK" || die 4 "cannot replace the symlink $SOCK_LINK."
    elif [ -e "$SOCK_LINK" ]; then
        die 4 "cannot make a short path to the Podman socket: $SOCK_LINK exists and is not a symlink. Move it away."
    fi
    ln -s "$SOCK_TARGET" "$SOCK_LINK" || die 4 "cannot make the symlink $SOCK_LINK."
}

# Register the connection named like the box (only that name is ever read, replaced or removed). Idempotent: one `list`, and
# `remove` + `add` only when the address differs. A
# failure to register is a warning, never an exit: the box works without the host connection.
sock_register() {
    sr_uri=unix://$SOCK_PATH
    if ! sr_out=$(podman system connection list --format '{{.Name}} {{.URI}}' 2> /dev/null); then
        warn "could not list the Podman connections; 'podman -c $BOX' was not registered."
        return 0
    fi
    sr_cur=$(printf '%s\n' "$sr_out" | awk -v n="$BOX" 'index($0, n " ") == 1 { print substr($0, length(n) + 2); exit }')
    [ "$sr_cur" != "$sr_uri" ] || return 0
    if [ -n "$sr_cur" ]; then
        podman system connection remove "$BOX" > /dev/null 2>&1 || true
    fi
    podman system connection add "$BOX" "$sr_uri" > /dev/null 2>&1 || warn "could not register the Podman connection '$BOX'."
    return 0
}

# Linux and WSL only: unix sockets do not cross the macOS VM [unverified: no macOS here].
host_connection_wanted() { [ "${SWARMBOX_TEST_OS:-$(uname -s)}" != Darwin ]; }

# Before a box is created: the exit 4 for a workspace too deep comes before anything is made.
host_connection_prepare() {
    host_connection_wanted || return 0
    sock_plan "$1"
    sock_link
}

host_connection() {
    host_connection_wanted || return 0
    sock_plan "$1"
    sock_link
    sock_register
}

# `swarmbox-host connection`: the same step on its own (no lock, no box); prints the registered URI.
cmd_connection() {
    [ $# -eq 0 ] || usage
    need_podman
    load_creation 0
    host_connection_wanted || return 0
    private_dir "$STATE_DIR" || die 4 "cannot create $STATE_DIR."
    host_connection "$C_WORKSPACE"
    printf 'unix://%s\n' "$SOCK_PATH"
}

# up (RESET=0) and reset (RESET=1).
up_main() {
    RESET=$1
    need_podman
    need_sha256
    load_tool_ports
    WARN_PORTS=0
    load_creation 0
    ensure_state_dir
    up_traps
    acquire_lock
    find_box
    if [ "$BX_FOUND" = 1 ]; then
        [ -n "$BX_MANAGED" ] || refuse_foreign
        if [ "$RESET" = 1 ]; then
            host_connection_prepare "$C_WORKSPACE"
            prepare_create
            podman rm -f "$BOX" > /dev/null 2> "$UP_ERRF" || {
                warn "could not remove the box '$BOX':"
                show_err "$UP_ERRF"
                exit 1
            }
            create_box
            wait_ready
            return 0
        fi
        entry_warnings
        [ "$BX_STATE" != running ] || return 0   # the fast path: one inspect, and at most one image inspect
        check_podman_version
        check_tun
        start_box
        wait_ready
        return 0
    fi
    host_connection_prepare "$C_WORKSPACE"
    prepare_create
    create_box
    wait_ready
}

# ---------------------------------------------------------------- the Cloudflare connector on every entry

# Pinned. The single source in the helper; tests/test_host_connector.py checks that it equals DEFAULT_CONNECTOR_IMAGE of
# cloudflare-setup.py. SWARMBOX_CLOUDFLARED_IMAGE overrides it (environment only: the config table has no file key).
# CONNECTOR_NAME is set by load_defaults: <default name>-cloudflared, one per host.
CONNECTOR_IMAGE_DEFAULT=docker.io/cloudflare/cloudflared:2026.10.7

# After `up`, under the lock, when the box is ready. Does nothing (no Podman call at all) unless WEB is 1 and a tunnel token
# resolves (environment, or the config key with mode 600). One connector per host: the name is fixed, whatever the box name
# (a second box adds an ingress hostname to the same tunnel). The token only goes through the environment of
# `podman run` (`-e TUNNEL_TOKEN`), never an argument. Every failure is a warning: the box works without the connector and the
# exit code of `up` stays what it was. Exact name: the printed name is compared, because Podman resolves ID prefixes.
connector_ensure() {
    [ "$C_WEB" = 1 ] || return 0
    resolve_tunnel_token || return 0
    cn_img=${SWARMBOX_CLOUDFLARED_IMAGE:-$CONNECTOR_IMAGE_DEFAULT}
    if ! valid_image_ref "$cn_img"; then
        warn "SWARMBOX_CLOUDFLARED_IMAGE is not an image reference (letters, digits and '.', '_', '/', ':', '@', '-' only, not starting with '-'); the connector was not started."
        return 0
    fi
    cn_state=missing
    if cn_o=$(podman container inspect --format '{{.Name}}|{{.State.Running}}|{{range .Config.Env}}{{println .}}{{end}}' "$CONNECTOR_NAME" 2> "$UP_ERRF"); then
        cn_n=${cn_o%%|*}
        if [ "$cn_n" = "$CONNECTOR_NAME" ]; then
            cn_r=${cn_o#*|}
            cn_run=${cn_r%%|*}
            cn_env=${cn_r#*|}
            cn_state=stopped
            case "$NL$cn_env$NL" in
                *"${NL}TUNNEL_TOKEN=$TUNNEL_TOKEN${NL}"*)
                    [ "$cn_run" != true ] || return 0   # the fast path: one inspect
                    cn_state=same-stopped ;;
            esac
        fi
    elif ! grep -qi 'no such container' "$UP_ERRF" 2> /dev/null; then
        warn "podman could not look for the connector '$CONNECTOR_NAME'; it was not started:"
        show_err "$UP_ERRF"
        return 0
    fi
    if [ "$cn_state" = same-stopped ]; then
        if podman start "$CONNECTOR_NAME" > /dev/null 2> "$UP_ERRF"; then return 0; fi
        warn "could not start the connector '$CONNECTOR_NAME':"
        show_err "$UP_ERRF"
        return 0
    fi
    if [ "$cn_state" = stopped ]; then   # another token: recreate
        if ! podman rm -f "$CONNECTOR_NAME" > /dev/null 2> "$UP_ERRF"; then
            warn "could not remove the old connector '$CONNECTOR_NAME':"
            show_err "$UP_ERRF"
            return 0
        fi
    fi
    # --user root: in rootless Podman that is only your own user; it avoids needing the image's own user (65532) to be mappable.
    if ! TUNNEL_TOKEN=$TUNNEL_TOKEN podman run -d --name "$CONNECTOR_NAME" --restart=always --network=host --user root \
        -e TUNNEL_TOKEN "$cn_img" tunnel --no-autoupdate run > /dev/null 2> "$UP_ERRF"; then
        warn "could not start the connector '$CONNECTOR_NAME' (the box is running; 'swarmbox remote status' shows the rest):"
        show_err "$UP_ERRF"
    fi
    return 0
}

# Step 6 runs under the lock, after the box is ready (up_main exits on every failure before it); the workspace is the box's own.
cmd_up() {
    [ $# -eq 0 ] || usage
    up_main 0
    host_connection "${BX_WS:-$C_WORKSPACE}"
    connector_ensure
}

cmd_reset() {
    [ $# -eq 0 ] || usage
    up_main 1
    host_connection "$C_WORKSPACE"
}

# shellcheck disable=SC2016  # the backticks in the message are literal
cmd_stop() {
    [ $# -eq 0 ] || usage
    need_podman
    init_paths
    ensure_state_dir
    up_traps
    find_box
    if [ "$BX_FOUND" = 0 ]; then
        warn "no box named '$BOX'; nothing to stop."
        return 0
    fi
    [ -n "$BX_MANAGED" ] || refuse_foreign
    if ! podman stop "$BOX" > /dev/null 2> "$UP_ERRF"; then
        warn "could not stop the box '$BOX':"
        show_err "$UP_ERRF"
        exit 1
    fi
}

# ---------------------------------------------------------------- update

# A tag as Podman reads it: letters, digits, '_', '.', '-', at most 128 characters, not starting with '.' or '-'.
valid_tag() {
    case $1 in
        ''|[!A-Za-z0-9_]*|*[!A-Za-z0-9_.-]*) return 1 ;;
    esac
    [ "$(byte_len "$1")" -le 128 ]
}

# Splits an image reference into IR_REPO, IR_TAG (empty when there is none) and IR_DIGEST (1 when it carries @sha256:...). The
# colon of a registry port is not a tag separator: a tag is a ':' in the last path component only.
split_image() {
    IR_DIGEST=0
    _ref=$1
    case $_ref in
        *@*) IR_DIGEST=1; _ref=${_ref%%@*} ;;
    esac
    _last=${_ref##*/}
    case $_last in
        *:*) IR_TAG=${_last#*:}; IR_REPO=${_ref%":$IR_TAG"} ;;
        *) IR_TAG=; IR_REPO=$_ref ;;
    esac
}

# The series (X.Y) of a tag that starts with two numbers: 2.0.1 gives 2.0, 2.1 gives 2.1, 3.4.5-rc1 gives 3.4.
series_of() {
    case $1 in
        [0-9]*.[0-9]*) ;;
        *) return 1 ;;
    esac
    _x=${1%%.*}
    _rest=${1#*.}
    _y=${_rest%%[!0-9]*}
    case $_x$_y in *[!0-9]*|'') return 1 ;; esac
    case $_x in *[!0-9]*) return 1 ;; esac
    # the character after the minor number must end the tag or start the patch or a suffix
    _after=${_rest#"$_y"}
    case $_after in ''|.*|-*) ;; *) return 1 ;; esac
    SERIES=$_x.$_y
}

# archive_safe FILE: refuses a helper archive that has an absolute member name, a '..' component, or a member that is not a plain
# file or folder (a symlink, a hard link, a device): extraction then cannot write outside the temporary folder and cannot leave a
# link behind, whatever the local tar does by default (security review SR-05). Member names are listed twice (names, then types).
archive_safe() {
    _an=$(tar -tf "$1" 2> /dev/null) || return 1
    case "$NL$_an$NL" in
        *"$NL/"*|*"$NL../"*|*"/../"*|*"/.."$NL*|*"$NL.."$NL*) return 1 ;;
    esac
    _av=$(tar -tvf "$1" 2> /dev/null) || return 1
    while IFS= read -r _al; do
        case $_al in
            *' link to '*) return 1 ;;   # a hard link as bsdtar lists it
            -*|d*|'') ;;
            *) return 1 ;;
        esac
    done <<AEOF
$_av
AEOF
    return 0
}

# ver_newer A B: succeeds when version A is newer than version B. X.Y.Z as numbers (2.0.10 is newer than 2.0.9). When the
# numbers are equal, a final version is newer than its prerelease (2.0.0 over 2.0.0-beta.1) and prereleases order as
# beta.N < rc.N, then by N (-beta.2 over -beta.1, -rc.1 over -beta.9). Any other suffix is treated as equal.
ver_newer() {
    _va=${1%%[!0-9.]*}
    _vb=${2%%[!0-9.]*}
    _pa=${1#"$_va"}
    _pb=${2#"$_vb"}
    _vi=0
    while [ "$_vi" -lt 3 ]; do
        _vx=${_va%%.*}
        _vy=${_vb%%.*}
        case $_va in *.*) _va=${_va#*.} ;; *) _va=0 ;; esac
        case $_vb in *.*) _vb=${_vb#*.} ;; *) _vb=0 ;; esac
        _vx=${_vx:-0}
        _vy=${_vy:-0}
        [ "$_vx" -gt "$_vy" ] && return 0
        [ "$_vx" -lt "$_vy" ] && return 1
        _vi=$((_vi + 1))
    done
    # Equal numbers: compare the prerelease parts (-beta.N, -rc.N) or their absence.
    case $_pa in -beta.[0-9]* | -rc.[0-9]*) ;; *) _pa="" ;; esac
    case $_pb in -beta.[0-9]* | -rc.[0-9]*) ;; *) _pb="" ;; esac
    [ "$_pa" = "$_pb" ] && return 1
    [ -z "$_pa" ] && return 0
    [ -z "$_pb" ] && return 1
    _ka=${_pa#-}; _ka=${_ka%%.*}
    _kb=${_pb#-}; _kb=${_kb%%.*}
    if [ "$_ka" != "$_kb" ]; then [ "$_ka" = rc ] && return 0; return 1; fi
    _na=${_pa##*.}
    _nb=${_pb##*.}
    case $_na$_nb in *[!0-9]*) return 1 ;; esac
    [ "$_na" -gt "$_nb" ]
}

# fetch_helper REF: unpacks the helper archive of the image (`podman run --rm REF host-helper`: this script, VERSION, DEFAULTS,
# cloudflare-setup.py, tool-ports) into a new folder next to the support folder. Sets FH_TMP (the folder, removed by the EXIT
# trap up_update_cleanup unless it is moved) and FH_VER (the version the archive's script reports). The archive goes to a file,
# is checked, unpacked, and the result is tested (no pipe: a pipe's status is the last command's). Exits 3, changing nothing.
fetch_helper() {
    fh_ref=$1
    data_host_dir
    private_dir "${DATA_HOST%/*}" || die 3 "cannot make ${DATA_HOST%/*}."
    FH_TMP=$(mktemp -d "$DATA_HOST.new.XXXXXX" 2> /dev/null) || FH_TMP=
    if [ -z "$FH_TMP" ] || [ ! -d "$FH_TMP" ]; then die 3 "cannot make a temporary folder next to $DATA_HOST."; fi
    UP_TMPDIR=$FH_TMP
    fh_msg=
    if podman run --rm "$fh_ref" host-helper > "$FH_TMP/helper.tar" 2> "$FH_TMP/podman.err"; then
        if archive_safe "$FH_TMP/helper.tar" && tar -x -C "$FH_TMP" -f "$FH_TMP/helper.tar" > /dev/null 2>&1 && [ -x "$FH_TMP/swarmbox-host" ]; then
            fh_msg=
        else
            fh_msg="the image has no usable host helper"
        fi
    else
        fh_msg=$(tail -n 1 "$FH_TMP/podman.err" 2> /dev/null)
        fh_msg=${fh_msg:-"podman failed"}
    fi
    [ -z "$fh_msg" ] || die 3 "cannot read the host helper from $fh_ref: $fh_msg. Nothing was changed. Check the network, or the image name."
    rm -f "$FH_TMP/helper.tar" "$FH_TMP/podman.err"
    FH_VER=$("$FH_TMP/swarmbox-host" version 2> /dev/null | head -n 1)
    case $FH_VER in
        *[!0-9A-Za-z.+-]*) FH_VER= ;;
        [0-9]*.[0-9]*.[0-9]*) ;;
        *) FH_VER= ;;
    esac
    [ -n "$FH_VER" ] || die 3 "the host helper in $fh_ref does not report a version (X.Y.Z). Nothing was changed."
}

# swap_support: the folder of fetch_helper becomes the support folder (renamed over the old one, which is removed); this script's
# own copy in it is deleted (the script is the file that runs, not a copy in the data folder).
swap_support() {
    rm -f "$FH_TMP/swarmbox-host"
    rm -rf "$DATA_HOST.old"
    if [ -e "$DATA_HOST" ] || [ -L "$DATA_HOST" ]; then
        mv "$DATA_HOST" "$DATA_HOST.old" || die 3 "cannot replace the support files in $DATA_HOST."
    fi
    if ! mv "$FH_TMP" "$DATA_HOST"; then
        mv "$DATA_HOST.old" "$DATA_HOST" 2> /dev/null
        die 3 "cannot replace the support files in $DATA_HOST."
    fi
    UP_TMPDIR=
    rm -rf "$DATA_HOST.old"
}

# update [--to TAG]. The order matters: the helper is extracted and its version read into a temporary folder, the local tag is
# made, and only then the folder is renamed over the old support files, this script is replaced (atomically, never by an older
# one) and the config written, so a failing `podman tag` leaves everything as it was.
# shellcheck disable=SC2016  # the backticks in the messages are literal
cmd_update() {
    up_to=
    up_to_set=0
    while [ $# -gt 0 ]; do
        case $1 in
            --to|--to=*)
                [ "$up_to_set" = 0 ] || usage
                opt_arg --to "$@"
                up_to=$OPT_V; up_to_set=1; shift "$OPT_N" ;;
            *) usage ;;
        esac
    done
    if [ "$up_to_set" = 1 ]; then
        valid_tag "$up_to" || die 2 "update: invalid tag '$up_to': a tag uses letters, digits, '_', '.' and '-' (at most 128, not starting with '.' or '-')."
    fi
    init_paths
    cfg_prepare
    resolve_valid IMAGE
    up_cur=$R_VAL
    up_src=$R_SRC
    split_image "$up_cur"
    up_repo=$IR_REPO
    if [ "$up_to_set" = 1 ]; then
        up_tag=$up_to
    else
        [ "$IR_DIGEST" = 0 ] || die 2 "IMAGE ($up_cur) is pinned by a digest, so there is no series to follow. Use \`swarmbox update --to TAG\`."
        series_of "$IR_TAG" || die 2 "IMAGE ($up_cur) has no X.Y version tag, so there is no series to follow. Use \`swarmbox update --to TAG\`."
        up_tag=$SERIES
    fi
    up_ref=$up_repo:$up_tag
    need_podman
    ensure_state_dir
    up_traps
    trap 'up_update_cleanup' EXIT
    warn "pulling $up_ref (this can take a while)..."
    if ! pull_image "$up_ref"; then
        die 3 "cannot pull $up_ref: ${PULL_MSG:-podman failed}. Nothing was changed. Check the network and the tag."
    fi
    fetch_helper "$up_ref"
    up_ver=$FH_VER
    case $up_tag in
        [0-9]*.[0-9]*.[0-9]*)   # an exact tag must be the version it holds, or the local tag would lie
            [ "$up_ver" = "$up_tag" ] || die 3 "the image $up_ref holds version $up_ver, not $up_tag. Nothing was changed."
            ;;
    esac
    if [ "$up_ver" != "$up_tag" ]; then
        if ! podman tag "$up_ref" "$up_repo:$up_ver" > /dev/null 2> "$UP_ERRF"; then
            up_m=$(tail -n 1 "$UP_ERRF" 2> /dev/null)
            die 3 "cannot tag $up_ref as $up_repo:$up_ver: ${up_m:-podman failed}. Nothing was changed."
        fi
    fi
    prepare_script_refresh "$FH_TMP/swarmbox-host" "$up_ver"
    swap_support
    refresh_script
    cfg_write_keys IMAGE "$up_repo:$up_ver"
    if [ "$up_src" = env ]; then
        warn "SWARMBOX_IMAGE is set ($up_cur) and overrides the IMAGE written to $CFG_FILE."
    fi
    printf 'updated to %s; run `swarmbox reset` to use it (running sessions end)\n' "$up_ver"
}

# prepare_script_refresh NEWFILE VERSION: copies the script of the image next to this script, ready to be renamed over it
# (refresh_script). Nothing when this script runs from a folder that holds a VERSION file (a checkout, the tests: the file is not
# an installed copy), when the image's script is not newer than this one (a newer script is never replaced by an older one, and
# the same version has nothing to replace), or when the folder cannot be written (a warning).
# shellcheck disable=SC2016  # the backticks in the messages are literal
prepare_script_refresh() {
    NEW_BIN=
    _sd=$(self_dir) || return 0
    [ ! -r "$_sd/VERSION" ] || return 0
    if [ "$2" = "$SCRIPT_VERSION" ]; then return 0; fi
    if ! ver_newer "$2" "$SCRIPT_VERSION"; then
        warn "this script ($SCRIPT_VERSION) is newer than the image ($2); the script is kept."
        return 0
    fi
    _nb=$_sd/.${0##*/}.new.$$
    rm -f "$_nb"
    if cp "$1" "$_nb" 2> /dev/null && chmod 755 "$_nb" 2> /dev/null; then
        NEW_BIN=$_nb
    else
        rm -f "$_nb"
        warn "cannot write next to this script ($_sd); it stays $SCRIPT_VERSION. Run the installer again to replace it."
    fi
}

refresh_script() {
    [ -n "$NEW_BIN" ] || return 0
    if mv -f "$NEW_BIN" "$(self_dir)/${0##*/}" 2> /dev/null; then
        NEW_BIN=
    else
        warn "cannot replace this script; it stays $SCRIPT_VERSION. Run the installer again."
    fi
}

NEW_BIN=
FH_TMP=
UP_TMPDIR=
up_update_cleanup() {
    [ -z "$UP_TMPDIR" ] || rm -rf "$UP_TMPDIR"
    [ -z "$NEW_BIN" ] || rm -f "$NEW_BIN"
    up_cleanup
}

# A hostname for the public URL: letters, digits, dots and hyphens only (it ends up in a URL that is printed).
valid_public_host() {
    case $1 in
        ''|[!A-Za-z0-9]*|*[!A-Za-z0-9.-]*) return 1 ;;
    esac
    return 0
}

# One string value of the script's cloudflare.json (indented JSON, one key per line), read with sed; first match, no JSON parser.
url_json_key() {
    sed -n 's/^[[:space:]]*"'"$1"'"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' "$CFG_ROOT/cloudflare.json" 2> /dev/null | head -n 1
}

# The public host name `url` and `remote status` print (empty: none): SWARMBOX_WEB_HOSTNAME, else <name>.<domain> with the domain
# from SWARMBOX_WEB_DOMAIN or from the script's cloudflare.json. That file counts only when it was saved for this box (its "name"
# is the box name), so a box that was never exposed prints nothing; its saved host name wins inside the same domain. Sets u_host.
public_host() {
    u_host=${SWARMBOX_WEB_HOSTNAME:-}
    if [ -n "$u_host" ]; then
        valid_public_host "$u_host" && return 0
        warn "ignoring the host name '$u_host' (not a host name)."
        u_host=
        return 0
    fi
    u_dom=${SWARMBOX_WEB_DOMAIN:-}
    u_saved=
    if [ -r "$CFG_ROOT/cloudflare.json" ] && [ "$(url_json_key name)" = "$BOX" ]; then
        [ -n "$u_dom" ] || u_dom=$(url_json_key domain)
        u_saved=$(url_json_key hostname)
    fi
    u_dom=${u_dom%.}
    [ -n "$u_dom" ] || return 0
    valid_public_host "$u_dom" || { warn "ignoring the domain '$u_dom' (not a host name)."; return 0; }
    u_host=$BOX.$u_dom
    [ -n "$u_saved" ] || return 0
    valid_public_host "$u_saved" || { warn "ignoring the saved host name '$u_saved' (not a host name)."; return 0; }
    case $u_saved in
        "$u_dom"|*."$u_dom") u_host=$u_saved ;;
    esac
}

# url: the local URL, and the public one when remote access is configured. It never calls Podman.
cmd_url() {
    [ $# -eq 0 ] || usage
    init_paths
    cfg_prepare
    resolve_valid WEB
    [ "$R_VAL" = 1 ] || die 1 "the web terminal is off (WEB=0), so there is no URL. Run \`swarmbox config set WEB 1\` and \`swarmbox reset\` to turn it on."
    resolve_valid WEB_PORT
    printf 'http://127.0.0.1:%s\n' "$R_VAL"
    public_host
    [ -z "$u_host" ] || printf 'https://%s\n' "$u_host"
    return 0
}

# remote setup|status|off|token [options]: runs cloudflare-setup.py of the support folder. setup is its `apply`, off is its `remove`. The user's options come last,
# so they win over the two defaults added here (--name from SWARMBOX_NAME, --port from WEB_PORT). XDG_CONFIG_HOME is set to
# the folder CFG_ROOT lives in, so the script's cloudflare.json is the file `url` reads. No secret travels on argv: the API token
# stays in the environment the script inherits; no command of the script reads the tunnel token (it asks the API for it), so
# SWARMBOX_CLOUDFLARE_TUNNEL_TOKEN is removed from the script's environment.
cmd_remote() {
    [ $# -ge 1 ] || usage
    r_sub=$1
    shift
    case $r_sub in
        setup) r_cmd=apply ;;
        status) r_cmd=status ;;
        off) r_cmd=remove ;;
        token) r_cmd=token ;;
        *) usage ;;
    esac
    command -v python3 > /dev/null 2>&1 || die 3 "python3 is needed for 'swarmbox remote' and was not found."
    init_paths
    cfg_prepare
    needs_support cloudflare-setup.py
    r_script=$SUPPORT/cloudflare-setup.py
    resolve_valid WEB_PORT
    r_port=$R_VAL
    XDG_CONFIG_HOME=${CFG_ROOT%/swarmbox}
    export XDG_CONFIG_HOME
    # asked before the variable is removed from the script's environment (setup only offers to store a token when none exists)
    r_have=0
    ! resolve_tunnel_token || r_have=1
    TUNNEL_TOKEN=
    unset SWARMBOX_CLOUDFLARE_TUNNEL_TOKEN
    if [ "$r_sub" = status ]; then
        r_rc=0
        python3 "$r_script" status --name "$BOX" --port "$r_port" "$@" || r_rc=$?
        [ "$r_rc" -eq 2 ] || remote_host_lines
        exit "$r_rc"
    fi
    if [ "$r_sub" != setup ]; then
        exec python3 "$r_script" "$r_cmd" --name "$BOX" --port "$r_port" "$@"
    fi
    r_dry=0
    for r_a in "$@"; do
        [ "$r_a" != --dry-run ] || r_dry=1
    done
    r_rc=0
    python3 "$r_script" "$r_cmd" --name "$BOX" --port "$r_port" "$@" || r_rc=$?
    if [ "$r_rc" -eq 0 ] && [ "$r_dry" = 0 ] && [ "$r_have" = 0 ] && [ -t 0 ] && [ -t 2 ]; then
        remote_token_epilogue "$r_script" "$r_port" "$@"
    fi
    exit "$r_rc"
}

# The host side of `remote status`: the public name, the connector and the login length. The script's status is read-only and
# needs the API token; these lines need neither. The connector is asked with one inspect of the exact name; a missing podman or any
# answer that is not "no such container" is "unknown", never an error (the exit code is the script's).
remote_host_lines() {
    public_host 2> /dev/null
    printf '\nOn this host:\n'
    if [ -n "$u_host" ]; then
        printf '  public address: https://%s\n' "$u_host"
    else
        printf '  public address: none configured\n'
    fi
    if command -v podman > /dev/null 2>&1; then
        h_rc=0
        h_o=$(podman container inspect --format '{{.Name}}|{{.State.Running}}' "$CONNECTOR_NAME" 2>&1) || h_rc=$?
        if [ "$h_rc" -eq 0 ]; then
            case $h_o in
                "$CONNECTOR_NAME|true") printf '  connector: running (container %s)\n' "$CONNECTOR_NAME" ;;
                "$CONNECTOR_NAME|false") printf '  connector: not running (container %s is stopped; run swarmbox up)\n' "$CONNECTOR_NAME" ;;
                *) printf '  connector: unknown (unexpected answer from podman)\n' ;;
            esac
        else
            case $h_o in
                *[Nn]o\ such\ container*) printf '  connector: not running (no container %s; run swarmbox up with the tunnel token set)\n' "$CONNECTOR_NAME" ;;
                *) printf '  connector: unknown (podman could not be asked)\n' ;;
            esac
        fi
    else
        printf '  connector: unknown (podman was not found)\n'
    fi
    h_s=
    [ ! -r "$CFG_ROOT/cloudflare.json" ] || h_s=$(url_json_key session)
    printf '  login session: %s\n' "${h_s:-not recorded (the default is applied at the next setup)}"
}

# After a successful `remote setup` on a terminal (and never with --dry-run): when no tunnel token is stored yet, say how to
# keep it on the host and OFFER to do it. Never automatic: the default answer is no. The token is fetched by
# the script's `token` command into a shell variable (stdout captured, the info line on stderr stays visible) and written
# by cfg_write_keys at mode 600; it is never on an argv, never echoed. Any failure here only prints a line: setup succeeded.
remote_token_epilogue() {
    e_script=$1
    e_port=$2
    shift 2
    {
        printf '\nTo let swarmbox bring the connector up on every entry without the Cloudflare API token, keep the tunnel token on this host:\n'
        printf '  swarmbox remote token                          (prints only the tunnel token)\n'
        printf '  swarmbox config set CLOUDFLARE_TUNNEL_TOKEN    (type or paste it; it is stored with mode 600)\n'
        printf 'Fetch it now and store it in %s? [y/N] ' "$CFG_FILE"
    } >&2
    e_ans=
    IFS= read -r e_ans || e_ans=
    case $e_ans in
        y|Y|yes|YES|Yes) ;;
        *) return 0 ;;
    esac
    e_tok=$(python3 "$e_script" token --name "$BOX" --port "$e_port" "$@") || e_tok=
    case $e_tok in
        '') warn "could not read the tunnel token; nothing was stored. Run the two commands above when you are ready."; return 0 ;;
    esac
    if validate_value CLOUDFLARE_TUNNEL_TOKEN "$e_tok"; then
        e_stored=$V_OUT
        e_tok=
        ( cfg_write_keys CLOUDFLARE_TUNNEL_TOKEN "$e_stored" ) || { e_stored=; return 0; }
        e_stored=
        warn "the tunnel token is stored in $CFG_FILE (mode 600); \`swarmbox config list\` shows it only as set."
    else
        e_tok=
        warn "the tunnel token has an unexpected form; nothing was stored."
    fi
    return 0
}

cmd_config() {
    [ $# -ge 1 ] || usage
    _sub=$1
    shift
    case $_sub in
        get) cmd_config_get "$@" ;;
        set) cmd_config_set "$@" ;;
        list) cmd_config_list "$@" ;;
        seed) cmd_config_seed "$@" ;;
        *) usage ;;
    esac
}

# ---------------------------------------------------------------- setup, run by the installers

# ensure_short_name DIR: writes DIR/sx, a small script that runs the swarmbox next to it, so `sx` works as a short name. It is written
# only when nothing else answers to `sx`: no other file of that name in DIR and no `sx` anywhere on the PATH (a startx replacement
# is called that). SWARMBOX_NO_SX=1 skips it. A script, not a link: this script names itself by $0 and `update` renames a new copy over
# that name, which would turn a link into a file and leave `swarmbox` behind. The marker line lets a later setup see that the file is ours.
ensure_short_name() {
    [ -z "${SWARMBOX_NO_SX:-}" ] || return 0
    sn_f=$1/sx
    if [ -e "$sn_f" ] || [ -L "$sn_f" ]; then
        grep -q 'swarmbox-short-name' "$sn_f" 2> /dev/null && return 0
        printf 'not creating the short name sx: %s already exists.\n' "$sn_f"
        return 0
    fi
    sn_o=$(command -v sx 2> /dev/null) || sn_o=
    if [ -n "$sn_o" ]; then
        printf 'not creating the short name sx: another sx is on your PATH (%s).\n' "$sn_o"
        return 0
    fi
    sn_t=$(mktemp "$1/.sx.XXXXXX" 2> /dev/null) || return 0
    # shellcheck disable=SC2016  # the $ in these lines belong to the file being written
    if ! {
        printf '#!/bin/sh\n'
        printf '# swarmbox-short-name: runs the swarmbox next to this file. Written by `swarmbox setup`; delete it if you do not want it.\n'
        printf 'case $0 in */*) d=${0%%/*} ;; *) d=. ;; esac\n'
        printf 'exec "$d/swarmbox" "$@"\n'
    } > "$sn_t" 2> /dev/null; then
        rm -f "$sn_t"
        return 0
    fi
    if ! chmod 755 "$sn_t" 2> /dev/null || ! mv -f "$sn_t" "$sn_f" 2> /dev/null; then
        rm -f "$sn_t"
        return 0
    fi
    printf 'sx is a short name for swarmbox (%s). SWARMBOX_NO_SX=1 skips it.\n' "$sn_f"
}


# setup --image REF [--with LIST]: what both installers run, once they have written this script. Checks Podman (present, 4.3 or
# newer), puts the support files of the image in place, records IMAGE (and WITH) in the config file the way `config seed` does
# (an existing value is never overwritten), then prints what is left to do: the PATH if the folder of this script is not in it,
# a warning for an old shell-function block in a startup file (it would win over this script), and the next command.
# It never writes a startup file. Running it again changes nothing that is already right.
# shellcheck disable=SC2016  # the backticks in the messages are literal
cmd_setup() {
    s_image=
    s_with=
    while [ $# -gt 0 ]; do
        case $1 in
            --image|--image=*) opt_arg --image "$@"; s_image=$OPT_V ;;
            --with|--with=*) opt_arg --with "$@"; s_with=$OPT_V ;;
            *) usage ;;
        esac
        shift "$OPT_N"
    done
    [ -n "$s_image" ] || usage
    valid_image_ref "$s_image" || die 2 "setup: '$s_image' is not an image reference."
    need_podman
    check_podman_version
    up_traps
    trap 'up_update_cleanup' EXIT
    if ! podman image exists "$s_image" > /dev/null 2>&1; then
        warn "pulling $s_image (this can take a while)..."
        if ! pull_image "$s_image"; then
            die 3 "cannot pull $s_image: ${PULL_MSG:-podman failed}. Nothing was changed. Check the network, or the image name."
        fi
    fi
    warn "reading the support files from $s_image..."
    fetch_helper "$s_image"
    swap_support
    support_dir
    init_paths
    set --
    [ -z "$s_with" ] || set -- --with "$s_with"
    cmd_config_seed --image "$s_image" "$@"
    s_bin=$(self_dir) || s_bin=.
    printf 'swarmbox %s is in %s\n' "$SCRIPT_VERSION" "$s_bin"
    ensure_short_name "$s_bin"
    case ":$PATH:" in
        *":$s_bin:"*) ;;
        *)
            printf '%s is not in your PATH. Add it for this and later terminals, for example:\n' "$s_bin"
            printf '  bash or zsh: put this line in your startup file:  export PATH="%s:$PATH"\n' "$s_bin"
            printf '  fish:        fish_add_path %s\n' "$s_bin"
            ;;
    esac
    s_old=
    for s_rc in "$HOME/.bashrc" "$HOME/.zshrc" "$HOME/.config/fish/config.fish"; do
        if [ -f "$s_rc" ] && grep -q '>>> swarmbox' "$s_rc" 2> /dev/null; then s_old="$s_old $s_rc"; fi
    done
    if [ -n "$s_old" ]; then
        warn "an old swarmbox shell function is still in:$s_old"
        warn "delete that block (it starts with a line holding '>>> swarmbox'); a shell function wins over this script. SwarmBox did not change those files."
    fi
    printf 'Next: open a new terminal and run `swarmbox` (the first start creates the box; `swarmbox --help` lists the commands).\n'
}

# ---------------------------------------------------------------- the box: run a command in it

# attach_main WORDS...: for every first word that is not handled above. Start the box if needed (a separate shell: `up` holds the
# lock until it ends, and the session below must not), then `podman exec` into it. -t only when standard input and output are
# both terminals; TERM and COLORTERM are passed. pubkey and tool go to swarmbox-entrypoint as they are; a leading `attach` is a
# prefix, not an argument; the exit status is the command's.
attach_main() {
    ( cmd_up ) || exit $?
    a_name=$(cmd_config_get NAME) || exit $?
    a_t=-i
    if [ -t 0 ] && [ -t 1 ]; then a_t=-it; fi
    case ${1-} in
        pubkey|tool) exec podman exec "$a_t" -e TERM -e COLORTERM "$a_name" swarmbox-entrypoint "$@" ;;
        attach) shift ;;
    esac
    # The pty of this terminal tab names the tab: it is the same for as long as the tab lives, in any terminal or over ssh, so after `exit`
    # and `swarmbox` again in the same tab the box can put the window back in the same place in the browser (swarmbox-attach, SWARMBOX_TAB).
    a_key=
    if [ "$a_t" = -it ]; then a_key=$(tty 2> /dev/null) || a_key=; fi
    if [ -n "$a_key" ]; then
        exec podman exec "$a_t" -e TERM -e COLORTERM -e "SWARMBOX_TAB=$a_key" "$a_name" swarmbox-entrypoint attach "$@"
    fi
    exec podman exec "$a_t" -e TERM -e COLORTERM "$a_name" swarmbox-entrypoint attach "$@"
}

# The words handled here. create-flags and connection are internal (the script calls itself with the first); any other first word
# runs in the box. A command of the box with one of these names runs as `swarmbox attach NAME`.
case ${1-} in
    version) shift; cmd_version "$@" ;;
    config) shift; cmd_config "$@" ;;
    env) shift; cmd_env "$@" ;;
    create-flags) shift; cmd_create_flags "$@" ;;
    fingerprint) shift; cmd_fingerprint "$@" ;;
    up) shift; cmd_up "$@" ;;
    reset) shift; cmd_reset "$@" ;;
    stop) shift; cmd_stop "$@" ;;
    url) shift; cmd_url "$@" ;;
    connection) shift; cmd_connection "$@" ;;
    update) shift; cmd_update "$@" ;;
    remote) shift; cmd_remote "$@" ;;
    setup) shift; cmd_setup "$@" ;;
    -h|--help|help) help_text ;;
    *) attach_main "$@" ;;
esac
